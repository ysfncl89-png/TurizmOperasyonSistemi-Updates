                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="105"/><ColumnDefinition Width="85"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><TextBlock Text="DBL" Foreground="#E2E8F0"/><TextBlock x:Name="ResultEconCostDbl" Grid.Column="1" Foreground="#7EE787"/><ComboBox x:Name="ResultEconQtyDbl" Grid.Column="2" SelectionChanged="ResultQuantity_SelectionChanged"/><TextBlock x:Name="ResultEconSalesDbl" Grid.Column="3" Foreground="#E2E8F0"/></Grid>
                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="105"/><ColumnDefinition Width="85"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><TextBlock Text="TRPL" Foreground="#E2E8F0"/><TextBlock x:Name="ResultEconCostTrpl" Grid.Column="1" Foreground="#7EE787"/><ComboBox x:Name="ResultEconQtyTrpl" Grid.Column="2" SelectionChanged="ResultQuantity_SelectionChanged"/><TextBlock x:Name="ResultEconSalesTrpl" Grid.Column="3" Foreground="#E2E8F0"/></Grid>
                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="105"/><ColumnDefinition Width="85"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><TextBlock Text="QUAD" Foreground="#E2E8F0"/><TextBlock x:Name="ResultEconCostQuad" Grid.Column="1" Foreground="#7EE787"/><ComboBox x:Name="ResultEconQtyQuad" Grid.Column="2" SelectionChanged="ResultQuantity_SelectionChanged"/><TextBlock x:Name="ResultEconSalesQuad" Grid.Column="3" Foreground="#E2E8F0"/></Grid>
                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="105"/><ColumnDefinition Width="85"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><TextBlock Text="QUINT" Foreground="#E2E8F0"/><TextBlock x:Name="ResultEconCostQuint" Grid.Column="1" Foreground="#7EE787"/><ComboBox x:Name="ResultEconQtyQuint" Grid.Column="2" SelectionChanged="ResultQuantity_SelectionChanged"/><TextBlock x:Name="ResultEconSalesQuint" Grid.Column="3" Foreground="#E2E8F0"/></Grid>
                                <Separator Margin="0,10" Background="#FFFBBF24"/>
                                <TextBlock x:Name="ResultEconTotalCost" Foreground="#7EE787" FontWeight="Bold" FontSize="16" Margin="0,10,0,0" />
                                <TextBlock x:Name="ResultEconTotalSales" Foreground="#E2E8F0" FontWeight="Bold" Margin="0,4,0,0" />
                                <TextBlock x:Name="ResultEconTotalProfit" Foreground="#FFFBBF24" FontWeight="Bold" FontSize="16" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Alt navigasyon: Prev / Next -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="PrevBtn" Click="PrevBtn_Click" Style="{StaticResource WizardNavButtonStyle}" Content="Geri" />
            <Button x:Name="NextBtn" Click="NextBtn_Click" Style="{StaticResource WizardNavButtonStyle}" Content="İleri" />
            <!-- Calculator button moved to top; bottom instance removed -->
        </StackPanel>
    </Grid>
</UserControl>
