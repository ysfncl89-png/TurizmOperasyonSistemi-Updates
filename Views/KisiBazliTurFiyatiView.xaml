<UserControl x:Class="TurizmOperasyonSistemi.Views.KisiBazliTurFiyatiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#0B1220">

    <UserControl.Resources>
        <!-- Shared resources for the whole view -->
        <Style x:Key="WizardNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0E2230" />
            <Setter Property="Foreground" Value="#E6EEF6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="#263745" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8B5CF6" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6B3BD6" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <!-- Section styles to visually separate left (Ekonomik) and right (Yürüme Mesafesi) -->
                <Style x:Key="EkonomikSectionStyle" TargetType="Border">
                    <Setter Property="Background" Value="#071026" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Padding" Value="10" />
                    <Setter Property="BorderBrush" Value="#8B5CF6" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="Margin" Value="4" />
                </Style>

                <Style x:Key="YurumeSectionStyle" TargetType="Border">
                    <Setter Property="Background" Value="#071022" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Padding" Value="10" />
                    <Setter Property="BorderBrush" Value="#17B890" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="Margin" Value="4" />
                </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık ve step butonları -->
        <StackPanel Orientation="Vertical" Grid.Row="0">
            <TextBlock Text="Kişi Bazlı Tur Fiyatı Hesapla" FontSize="22" FontWeight="Bold" Foreground="#8B5CF6"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="Step1Btn" Click="Step1Btn_Click" Margin="0,0,8,0" Padding="10,6" Background="#072235" Foreground="#94A3B8">Otel Fiyatı Gir</Button>
                <Button x:Name="Step2Btn" Click="Step2Btn_Click" Margin="0,0,8,0" Padding="10,6" Background="#072235" Foreground="#94A3B8">Giderler ve Tur Maliyeti</Button>
            </StackPanel>
        </StackPanel>

        <!-- İçerik panelleri (her adım için bir panel) -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#071023" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Padding" Value="12" />
                    <Setter Property="BorderBrush" Value="#21303F" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>

                <!-- Wizard navigation button style (Prev / Next) -->
                <Style x:Key="WizardNavButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="#0E2230" />
                    <Setter Property="Foreground" Value="#E6EEF6" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Margin" Value="8" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="MinWidth" Value="110" />
                    <Setter Property="MinHeight" Value="36" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="#263745" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#8B5CF6" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#6B3BD6" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="1" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <!-- Step 1: Otel Fiyatı Gir (geliştirilmiş görünüm) -->
            <Border x:Name="Step1Panel" Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sol: Ekonomik tur -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource EkonomikSectionStyle}">
                        <StackPanel Margin="0">
                        <!-- Mekke header with days combobox -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mekke Otel günlük Fiyatı (EKONOMİK)" Foreground="#8B5CF6" FontWeight="Bold" VerticalAlignment="Center" />
                            <ComboBox x:Name="MekkeDaysCombo" Grid.Column="1" HorizontalAlignment="Right" Width="180" Margin="6,0,0,0" VerticalAlignment="Center" SelectionChanged="MekkeDaysCombo_SelectionChanged" BorderBrush="#8B5CF6" BorderThickness="1.2" />
                        </Grid>

                        <!-- Rates grid (larger, aligned) -->
                        <Grid Margin="0,10,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="SINGLE" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="1" Text="DBL" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="2" Text="TRPL" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="3" Text="QUAD" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="4" Text="QUINT" Foreground="#94A3B8" FontSize="12" Margin="6"/>

                            <TextBox x:Name="MekkeSingleTxt" Grid.Column="0" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MekkeDblTxt" Grid.Column="1" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MekkeTrplTxt" Grid.Column="2" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MekkeQuadTxt" Grid.Column="3" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MekkeQuintTxt" Grid.Column="4" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                        </Grid>

                        <!-- Medine header with days combobox -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Medine Otel günlük Fiyatı (EKONOMİK)" Foreground="#8B5CF6" FontWeight="Bold" VerticalAlignment="Center" />
                            <ComboBox x:Name="MedineDaysCombo" Grid.Column="1" HorizontalAlignment="Right" Width="180" Margin="6,0,0,0" VerticalAlignment="Center" SelectionChanged="MedineDaysCombo_SelectionChanged" BorderBrush="#8B5CF6" BorderThickness="1.2" />
                        </Grid>

                        <Grid Margin="0,10,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="SINGLE" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="1" Text="DBL" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="2" Text="TRPL" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="3" Text="QUAD" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="4" Text="QUINT" Foreground="#94A3B8" FontSize="12" Margin="6"/>

                            <TextBox x:Name="MedineSingleTxt" Grid.Column="0" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MedineDblTxt" Grid.Column="1" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MedineTrplTxt" Grid.Column="2" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MedineQuadTxt" Grid.Column="3" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MedineQuintTxt" Grid.Column="4" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                        </Grid>
                        </StackPanel>
                    </Border>

                    <!-- orta boşluk çizgisi -->
                    <Border Grid.Row="0" Grid.Column="1" Width="1" Background="#21303F" Margin="6,6" />

                    <!-- Sağ: Yürüme mesafesi (daha düzenli mirror) -->
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource YurumeSectionStyle}">
                        <StackPanel Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mekke Otel günlük Fiyatı (YÜRÜME MESAFESİ)" Foreground="#17B890" FontWeight="Bold" VerticalAlignment="Center" />
                            <ComboBox x:Name="MekkeDaysCombo_Walk" Grid.Column="1" HorizontalAlignment="Right" Width="180" Margin="6,0,0,0" VerticalAlignment="Center" SelectionChanged="MekkeDaysCombo_Walk_SelectionChanged" BorderBrush="#17B890" BorderThickness="1.2" />
                        </Grid>

                        <Grid Margin="0,10,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="SINGLE" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="1" Text="DBL" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="2" Text="TRPL" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="3" Text="QUAD" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="4" Text="QUINT" Foreground="#94A3B8" FontSize="12" Margin="6"/>

                            <TextBox x:Name="MekkeSingleTxt_Walk" Grid.Column="0" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MekkeDblTxt_Walk" Grid.Column="1" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MekkeTrplTxt_Walk" Grid.Column="2" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MekkeQuadTxt_Walk" Grid.Column="3" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MekkeQuintTxt_Walk" Grid.Column="4" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Medine Otel günlük Fiyatı (YÜRÜME MESAFESİ)" Foreground="#17B890" FontWeight="Bold" VerticalAlignment="Center" />
                            <ComboBox x:Name="MedineDaysCombo_Walk" Grid.Column="1" HorizontalAlignment="Right" Width="180" Margin="6,0,0,0" VerticalAlignment="Center" SelectionChanged="MedineDaysCombo_Walk_SelectionChanged" BorderBrush="#17B890" BorderThickness="1.2" />
                        </Grid>

                        <Grid Margin="0,10,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="SINGLE" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="1" Text="DBL" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="2" Text="TRPL" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="3" Text="QUAD" Foreground="#94A3B8" FontSize="12" Margin="6"/>
                            <TextBlock Grid.Column="4" Text="QUINT" Foreground="#94A3B8" FontSize="12" Margin="6"/>

                            <TextBox x:Name="MedineSingleTxt_Walk" Grid.Column="0" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MedineDblTxt_Walk" Grid.Column="1" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MedineTrplTxt_Walk" Grid.Column="2" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MedineQuadTxt_Walk" Grid.Column="3" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                            <TextBox x:Name="MedineQuintTxt_Walk" Grid.Column="4" Height="40" Margin="6,32,6,6" FontSize="14" Padding="8" TextChanged="PriceInput_TextChanged" />
                        </Grid>

                        <!-- Removed inline results panel; will be placed below Step1Panel so it spans full width -->
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <!-- (previous inline results removed) -->

            <!-- Hesaplama sonuçları paneli: Step1Panel dışına alındı, tam genişlikte gösterilecek -->
            <Border x:Name="ResultsPanel" Background="#071023" CornerRadius="8" Padding="18" Margin="0,329,0,-70" BorderBrush="#21303F" BorderThickness="1" Visibility="Visible" MinHeight="180">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Hesaplanan Tutarlar (Ekonomik)" Foreground="#E2E8F0" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Width="220" Text="Mekke (SAR):" Foreground="#94A3B8"/>
                            <TextBlock x:Name="EconMekkeSar" Foreground="#E2E8F0"/>
                            <TextBlock Width="24"/>
                            <TextBlock Width="220" Text="Mekke (USD):" Foreground="#94A3B8"/>
                            <TextBlock x:Name="EconMekkeUsd" Foreground="#E2E8F0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Width="220" Text="Medine (SAR):" Foreground="#94A3B8"/>
                            <TextBlock x:Name="EconMedineSar" Foreground="#E2E8F0"/>
                            <TextBlock Width="24"/>
                            <TextBlock Width="220" Text="Medine (USD):" Foreground="#94A3B8"/>
                            <TextBlock x:Name="EconMedineUsd" Foreground="#E2E8F0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Hesaplanan Tutarlar (Yürüme Mesafesi)" Foreground="#E2E8F0" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Width="220" Text="Mekke (SAR):" Foreground="#94A3B8"/>
                            <TextBlock x:Name="WalkMekkeSar" Foreground="#E2E8F0"/>
                            <TextBlock Width="24"/>
                            <TextBlock Width="220" Text="Mekke (USD):" Foreground="#94A3B8"/>
                            <TextBlock x:Name="WalkMekkeUsd" Foreground="#E2E8F0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Width="220" Text="Medine (SAR):" Foreground="#94A3B8"/>
                            <TextBlock x:Name="WalkMedineSar" Foreground="#E2E8F0"/>
                            <TextBlock Width="24"/>
                            <TextBlock Width="220" Text="Medine (USD):" Foreground="#94A3B8"/>
                            <TextBlock x:Name="WalkMedineUsd" Foreground="#E2E8F0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                        <TextBlock Width="160" Text="Toplam (SAR):" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OverallSar" Foreground="#8B5CF6" Width="180" FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#8B5CF6" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Width="36"/>
                        <TextBlock Width="160" Text="Toplam (USD):" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OverallUsd" Foreground="#7EE787" Width="180" FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#7EE787" BlurRadius="18" ShadowDepth="0" Opacity="0.95"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Step 2: Giderler ve Tur Maliyeti -->
            <Border x:Name="Step2Panel" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Gider girişleri (USD) -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Giderler ve Tur Maliyeti" FontWeight="Bold" Foreground="#E2E8F0"/>
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Width="160" Text="Bilet:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox Width="200" x:Name="TicketTxt" TextChanged="Gider_TextChanged" />
                                <TextBlock Width="12" />
                                <TextBlock Text="$" Foreground="#7EE787" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Width="160" Text="Vize:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox Width="200" x:Name="VisaTxt" TextChanged="Gider_TextChanged" />
                                <TextBlock Width="12" />
                                <TextBlock Text="$" Foreground="#7EE787" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Width="160" Text="Çanta ve Zemzem:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox Width="200" x:Name="BagTxt" TextChanged="Gider_TextChanged" />
                                <TextBlock Width="12" />
                                <TextBlock Text="$" Foreground="#7EE787" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Width="160" Text="Eleman gideri:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox Width="200" x:Name="StaffExpenseTxt" TextChanged="Gider_TextChanged" />
                                <TextBlock Width="12" />
                                <TextBlock Text="$" Foreground="#7EE787" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Width="160" Text="Ekstra Ziyaretler:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox Width="200" x:Name="ExtraVisitsTxt" TextChanged="ExtraVisitsTxt_TextChanged"/>
                                <TextBlock Width="16" />
                                <TextBlock Text="SAR" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBlock x:Name="ExtraVisitsUsd" Foreground="#7EE787" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                <TextBlock Width="160" Text="Ekstra Transferler:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox Width="200" x:Name="ExtraTransfersTxt" TextChanged="ExtraTransfersTxt_TextChanged" />
                                <TextBlock Width="16" />
                                <TextBlock Text="SAR" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBlock x:Name="ExtraTransfersUsd" Foreground="#7EE787" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0" />
                            </StackPanel>
                        <!-- Custom rate option -->
                        <StackPanel Orientation="Vertical" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="UseCustomRateChk" Content="Kendi kuru gir (TCMB yerine)" Checked="UseCustomRateChk_Checked" Unchecked="UseCustomRateChk_Unchecked" Foreground="#E2E8F0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Width="160" Text="Kur (1 SAR = ?) USD:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox x:Name="CustomSarToUsdTxt" Width="200" Visibility="Collapsed" TextChanged="CustomSarToUsdTxt_TextChanged" />
                            </StackPanel>
                            <TextBlock x:Name="CustomRateNote" Text="Suudi Arabistan Riyali/Dolar kuru girildiğinde hesaplamalarda girdiğiniz kur kullanılacaktır." Foreground="#94A3B8" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Hesaplanan sonuçlar (coming from Step1) and Tur maliyeti -->
                    <Border Grid.Column="2" Background="#071023" CornerRadius="6" Padding="12" BorderBrush="#21303F" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Hesaplanan Sonuçlar" FontWeight="Bold" Foreground="#E2E8F0"/>
                            <StackPanel Margin="0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="160" Text="Oteller Toplam (USD):" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="Step1OverallUsd" Foreground="#7EE787" FontWeight="Bold">-</TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <TextBlock Width="160" Text="Giderler (USD):" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="Step2GiderUsd" Foreground="#7EE787" FontWeight="Bold">-</TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12">
                                    <TextBlock Width="160" Text="Tur Maliyeti (USD):" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBlock x:Name="TurCostUsd" Foreground="#8B5CF6" FontSize="18" FontWeight="Bold">-</TextBlock>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12">
                                    <TextBlock Width="160" Text="Tur Satış Fiyatı (USD):" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TurSalesPriceTxt" Width="140" TextChanged="TurSalesPriceTxt_TextChanged" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <TextBlock Width="160" Text="Tahmini Kar (USD):" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TurProfitTxt" Foreground="#7EE787" FontWeight="Bold">-</TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Step 3 removed per user request -->
        </Grid>

        <!-- Alt navigasyon: Prev / Next -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="PrevBtn" Click="PrevBtn_Click" Style="{StaticResource WizardNavButtonStyle}" Content="Geri" />
            <Button x:Name="NextBtn" Click="NextBtn_Click" Style="{StaticResource WizardNavButtonStyle}" Content="İleri" />
        </StackPanel>
    </Grid>
</UserControl>