<Window x:Class="TurizmOperasyonSistemi.Views.RoleChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rol Değiştir" Height="210" Width="400"
        Background="#0F172A" Foreground="White"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Yeni Rol Seçin" 
                       FontSize="16" 
                       FontWeight="SemiBold"
                       Foreground="White" 
                       Margin="0,0,0,15"/>

            <ComboBox x:Name="RoleComboBox" 
                     Height="40" 
                     VerticalContentAlignment="Center"
                     Padding="12,8"
                     Margin="0,0,0,20"
                     Background="#1F2937"
                     Foreground="White"
                     BorderBrush="#374151"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Tamam" 
                        Width="90" 
                        Height="36"
                        Background="#06B6D4" 
                        Foreground="White" 
                        Click="OKButton_Click"
                        FontSize="13"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Style="{StaticResource RoundButtonStyle}"/>
                <Button Content="İptal" 
                        Width="90" 
                        Height="36"
                        Background="#6B7280" 
                        Foreground="White" 
                        Click="CancelButton_Click"
                        FontSize="13"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Style="{StaticResource RoundButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
