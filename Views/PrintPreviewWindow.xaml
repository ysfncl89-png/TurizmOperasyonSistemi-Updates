<Window x:Class="TurizmOperasyonSistemi.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baskı Önizleme" Height="800" Width="900" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Şablon:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="TemplateCombo" Width="160" Margin="0,0,12,0" />
            <TextBlock Text="Sayfa yönü:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="OrientationCombo" Width="100">
                <ComboBoxItem>Portrait</ComboBoxItem>
                <ComboBoxItem>Landscape</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="Ara:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox x:Name="SearchTextBox" Width="220" Margin="0,0,6,0" VerticalAlignment="Center" TextChanged="SearchTextBox_TextChanged" />
            <Button x:Name="ClearSearchButton" Content="Temizle" Width="70" Click="ClearSearchButton_Click" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#334155" BorderThickness="1" Background="#0B1220" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Baskı Havuzu (Kuyruk)" FontWeight="Bold" Margin="8" Foreground="White" />
                    <ListBox x:Name="QueueListBox" Margin="8" Background="#07121A" BorderThickness="0" SelectionChanged="QueueListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding BorderBrush}" BorderThickness="2" Padding="6" Margin="4" CornerRadius="6" Background="#06121A">
                                    <DockPanel LastChildFill="True">
                                        <Button Content="✖" Width="28" Height="24" DockPanel.Dock="Right" Margin="4,0,0,0" Click="RemoveQueueItem_Click" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ItemSummary}" Foreground="#AAB" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="#334155" BorderThickness="1" Background="#0F172A">
                <DocumentViewer x:Name="DocViewer" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ExportPdfButton" Content="PDF Olarak Kaydet" Width="140" Margin="0,0,8,0" Click="ExportPdfButton_Click" />
            <Button x:Name="PrintButton" Content="Yazdır" Width="100" Margin="0,0,8,0" Click="PrintButton_Click" />
            <Button Content="Kapat" Width="80" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
