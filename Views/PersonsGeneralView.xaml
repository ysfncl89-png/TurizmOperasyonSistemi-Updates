<Page x:Class="TurizmOperasyonSistemi.Views.PersonsGeneralView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PersonsGeneralView"
      Background="#111827">

    <Page.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#162033"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="#162033"/>
            <Setter Property="AlternatingRowBackground" Value="#1D2A40"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#22324A"/>
            <Setter Property="Foreground" Value="#E2F8FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="NeonCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#E2F8FF"/>
            <Setter Property="BorderBrush" Value="#EC4899"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#EC4899" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="BackButton" Content="← Geri" Width="100" Height="40" Margin="0,0,12,0" Click="BackButton_Click"
                    Background="#EC4899" Foreground="White" FontWeight="SemiBold" FontSize="14" BorderThickness="0" Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
                </Button.Effect>
            </Button>

            <Grid Width="420" Height="40">
                <TextBox x:Name="SearchTextBox" Height="40" FontSize="14" Padding="12,6" VerticalContentAlignment="Center"
                         Background="#0F172A" Foreground="#E2F9FF" BorderBrush="#22D3EE" BorderThickness="2"
                         TextChanged="SearchTextBox_TextChanged"/>
                <TextBlock IsHitTestVisible="False" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#9CAFC0" FontSize="13"
                           Text="Arama... (kolon adı ile arama yapılabilir)" x:Name="SearchHint"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                <Button x:Name="ExportButton" Content="Çıktı Al / İndir" Margin="12,0,0,0" Padding="18,9"
                        FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" Cursor="Hand"
                        Background="#172033" BorderBrush="#EC4899" BorderThickness="1.5" Click="ExportButton_Click">
                    <Button.Effect>
                        <DropShadowEffect Color="#EC4899" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                    </Button.Effect>
                </Button>

                <Button x:Name="DesignButton" Content="Listeyi tasarla" Margin="12,0,0,0" Padding="14,9" Click="DesignButton_Click"
                        Background="#123046" BorderBrush="#60A5FA" BorderThickness="1.2" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="320" Background="#0B1220" Padding="12" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Filtreler" Foreground="#7EE3FD" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CbTourType" Style="{StaticResource NeonCombo}" SelectionChanged="Filter_Changed"/>
                    <ComboBox x:Name="CbPeriod" Style="{StaticResource NeonCombo}" SelectionChanged="Filter_Changed"/>
                    <ComboBox x:Name="CbGroupType" Style="{StaticResource NeonCombo}" SelectionChanged="Filter_Changed"/>
                    <ComboBox x:Name="CbGroupDays" Style="{StaticResource NeonCombo}" SelectionChanged="Filter_Changed"/>
                </StackPanel>
            </Border>

            <Border Background="#152234" CornerRadius="12" Padding="12" Margin="12,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="Seçim yapıp listeyi görüntüleyin" Foreground="#9FB2CB"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="#152234" CornerRadius="12" Padding="12">
            <DataGrid x:Name="ResultsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sıra" Binding="{Binding Sequence}" Width="60"/>
                    <DataGridTextColumn Header="Ad" Binding="{Binding FirstName}" Width="160"/>
                    <DataGridTextColumn Header="Soyad" Binding="{Binding LastName}" Width="160"/>
                    <DataGridTextColumn Header="TC Kimlik" Binding="{Binding TcKimlikNo}" Width="150"/>
                    <DataGridTextColumn Header="Cinsiyet" Binding="{Binding Gender}" Width="100"/>
                    <DataGridTextColumn Header="Doğum Tarihi" Binding="{Binding BirthDate}" Width="120"/>
                    <DataGridTextColumn Header="Telefon numarası" Binding="{Binding PhoneNumber}" Width="140"/>
                    <DataGridTextColumn Header="Adres" Binding="{Binding Address}" Width="240"/>
                    <DataGridTextColumn Header="Pasaport tipi" Binding="{Binding PassportType}" Width="120"/>
                    <DataGridTextColumn Header="Pasaport numarası" Binding="{Binding PassportNumber}" Width="140"/>
                    <DataGridTextColumn Header="Pasaport Başlangıç tarihi" Binding="{Binding PassportStartDate}" Width="140"/>
                    <DataGridTextColumn Header="Pasaport bitiş tarihi" Binding="{Binding PassportEndDate}" Width="140"/>
                    <DataGridTextColumn Header="Kan Grubu" Binding="{Binding BloodType}" Width="110"/>
                    <DataGridTextColumn Header="Aşı durumu" Binding="{Binding VaccineStatus}" Width="120"/>
                    <DataGridTextColumn Header="hastalık durumu" Binding="{Binding HealthStatus}" Width="160"/>
                    <DataGridTextColumn Header="Yaş aralığı" Binding="{Binding AgeRange}" Width="110"/>
                    <DataGridTextColumn Header="Vize Talebi" Binding="{Binding VisaRequest}" Width="110"/>
                    <DataGridTextColumn Header="Bilet Talebi" Binding="{Binding TicketRequest}" Width="110"/>
                    <DataGridTextColumn Header="Kargo Talebi" Binding="{Binding CargoRequest}" Width="110"/>
                    <DataGridTextColumn Header="Oda tipi" Binding="{Binding RoomType}" Width="110"/>
                    <DataGridTextColumn Header="Katılım yapılacak şehir" Binding="{Binding DepartureCity}" Width="160"/>
                    <DataGridTextColumn Header="Aktarma var mı ?" Binding="{Binding HasTransfer}" Width="120"/>
                    <DataGridTextColumn Header="Aktarma şehri" Binding="{Binding TransferCity}" Width="140"/>
                    <DataGridTextColumn Header="İlçe" Binding="{Binding District}" Width="120"/>
                    <DataGridTextColumn Header="Toplam Fiyat" Binding="{Binding TotalPrice}" Width="110"/>
                    <DataGridTextColumn Header="Para Birimi" Binding="{Binding Currency}" Width="90"/>
                    <DataGridTextColumn Header="Ödenen" Binding="{Binding PaidAmount}" Width="90"/>
                    <DataGridTextColumn Header="Kalan" Binding="{Binding RemainingDebt}" Width="90"/>
                    <DataGridTextColumn Header="Referans" Binding="{Binding Reference}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
