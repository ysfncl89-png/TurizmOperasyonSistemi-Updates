<Page x:Class="TurizmOperasyonSistemi.Views.PersonsGeneralView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:TurizmOperasyonSistemi.Views.Converters"
      Title="PersonsGeneralView"
      Background="#111827">

    <Page.Resources>
        <!-- Theme colors scoped to this page only. Updated at runtime by ApplyTheme() in code-behind. -->
        <Color x:Key="PrimaryStartColor">#FF7C3AED</Color>
        <Color x:Key="PrimaryEndColor">#FF5B21B6</Color>
        <Color x:Key="GlowColor">#FF8B5CF6</Color>

        <SolidColorBrush x:Key="PrimaryStartBrush" Color="{DynamicResource PrimaryStartColor}"/>
        <SolidColorBrush x:Key="PrimaryEndBrush" Color="{DynamicResource PrimaryEndColor}"/>
        <SolidColorBrush x:Key="GlowBrush" Color="{DynamicResource GlowColor}"/>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource PrimaryStartColor}" Offset="0" />
            <GradientStop Color="{DynamicResource PrimaryEndColor}" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#162033"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="#162033"/>
            <Setter Property="AlternatingRowBackground" Value="#1D2A40"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <!-- Simple flat button template used to force visual appearance regardless of global disabled style -->
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
        </ControlTemplate>
        <conv:InverseBooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        <conv:StatusToGlowColorConverter x:Key="StatusToGlowColor" />
        <conv:ForegroundContrastConverter x:Key="ForegroundContrast" />
        <!-- TextBlock style to change button label when IsSentToCargo becomes true -->
        <Style x:Key="SendBtnTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="Kargo havuzuna gönder" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSentToCargo}" Value="True">
                    <Setter Property="Text" Value="Kargo Havuzuna Gönderildi" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Neon badge button style used for status cells (capsule, neon border + glow) -->
        <Style x:Key="NeonBadgeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" BlurRadius="20" ShadowDepth="0" Opacity="0.7" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" BlurRadius="40" ShadowDepth="0" Opacity="1.0" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" BlurRadius="50" ShadowDepth="0" Opacity="1.0" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" Value="0.98" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExportPopupButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#123046"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#123046"/>
                    <Setter Property="BorderBrush" Value="#2B76A6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#123046"/>
                    <Setter Property="BorderBrush" Value="#2B76A6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#22324A"/>
            <Setter Property="Foreground" Value="#E2F8FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Neon combo item style used for dropdown rows -->
        <Style x:Key="NeonComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E2F8FF" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <!-- semi-transparent glow background using GlowColor rgb (alpha 0x20) -->
                    <Setter Property="Background" Value="#208B5CF6" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <!-- stronger semi-transparent background (alpha 0x40) -->
                    <Setter Property="Background" Value="#408B5CF6" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Neon combo box style with ControlTemplate so hover/focus glow is visible -->
        <Style x:Key="NeonCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#E2F8FF" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource NeonComboBoxItemStyle}" />
            <Setter Property="Effect">
                
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.18" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True"
                                    Effect="{TemplateBinding Effect}">
                                <ToggleButton x:Name="ToggleButton"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              Foreground="{TemplateBinding Foreground}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="ContentSite"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          VerticalAlignment="Center"
                                                          Margin="4,0,6,0"
                                                          RecognizesAccessKey="True"
                                                          Grid.Column="0" />
                                        <TextBlock Text="▾" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#0B1220" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Effect="{TemplateBinding Effect}">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource GlowBrush}" />
                    <Setter Property="BorderThickness" Value="1.8" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.5" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource GlowBrush}" />
                    <Setter Property="BorderThickness" Value="1.8" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.45" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryGradient}" />
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="TopBar" Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12" Visibility="Collapsed">
            <Button x:Name="BackButton" Content="← Geri" Width="100" Height="40" Margin="0,0,12,0" Click="BackButton_Click"
                    Background="{DynamicResource PrimaryGradient}" Foreground="White" FontWeight="SemiBold" FontSize="14" BorderThickness="0" Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
                </Button.Effect>
            </Button>

                <Grid Width="420" Height="40">
                <TextBox x:Name="SearchTextBox" Height="40" FontSize="14" Padding="12,6" VerticalContentAlignment="Center"
                         Background="#0F172A" Foreground="#E2F9FF" BorderBrush="{DynamicResource GlowBrush}" BorderThickness="2"
                         TextChanged="SearchTextBox_TextChanged"/>
                <TextBlock IsHitTestVisible="False" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#9CAFC0" FontSize="13"
                           x:Name="SearchHint" FontStyle="Italic" Opacity="0.75">
                    <Run Text="Akıllı Arama Yapmak İsterseniz  Kriterlerinizin Arasına "/>
                    <Run Text="VİRGÜL" Foreground="#FCA311" FontWeight="SemiBold"/>
                    <Run Text=" Koyun"/>
                </TextBlock>
            </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                <Button x:Name="ExportButton" Content="Çıktı Al / İndir" Margin="12,0,0,0" Padding="18,9"
                        FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" Cursor="Hand"
                        Background="#172033" BorderBrush="{DynamicResource GlowBrush}" BorderThickness="1.5" Click="ExportButton_Click">
                    <Button.Effect>
                        <DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                    </Button.Effect>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Word (.docx)" Click="ExportWord_Click"><MenuItem.Icon><Image Width="18" Height="18" Source="/Assets/Icons/word.png"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Excel (.xlsx)" Click="ExportExcel_Click"><MenuItem.Icon><Image Width="18" Height="18" Source="/Assets/Icons/excel.png"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="PDF (.pdf)" Click="ExportPdf_Click"><MenuItem.Icon><Image Width="18" Height="18" Source="/Assets/Icons/pdf.png"/></MenuItem.Icon></MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Popup that shows big icon buttons for export options (same as PersonsHealthView) -->
                <Popup x:Name="ExportPopup"
                       PlacementTarget="{Binding ElementName=ExportButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">

                    <Border Background="#0B1220"
                            CornerRadius="10"
                            Padding="12"
                            BorderBrush="#334155"
                            BorderThickness="1">

                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              BlurRadius="18"
                                              ShadowDepth="0"
                                              Opacity="0.25"/>
                        </Border.Effect>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <!-- WORD -->
                            <Button x:Name="PopupWordButton"
                                    Style="{StaticResource ExportPopupButtonStyle}"
                                    Click="ExportWord_Click"
                                    Width="110"
                                    Height="110"
                                    Margin="6"
                                    Cursor="Hand">

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <Image Source="pack://application:,,,/Assets/Icons/word.png"
                                           Width="40"
                                           Height="40"
                                           HorizontalAlignment="Center"/>

                                    <TextBlock Text="Word"
                                               Foreground="#E2F8FF"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="İndir"
                                               Foreground="#9CAFC0"
                                               FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- EXCEL -->
                            <Button x:Name="PopupExcelButton"
                                    Style="{StaticResource ExportPopupButtonStyle}"
                                    Click="ExportExcel_Click"
                                    Width="110"
                                    Height="110"
                                    Margin="6"
                                    Cursor="Hand">

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <Image Source="pack://application:,,,/Assets/Icons/excel.png"
                                           Width="40"
                                           Height="40"
                                           HorizontalAlignment="Center"/>

                                    <TextBlock Text="Excel"
                                               Foreground="#E2F8FF"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="İndir"
                                               Foreground="#9CAFC0"
                                               FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- PDF -->
                            <Button x:Name="PopupPdfButton"
                                    Style="{StaticResource ExportPopupButtonStyle}"
                                    Click="ExportPdf_Click"
                                    Width="110"
                                    Height="110"
                                    Margin="6"
                                    Cursor="Hand">

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <Image Source="pack://application:,,,/Assets/Icons/pdf.png"
                                           Width="40"
                                           Height="40"
                                           HorizontalAlignment="Center"/>

                                    <TextBlock Text="PDF"
                                               Foreground="#E2F8FF"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"/>

                                    <TextBlock Text="İndir"
                                               Foreground="#9CAFC0"
                                               FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Border>
                </Popup>

                <Button x:Name="DesignButton" Content="Listeyi tasarla" Margin="12,0,0,0" Padding="14,9" Click="DesignButton_Click"
                        Background="#123046" BorderBrush="{DynamicResource GlowBrush}" BorderThickness="1.2" Foreground="White" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="12,8,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentModeLabel" Text="Genel" FontSize="25" FontWeight="SemiBold" Foreground="#FCA311" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="CurrentFilterLabel" Text="" VerticalAlignment="Center" FontSize="25" FontWeight="SemiBold" Foreground="#FCA311" Opacity="0.95">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FCA311" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                    </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Filters panel shown BEFORE data grid; after selection it will hide and top search bar will show -->
        <StackPanel x:Name="FiltersPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Grid HorizontalAlignment="Center" Width="780">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Action row: reserved for the Apply Filters button to avoid overlapping previous controls -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="FiltersBackButton" Grid.Row="0" Content="← Geri" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,8" Padding="8,6" Click="BackButton_Click" Background="{DynamicResource PrimaryGradient}" Foreground="White" BorderBrush="{DynamicResource GlowBrush}" BorderThickness="0" />

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,18" VerticalAlignment="Center">
                    <TextBlock x:Name="FilterTitlePrefix" Text="Görüntülemek istediğiniz " Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="ModeInlineText" Text="Genel" Foreground="{DynamicResource PrimaryStartBrush}" FontWeight="ExtraBold" FontSize="30" Margin="6,0,6,0" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource PrimaryStartColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="FilterTitleSuffix" Text=" Listesi İçin Önce Kriterleri Sırayla Seçin" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Specialized header used only for Cargo Evrak Hazırlama (exact phrasing + colored run) -->
                <TextBlock x:Name="CargoDocsHeader" Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,18" Visibility="Collapsed" FontSize="18" FontWeight="Bold" Foreground="White">
                    <TextBlock.Inlines>
                        <Run Text="Görüntülemek istediğiniz " />
                        <Run Text="Kargo Havuzu" Foreground="#FFF59E0B" FontWeight="ExtraBold" FontSize="20" />
                        <Run Text=" için Kriterleri sırayla seçin" />
                    </TextBlock.Inlines>
                </TextBlock>
                <!-- Backwards-compat placeholder for code-behind references; kept collapsed to avoid duplicate UI -->
                <TextBlock x:Name="FilterTitleTextBlock" Visibility="Collapsed" />

                <!-- Tur Türü -->
                <StackPanel Grid.Row="1" Margin="0,6,0,6">
                    <TextBlock Text="Tur Türü" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10" SnapsToDevicePixels="True">

                        <ComboBox x:Name="CbTourType"
                                  Style="{StaticResource NeonCombo}"
                                  SelectionChanged="Filter_Changed"/>
                    </Border>
                </StackPanel>

                <!-- Dönem -->
                <StackPanel Grid.Row="2" Margin="0,6,0,6">
                    <TextBlock Text="Dönem" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10" SnapsToDevicePixels="True">

                        <ComboBox x:Name="CbPeriod"
                                  Style="{StaticResource NeonCombo}"
                                  SelectionChanged="Filter_Changed"/>
                    </Border>
                </StackPanel>

                <!-- Grup Türü -->
                <StackPanel Grid.Row="3" Margin="0,6,0,6">
                    <TextBlock Text="Grup Türü" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10" SnapsToDevicePixels="True">

                        <ComboBox x:Name="CbGroupType"
                                  Style="{StaticResource NeonCombo}"
                                  SelectionChanged="Filter_Changed"/>
                    </Border>
                </StackPanel>

                <!-- Grup Süresi -->
                <StackPanel Grid.Row="4" Margin="0,6,0,6">
                    <TextBlock Text="Grup Süresi (Gün)" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10" SnapsToDevicePixels="True">

                        <ComboBox x:Name="CbGroupDays"
                                  Style="{StaticResource NeonCombo}"
                                  SelectionChanged="Filter_Changed"/>
                    </Border>
                </StackPanel>

                <!-- Bilet Talebi -->
                <StackPanel x:Name="TicketRequestPanel" Grid.Row="5" Margin="0,6,0,6" Visibility="Collapsed">
                    <TextBlock Text="Bilet Talebi" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10" SnapsToDevicePixels="True">
                        <ComboBox x:Name="CbTicketRequest"
                                  Style="{StaticResource NeonCombo}"
                                  SelectionChanged="Filter_Changed"/>
                    </Border>
                </StackPanel>

                <!-- Aktarma var mı? (sadece Havayolu modu için) -->
                <StackPanel x:Name="HasTransferPanel" Grid.Row="7" Margin="0,6,0,6" Visibility="Collapsed">
                    <TextBlock Text="Aktarma var mı ?" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10" SnapsToDevicePixels="True">
                        <ComboBox x:Name="CbHasTransfer"
                                  Style="{StaticResource NeonCombo}"
                                  SelectionChanged="Filter_Changed"/>
                    </Border>
                </StackPanel>

                <!-- Vize Talebi -->
                <StackPanel x:Name="VisaRequestPanel" Grid.Row="8" Margin="0,6,0,6" Visibility="Collapsed">
                    <TextBlock Text="Vize Talebi" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10" SnapsToDevicePixels="True">

                        <ComboBox x:Name="CbVisaRequest"
                                  Style="{StaticResource NeonCombo}"
                                  SelectionChanged="Filter_Changed"/>
                    </Border>
                </StackPanel>

                <!-- Kargo Talebi -->
                <StackPanel x:Name="CargoRequestPanel" Grid.Row="5" Margin="0,6,0,6" Visibility="Collapsed">
                    <TextBlock Text="Kargo Talebi" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10" SnapsToDevicePixels="True">

                        <ComboBox x:Name="Cb_CargoRequest"
                                  Style="{StaticResource NeonCombo}"
                                  SelectionChanged="Filter_Changed"/>
                    </Border>
                </StackPanel>

                <!-- Action button (moved below comboboxes) -->
                <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock x:Name="FilterWarning" Text="Tur Türü ve Dönem seçilmeden Listeyi Göster devre dışı." Foreground="#FCA311" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Visible"/>
                    <Button x:Name="ApplyFiltersButton"
                            Content="Listeyi Göster"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="220"
                            Height="46"
                            Padding="20,8"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            Cursor="Hand"
                            Click="ApplyFiltersButton_Click"
                            IsEnabled="False" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <!-- Baskı havuzu önizleme ve sayaç, sadece sonuç ekranında kaldı; filtre (combobox) panelinden kaldırıldı -->
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2">

            <Border x:Name="ResultsBorder"
                    Background="#152234"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0"
                    Visibility="Collapsed">

                <DataGrid x:Name="ResultsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="36"
                          CanUserReorderColumns="True"
                          ColumnWidth="Auto"
                          EnableColumnVirtualization="False"
                          CanUserResizeColumns="True"
                          FrozenColumnCount="3">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <!-- keep selection subtle so cell templates (badges) remain visible -->
                                    <Setter Property="Background" Value="#0B2432" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Sıra"
                                            Binding="{Binding Sequence}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="Ad"
                                            Binding="{Binding FirstName}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="Soyad"
                                            Binding="{Binding LastName}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="TC Kimlik"
                                            Binding="{Binding TcKimlikNo}"
                                            Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FBBF24" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Uyruk"
                                            Binding="{Binding Nationality}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="Cinsiyet"
                                            Binding="{Binding Gender}"
                                            Width="Auto"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="Doğum Tarihi"
                                            Binding="{Binding BirthDate}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Telefon numarası"
                                            Binding="{Binding PhoneNumber}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Adres"
                                            Binding="{Binding Address}"
                                            Width="486"/>

                        <DataGridTemplateColumn Header="Pasaport tipi" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PassportType}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_PassportType"
                                              SelectedItem="{Binding PassportType, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Bilet Durumu" Width="SizeToCells" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NeonBadgeButtonStyle}"
                                            Background="{Binding TicketStatusChoice, Converter={StaticResource StatusToBrush}}"
                                            BorderBrush="{Binding TicketStatusChoice, Converter={StaticResource StatusToBrush}}"
                                            Tag="{Binding TicketStatusChoice, Converter={StaticResource StatusToGlowColor}}"
                                            Margin="6,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TicketStatusChoice, FallbackValue=Seçilmedi, TargetNullValue=Seçilmedi}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource ForegroundContrast}}" FontWeight="SemiBold" FontSize="13"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_BiletDurumu"
                                              SelectedItem="{Binding TicketStatusChoice, Mode=TwoWay}" Style="{StaticResource NeonCombo}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Vize Durumu" Width="SizeToCells" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NeonBadgeButtonStyle}"
                                            Background="{Binding VisaStatusChoice, Converter={StaticResource StatusToBrush}}"
                                            BorderBrush="{Binding VisaStatusChoice, Converter={StaticResource StatusToBrush}}"
                                            Tag="{Binding VisaStatusChoice, Converter={StaticResource StatusToGlowColor}}"
                                            Margin="6,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VisaStatusChoice, FallbackValue=Seçilmedi, TargetNullValue=Seçilmedi}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource ForegroundContrast}}" FontWeight="SemiBold" FontSize="13"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_VizeDurumu"
                                              SelectedItem="{Binding VisaStatusChoice, Mode=TwoWay}" Style="{StaticResource NeonCombo}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Pasaport numarası"
                                            Binding="{Binding PassportNumber}"
                                            Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FBBF24" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Pasaportu Geldi mi ?" Width="SizeToCells" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NeonBadgeButtonStyle}"
                                            Background="{Binding PassportArrivedText, Converter={StaticResource StatusToBrush}}"
                                            BorderBrush="{Binding PassportArrivedText, Converter={StaticResource StatusToBrush}}"
                                            Tag="{Binding PassportArrivedText, Converter={StaticResource StatusToGlowColor}}"
                                            Margin="6,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PassportArrivedText, FallbackValue=Hayır, TargetNullValue=Hayır}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource ForegroundContrast}}" FontWeight="SemiBold" FontSize="13"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_PassportArrived"
                                              SelectedItem="{Binding PassportArrivedText, Mode=TwoWay}" Style="{StaticResource NeonCombo}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Pasaport Başlangıç tarihi"
                                            Binding="{Binding PassportStartDate}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="Pasaport bitiş tarihi"
                                            Binding="{Binding PassportEndDate}"
                                            Width="Auto"/>

                        <DataGridTemplateColumn Header="Kan Grubu" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BloodType}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_BloodType"
                                              SelectedItem="{Binding BloodType, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Aşı durumu"
                                            Binding="{Binding VaccineStatus}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="hastalık durumu"
                                            Binding="{Binding HealthStatus}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="Yaş aralığı"
                                            Binding="{Binding AgeRange}"
                                            Width="Auto"/>

                        <DataGridTemplateColumn Header="Vize Talebi" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VisaRequest}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_VisaRequest"
                                              SelectedItem="{Binding VisaRequest, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Bilet Talebi" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TicketRequest}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_TicketRequest"
                                              SelectedItem="{Binding TicketRequest, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Kargo Talebi" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CargoRequest}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_CargoRequest_Edit"
                                              SelectedItem="{Binding CargoRequest, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="İşlem" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <Button Content="Kargo için incele"
                                                Foreground="White"
                                                Padding="6,4"
                                                Margin="6,4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                Click="CargoInspect_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#DC2626" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCargoInspected}" Value="True">
                                                            <Setter Property="Background" Value="#6B7280" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Padding="6,4"
                                                    Margin="0,0,8,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Click="SendToCargoPool_Click">
                                                <Button.Content>
                                                    <TextBlock x:Name="BtnText" Style="{StaticResource SendBtnTextStyle}" />
                                                </Button.Content>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Background" Value="#059669" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCargoInspected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCargoDocsMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                                <Setter Property="Background" Value="#FBBF24" />
                                                                <Setter Property="Foreground" Value="Black" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSentToCargo}" Value="True">
                                                                <Setter Property="Background" Value="#059669" />
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="Content" Value="Kargo Havuzuna Gönderildi" />
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Quantity counter: visible only when page is in Cargo Docs mode, row inspected and not yet sent -->
                                            <Border CornerRadius="6" Background="#0F172A" Padding="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsCargoDocsMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True" />
                                                                    <Condition Binding="{Binding IsCargoInspected}" Value="True" />
                                                                    <Condition Binding="{Binding IsSentToCargo}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Width="26" Height="26" Padding="0" Margin="0" Click="DecreaseCargoQty_Click" Cursor="Hand">
                                                        <TextBlock Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E2F8FF"/>
                                                    </Button>
                                                    <TextBlock Text="{Binding CargoQuantity}" Width="36" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="#E2F8FF" FontWeight="SemiBold"/>
                                                    <Button Width="26" Height="26" Padding="0" Margin="0" Click="IncreaseCargoQty_Click" Cursor="Hand">
                                                        <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E2F8FF"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="DetayColumn" Header="Detay" Width="0.1*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Padding="6,4"
                                                    Margin="0,0,8,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Click="SendToCargoPool_Click">
                                                <Button.Content>
                                                    <TextBlock x:Name="BtnText2" Style="{StaticResource SendBtnTextStyle}" />
                                                </Button.Content>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Background" Value="#059669" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCargoInspected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCargoDocsMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                                <Setter Property="Background" Value="#FBBF24" />
                                                                <Setter Property="Foreground" Value="Black" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSentToCargo}" Value="True">
                                                                <Setter Property="Background" Value="#059669" />
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="Content" Value="Kargo Havuzuna Gönderildi" />
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Border CornerRadius="6" Background="#0F172A" Padding="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsCargoDocsMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True" />
                                                                    <Condition Binding="{Binding IsCargoInspected}" Value="True" />
                                                                    <Condition Binding="{Binding IsSentToCargo}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Width="26" Height="26" Padding="0" Margin="0" Click="DecreaseCargoQty_Click" Cursor="Hand">
                                                        <TextBlock Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E2F8FF"/>
                                                    </Button>
                                                    <TextBlock Text="{Binding CargoQuantity}" Width="36" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="#E2F8FF" FontWeight="SemiBold"/>
                                                    <Button Width="26" Height="26" Padding="0" Margin="0" Click="IncreaseCargoQty_Click" Cursor="Hand">
                                                        <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E2F8FF"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Oda tipi"
                                            Binding="{Binding RoomType}"
                                            Width="110"/>

                        <DataGridTemplateColumn Header="Katılım yapılacak şehir" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DepartureCity}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_DepartureCity"
                                              SelectedItem="{Binding DepartureCity, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Aktarma var mı ?" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding HasTransfer}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_HasTransfer"
                                              SelectedItem="{Binding HasTransfer, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Aktarma şehri" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TransferCity}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_TransferCity"
                                              SelectedItem="{Binding TransferCity, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="İlçe"
                                            Binding="{Binding District}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Toplam Fiyat"
                                            Binding="{Binding TotalPrice}"
                                            Width="110"/>

                        <DataGridTemplateColumn Header="Para Birimi" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Currency}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="Cb_Currency"
                                              SelectedItem="{Binding Currency, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Ödenen"
                                            Binding="{Binding PaidAmount}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Kalan"
                                            Binding="{Binding RemainingDebt}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Referans"
                                            Binding="{Binding Reference}"
                                            Width="160"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            <Border x:Name="SaveToastBorder"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,16,0"
                    Padding="14,8"
                    CornerRadius="10"
                    Background="#1E293B"
                    BorderBrush="#FCA311"
                    BorderThickness="1.2"
                    Visibility="Collapsed"
                    Panel.ZIndex="20">

                <TextBlock x:Name="SaveToastTextBlock"
                           Text="Kaydedildi"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"/>

            </Border>

        </Grid>

    </Grid>
</Page>
