<Window x:Class="TurizmOperasyonSistemi.Views.ListDesignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Listeyi Tasarla"
        Width="760"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B1220"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Listeyi Tasarla"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"/>
            <TextBlock Text="Listede görünmesini istemediğiniz kolonun işaretini kaldırın . Kırmızı olacak ve KAYDET butonuna tıklayınca listede görünmeyecek"
                       Foreground="Orange"
                       Margin="0,4,0,0"/>
            <TextBlock Text="Ayrıca SÜRÜKLE BIRAK  yöntemiyle kolonların sıralamasını hem bu pencerede hem tabloda değiştirebilirsiniz"
                       Foreground="Orange"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#101B2D"
                BorderBrush="#223047"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Kolonlar"
                               Foreground="#7DD3FC"
                               FontWeight="Bold"
                               FontSize="16"
                               Margin="0,0,0,12"/>
                    <ItemsControl x:Name="ColumnsItemsControl" AllowDrop="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder"
                                        BorderBrush="#223047"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <Border.InputBindings>
                                        <!-- enable drag from touch/mouse: handlers attached in code-behind -->
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0B1324"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=VisibilityCheckBox}" Value="True">
                                                    <!-- Green when checkbox is selected -->
                                                    <Setter Property="Background" Value="#064E3B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=VisibilityCheckBox}" Value="False">
                                                    <!-- Red when checkbox is not selected -->
                                                    <Setter Property="Background" Value="#7F1D1D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown" MouseMove="Item_MouseMove" AllowDrop="True" Drop="Item_Drop" DragOver="Item_DragOver">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="VisibilityCheckBox" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   Foreground="White"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Order}"
                                                   Foreground="#9FB2CB"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Vazgeç"
                    Width="110"
                    Margin="0,0,10,0"
                    Padding="14,8"
                    Click="Cancel_Click"/>
            <Button Content="Uygula"
                    Width="110"
                    Padding="14,8"
                    Background="#1D4ED8"
                    Foreground="White"
                    Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
