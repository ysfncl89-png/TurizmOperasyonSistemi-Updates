<Window x:Class="TurizmOperasyonSistemi.Views.EditTitleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Başlığı Düzenle"
        Width="420"
        Height="160"
        WindowStartupLocation="CenterOwner"
        Background="#0B1220"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Kolon Başlığını Düzenle" Foreground="White" FontSize="16" FontWeight="Bold"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="1" Margin="0,8,0,0" Height="30"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Vazgeç" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Kaydet" Width="100" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>