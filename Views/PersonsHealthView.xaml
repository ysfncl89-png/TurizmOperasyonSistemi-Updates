<Page x:Class="TurizmOperasyonSistemi.Views.PersonsHealthView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PersonsHealthView"
      Background="#111827">

    <Page.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#162033"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="#162033"/>
            <Setter Property="AlternatingRowBackground" Value="#1D2A40"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#22324A"/>
            <Setter Property="Foreground" Value="#E2F8FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#162033"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#243244"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#22D3EE"/>
                    <Setter Property="Foreground" Value="#04111D"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Column specific neon text styles -->
        <Style x:Key="BloodColumnTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7EE3FD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#7EE3FD" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HealthColumnTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F472B6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#F472B6" BlurRadius="10" ShadowDepth="0" Opacity="0.38"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VaccineColumnTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A7F3D0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#A7F3D0" BlurRadius="10" ShadowDepth="0" Opacity="0.38"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Health themed button style (used for Back, Apply, Export, etc.) -->
        <Style x:Key="HealthButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EC4899" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#EC4899" BlurRadius="18" ShadowDepth="0" Opacity="0.28" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.95" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Neon combo box item style used for dropdown rows -->
        <Style x:Key="NeonComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EC489920" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EC489940" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Neon combo box style with ControlTemplate so hover/focus glow is visible -->
        <Style x:Key="NeonComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#4C2742" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource NeonComboBoxItemStyle}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#EC4899" BlurRadius="10" ShadowDepth="0" Opacity="0.18" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True"
                                    Effect="{TemplateBinding Effect}">
                                <ToggleButton x:Name="ToggleButton"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              Foreground="{TemplateBinding Foreground}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="ContentSite"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          VerticalAlignment="Center"
                                                          Margin="4,0,6,0"
                                                          RecognizesAccessKey="True"
                                                          Grid.Column="0" />
                                        <TextBlock Text="▾" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Grid.Column="1" />
                                    </Grid>
                                </ToggleButton>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#0B1220" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Effect="{TemplateBinding Effect}">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="PART_Popup" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#EC4899" />
                    <Setter Property="BorderThickness" Value="1.8" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#EC4899" BlurRadius="18" ShadowDepth="0" Opacity="0.5" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#F472B6" />
                    <Setter Property="BorderThickness" Value="1.8" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#F472B6" BlurRadius="18" ShadowDepth="0" Opacity="0.45" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Export popup small button variant with health accent -->
        <Style x:Key="ExportPopupButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1020" />
            <Setter Property="BorderBrush" Value="#EC4899" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#EC4899" BlurRadius="14" ShadowDepth="0" Opacity="0.28" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.98" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.92" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

        <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TopBar" Grid.Row="0" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BackButton" Content="← Geri" Width="100" Height="40" Margin="0,0,12,0" Click="BackButton_Click"
                        Style="{StaticResource HealthButtonStyle}" FontSize="14">
                    <Button.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
                    </Button.Effect>
                </Button>
                <Grid Width="420" Height="40" HorizontalAlignment="Left">
                <TextBox x:Name="SearchTextBox" Height="40" FontSize="14" Padding="12,6" VerticalContentAlignment="Center"
                         Background="#0F172A" Foreground="#E2F9FF" BorderBrush="#22D3EE" BorderThickness="2"
                         TextChanged="SearchTextBox_TextChanged"/>
                <TextBlock IsHitTestVisible="False" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#9CAFC0" FontSize="13"
                           Text="Kan Grubu, Hastalık veya Aşı durumuna göre arayın..." x:Name="SearchHint"/>
            </Grid>

                <!-- Bilgilendirme metni: Sağlık güncelleme (arama kutusunun sağına taşındı) -->
                <StackPanel Orientation="Horizontal" Margin="12,6,0,0" VerticalAlignment="Center">
                    <TextBlock Foreground="White" FontSize="13" VerticalAlignment="Center">Kan Grubu , Hastalık ve Aşı ile ilgili güncelleme yapmak isterseniz ilgili yere   </TextBlock>
                    <TextBlock Foreground="#F59E0B" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"> ÇİFT TIKLAYIN </TextBlock>
                </StackPanel>
            </StackPanel>

            <Button x:Name="ExportButton" Grid.Column="1" Content="Çıktı Al / İndir" Margin="12,0,0,0" Padding="18,9"
                    FontSize="14" Foreground="#F8FAFC" Cursor="Hand"
                    Style="{StaticResource HealthButtonStyle}" HorizontalAlignment="Right"
                    Click="ExportButton_Click">
                <Button.Effect>
                    <DropShadowEffect Color="#EC4899" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                </Button.Effect>
                <Button.ContextMenu>
                    <!-- keep context menu as fallback for keyboard users -->
                    <ContextMenu>
                        <MenuItem Header="Word (.docx)" Click="ExportWord_Click"><MenuItem.Icon><Image Width="18" Height="18" Source="/Assets/Icons/word.png"/></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Excel (.xlsx)" Click="ExportExcel_Click"><MenuItem.Icon><Image Width="18" Height="18" Source="/Assets/Icons/excel.png"/></MenuItem.Icon></MenuItem>
                        <MenuItem Header="PDF (.pdf)" Click="ExportPdf_Click"><MenuItem.Icon><Image Width="18" Height="18" Source="/Assets/Icons/pdf.png"/></MenuItem.Icon></MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- Popup that shows big icon buttons for export options -->
			<!-- Popup that shows big icon buttons for export options -->
			<Popup x:Name="ExportPopup"
				   PlacementTarget="{Binding ElementName=ExportButton}"
				   Placement="Bottom"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="Fade">

				<Border Background="#0B1220"
						CornerRadius="10"
						Padding="12"
						BorderBrush="#334155"
						BorderThickness="1">

					<Border.Effect>
						<DropShadowEffect Color="#000000"
										  BlurRadius="18"
										  ShadowDepth="0"
										  Opacity="0.25"/>
					</Border.Effect>

					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Center">

						<!-- WORD -->
						<Button x:Name="PopupWordButton"
								Style="{StaticResource ExportPopupButtonStyle}"
								Click="ExportWord_Click"
								Width="110"
								Height="110"
								Margin="6"
								Cursor="Hand">

							<StackPanel HorizontalAlignment="Center"
										VerticalAlignment="Center">

								<Image Source="pack://application:,,,/Assets/Icons/word.png"
									   Width="40"
									   Height="40"
									   HorizontalAlignment="Center"/>

								<TextBlock Text="Word"
										   Foreground="#E2F8FF"
										   FontWeight="SemiBold"
										   HorizontalAlignment="Center"
										   Margin="0,8,0,0"/>

								<TextBlock Text="İndir"
										   Foreground="#9CAFC0"
										   FontSize="12"
										   HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>

						<!-- EXCEL -->
						<Button x:Name="PopupExcelButton"
								Style="{StaticResource ExportPopupButtonStyle}"
								Click="ExportExcel_Click"
								Width="110"
								Height="110"
								Margin="6"
								Cursor="Hand">
							

							<StackPanel HorizontalAlignment="Center"
										VerticalAlignment="Center">

								<Image Source="pack://application:,,,/Assets/Icons/excel.png"
									   Width="40"
									   Height="40"
									   HorizontalAlignment="Center"/>

								<TextBlock Text="Excel"
										   Foreground="#E2F8FF"
										   FontWeight="SemiBold"
										   HorizontalAlignment="Center"
										   Margin="0,8,0,0"/>

								<TextBlock Text="İndir"
										   Foreground="#9CAFC0"
										   FontSize="12"
										   HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>

						<!-- PDF -->
						<Button x:Name="PopupPdfButton"
								Style="{StaticResource ExportPopupButtonStyle}"
								Click="ExportPdf_Click"
								Width="110"
								Height="110"
								Margin="6"
								Cursor="Hand">

							<StackPanel HorizontalAlignment="Center"
										VerticalAlignment="Center">

								<Image Source="pack://application:,,,/Assets/Icons/pdf.png"
									   Width="40"
									   Height="40"
									   HorizontalAlignment="Center"/>

								<TextBlock Text="PDF"
										   Foreground="#E2F8FF"
										   FontWeight="SemiBold"
										   HorizontalAlignment="Center"
										   Margin="0,8,0,0"/>

								<TextBlock Text="İndir"
										   Foreground="#9CAFC0"
										   FontSize="12"
										   HorizontalAlignment="Center"/>
							</StackPanel>
						</Button>

					</StackPanel>
				</Border>
			</Popup>
        </Grid>

        <!-- Filters panel shown BEFORE data grid; after selection it will hide and top search bar will show -->
        <StackPanel x:Name="FiltersPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Grid HorizontalAlignment="Center" Width="780">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Back button (left) and instruction (right) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="← Geri" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,12,8" Padding="8,6" Click="BackButton_Click" Style="{StaticResource HealthButtonStyle}" />

                    <TextBlock Grid.Column="1" Foreground="#F472B6" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#EC4899" BlurRadius="14" ShadowDepth="0" Opacity="0.42" />
                        </TextBlock.Effect>
                        <Run Text="SAĞLIK" Foreground="White" FontWeight="SemiBold" />
                        <Run Text=" listesini görüntülemek için öncelikle ilgili kriterleri seçin." />
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,6,0,6">
                    <TextBlock Text="Tur Türü" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10">
                        <ComboBox x:Name="CbTourType" SelectionChanged="Filter_Changed" Style="{StaticResource NeonComboBoxStyle}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,6,0,6">
                    <TextBlock Text="Dönem" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10">
                        <ComboBox x:Name="CbPeriod" SelectionChanged="Filter_Changed" Style="{StaticResource NeonComboBoxStyle}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,6,0,6">
                    <TextBlock Text="Grup Türü" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10">
                        <ComboBox x:Name="CbGroupType" SelectionChanged="Filter_Changed" Style="{StaticResource NeonComboBoxStyle}" />
                    </Border>
                </StackPanel>

                <!-- Grup Süresi (Gün) -->
                <StackPanel Grid.Row="4" Margin="0,6,0,6">
                    <TextBlock Text="Grup Süresi (Gün)" Foreground="#9FB2CB" FontWeight="SemiBold" Margin="6,0,0,6"/>
                    <Border CornerRadius="8" Background="#0F172A" Padding="10">
                        <ComboBox x:Name="CbGroupDays" SelectionChanged="Filter_Changed" Style="{StaticResource NeonComboBoxStyle}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock x:Name="FilterWarning" Text="Tur Türü ve Dönem seçilmeden Listeyi Göster devre dışı." Foreground="#FCA311" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="ApplyFiltersButton" Content="Listeyi Göster" Width="220" Height="46" Padding="20,8" FontSize="14" Click="ApplyFiltersButton_Click" IsEnabled="False" Style="{StaticResource HealthButtonStyle}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Background="#152234" CornerRadius="12" Padding="12" Visibility="Collapsed" x:Name="ResultsBorder">
            <DataGrid x:Name="ResultsDataGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" RowHeight="36" CanUserReorderColumns="True"
                      CellEditEnding="ResultsDataGrid_CellEditEnding" PreviewMouseLeftButtonDown="ResultsDataGrid_PreviewMouseLeftButtonDown" MouseDoubleClick="ResultsDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ad" Binding="{Binding FirstName}" Width="180" IsReadOnly="True" />
                    <DataGridTextColumn Header="Soyad" Binding="{Binding LastName}" Width="180" IsReadOnly="True" />
                    <DataGridTextColumn Header="TC Kimlik" Binding="{Binding TcKimlikNo}" Width="150" IsReadOnly="True" />

                    <!-- Kan Grubu: show as text, edit with ComboBox -->
                    <DataGridTemplateColumn Header="Kan Grubu" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BloodType}" Style="{StaticResource BloodColumnTextStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=BloodOptions}"
                                          SelectedValue="{Binding BloodType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Hastalık Durumu: editable text -->
                    <DataGridTemplateColumn Header="Hastalık Durumu" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HealthStatus}" Style="{StaticResource HealthColumnTextStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HealthStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Aşı Durumu: editable text -->
                    <DataGridTemplateColumn Header="Aşı Durumu" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding VaccineStatus}" Style="{StaticResource VaccineColumnTextStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding VaccineStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
