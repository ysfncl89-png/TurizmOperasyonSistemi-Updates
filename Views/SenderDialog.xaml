<Window x:Class="TurizmOperasyonSistemi.Views.SenderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gönderici Bilgileri" Height="320" Width="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Lütfen gönderici bilgilerini girin" FontWeight="Bold" FontSize="14" />

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="Gönderici Adı"/>
            <TextBox x:Name="TbSenderName" />
            <TextBlock Text="Gönderici Telefon" Margin="0,8,0,0"/>
            <TextBox x:Name="TbSenderPhone" />
            <TextBlock Text="Gönderici Adres" Margin="0,8,0,0"/>
            <TextBox x:Name="TbSenderAddress" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="İptal" Width="100" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Tamam" Width="100" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
