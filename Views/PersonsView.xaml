<Page x:Class="TurizmOperasyonSistemi.Views.PersonsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PersonsView"
      Background="#111827">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">

            <!-- BAŞLIK -->

            <TextBlock Text="Kişiler Modülü"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <!-- ARAMA -->

            <TextBox x:Name="SearchTextBox"
                     Height="40"
                     FontSize="16"
                     Margin="0,0,0,20"
                     Background="#1F2937"
                     Foreground="White"
                     BorderBrush="#374151"
                     TextChanged="SearchTextBox_TextChanged"/>
            <CheckBox x:Name="ShowPassiveCheckBox"
          Content="Pasif Kişileri Göster"
          Foreground="White"
          Margin="0,0,0,15"
          Checked="ShowPassiveCheckBox_Checked"
          Unchecked="ShowPassiveCheckBox_Checked"/>

            <!-- FORM -->

            <Border Background="#1F2937"
                    CornerRadius="15"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Ad"
                               Foreground="White"/>
                    <TextBox x:Name="FirstNameTextBox"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Soyad"
                               Foreground="White"/>
                    <TextBox x:Name="LastNameTextBox"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="TC Kimlik No"
                               Foreground="White"/>
                    <TextBox x:Name="TcTextBox"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Telefon"
                               Foreground="White"/>
                    <TextBox x:Name="PhoneTextBox"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Cinsiyet"
                               Foreground="White"/>
                    <ComboBox x:Name="GenderComboBox"
                              Height="35"
                              Margin="0,5,0,15">

                        <ComboBoxItem Content="Erkek"/>
                        <ComboBoxItem Content="Kadın"/>

                    </ComboBox>

                    <TextBlock Text="Doğum Tarihi"
                               Foreground="White"/>
                    <DatePicker x:Name="BirthDatePicker"
                                Height="35"
                                Margin="0,5,0,15"/>

                    <TextBlock Text="Kan Grubu"
                               Foreground="White"/>
                    <ComboBox x:Name="BloodComboBox"
                              Height="35"
                              Margin="0,5,0,15">

                        <ComboBoxItem Content="A+"/>
                        <ComboBoxItem Content="A-"/>
                        <ComboBoxItem Content="B+"/>
                        <ComboBoxItem Content="B-"/>
                        <ComboBoxItem Content="AB+"/>
                        <ComboBoxItem Content="AB-"/>
                        <ComboBoxItem Content="0+"/>
                        <ComboBoxItem Content="0-"/>

                    </ComboBox>

                    <TextBlock Text="Pasaport Türü"
                               Foreground="White"/>
                    <ComboBox x:Name="PassportTypeComboBox"
                              Height="35"
                              Margin="0,5,0,15">

                        <ComboBoxItem Content="Bordo"/>
                        <ComboBoxItem Content="Yeşil"/>
                        <ComboBoxItem Content="Gri"/>
                        <ComboBoxItem Content="Siyah"/>

                    </ComboBox>

                    <TextBlock Text="Pasaport No"
                               Foreground="White"/>
                    <TextBox x:Name="PassportTextBox"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Pasaport Başlangıç Tarihi"
                               Foreground="White"/>
                    <DatePicker x:Name="PassportStartPicker"
                                Height="35"
                                Margin="0,5,0,15"/>

                    <TextBlock Text="Pasaport Bitiş Tarihi"
                               Foreground="White"/>
                    <DatePicker x:Name="PassportEndPicker"
                                Height="35"
                                Margin="0,5,0,15"/>

                    <TextBlock Text="Adres"
                               Foreground="White"/>
                    <TextBox x:Name="AddressTextBox"
                             Height="60"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Hastalık Durumu"
                               Foreground="White"/>
                    <TextBox x:Name="HealthTextBox"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Aşı Durumu"
                               Foreground="White"/>
                    <TextBox x:Name="VaccineTextBox"
                             Height="35"
                             Margin="0,5,0,20"/>

                    <Button Content="Kaydet"
                            Height="45"
                            Background="#06B6D4"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="SaveButton_Click"/>
                    <Button x:Name="PassiveButton"
        Content="Pasif Yap"
        Height="45"
        Margin="0,10,0,0"
        Background="#EF4444"
        Foreground="White"
        FontWeight="Bold"
        Click="PassiveButton_Click"/>

                </StackPanel>

            </Border>

            <!-- TABLO -->

            <DataGrid x:Name="PersonsDataGrid"
                      Margin="0,20,0,0"
                      AutoGenerateColumns="True"
                      Height="350"
                      Background="#1F2937"
                      Foreground="White"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowBackground="#1F2937"
                      AlternatingRowBackground="#111827"
                      SelectionChanged="PersonsDataGrid_SelectionChanged"/>

        </StackPanel>

    </ScrollViewer>

</Page>