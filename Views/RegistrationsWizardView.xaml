                        Style="{StaticResource RegFooterButtonBase}"
                        Click="BackButton_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="ToggleActiveButton"
                        Content="⚡ Seçilen Kişiyi Aktif Yap ve İlerle"
                        HorizontalAlignment="Center"
                        Style="{StaticResource RegFooterButtonSave}"
                        Visibility="Collapsed"
                        Click="ToggleActiveButton_Click"/>

                <Button x:Name="NextButton"
                        Content="İleri"
                        HorizontalAlignment="Right"
                        Style="{StaticResource RegFooterButtonPrimary}"
                        Click="NextButton_Click"
                        IsEnabled="False"/>

            </Grid>

        </Border>

    </Grid>

</Page>
