<Page x:Class="TurizmOperasyonSistemi.Views.RegistrationsWizardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TurizmOperasyonSistemi.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="RegistrationsWizardView">

    <Grid Background="#111827">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20">
            <Border x:Name="Step1Border" Background="#06B6D4" CornerRadius="15" Padding="15,8" Margin="5">
                <TextBlock x:Name="Step1Text" Text="1. Kişi Seçimi" Foreground="White" FontWeight="Bold"/>
            </Border>

            <Border x:Name="Step2Border" Background="#1F2937" CornerRadius="15" Padding="15,8" Margin="5">
                <TextBlock x:Name="Step2Text" Text="2. Tur" Foreground="#9CA3AF"/>
            </Border>

            <Border Background="#1F2937" CornerRadius="15" Padding="15,8" Margin="5">
                <TextBlock Text="..." Foreground="#9CA3AF"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="20,0,20,20">

            <Grid x:Name="Step1Grid" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🔍 Tur kaydını yapacağınız kişinin veritabanında kayıtlı olup olmadığını arama kutusunda arama yaparak kontrol edin. Varsa kişiyi seçerek ilerleyin. Yoksa Kişiyi kaydederek ilerleyin"
                                   Foreground="#06B6D4" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SearchTextBox"
                                     Background="#111827"
                                     Foreground="White"
                                     BorderBrush="#374151"
                                     Padding="8"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged"
                                     Tag="Ad, Soyad veya TC Kimlik No yazın..."/>

                            <CheckBox x:Name="ShowPassiveCheckBox"
                                      Content="Pasif Kişileri De Göster"
                                      Grid.Column="1"
                                      Foreground="White"
                                      Margin="15,0,0,0"
                                      VerticalAlignment="Center"
                                      FontWeight="Bold"
                                      Checked="ShowPassiveCheckBox_Changed"
                                      Unchecked="ShowPassiveCheckBox_Changed"/>

                            <Button x:Name="SearchButton"
                                    Content="Ara"
                                    Grid.Column="2"
                                    Margin="15,0,0,0"
                                    Background="#06B6D4"
                                    Foreground="White"
                                    Padding="20,0"
                                    FontWeight="Bold"
                                    Click="SearchButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="PersonsDataGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#1F2937"
                              RowBackground="#1F2937"
                              AlternatingRowBackground="#111827"
                              Foreground="White"
                              BorderBrush="#374151"
                              HeadersVisibility="Column"
                              SelectionChanged="PersonsDataGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Adı" Binding="{Binding FirstName}" Width="120"/>
                            <DataGridTextColumn Header="Soyadı" Binding="{Binding LastName}" Width="120"/>
                            <DataGridTextColumn Header="TC Kimlik No" Binding="{Binding TcNo}" Width="110"/>
                            <DataGridTextColumn Header="Cinsiyet" Binding="{Binding Gender}" Width="80"/>
                            <DataGridTextColumn Header="Doğum Tarihi" Binding="{Binding BirthDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                            <DataGridTextColumn Header="Yaş" Binding="{Binding Age}" Width="60"/>
                            <DataGridTextColumn Header="Yaş Aralığı" Binding="{Binding AgeRange}" Width="95"/>

                            <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="110"/>
                            <DataGridTextColumn Header="Adres" Binding="{Binding Address}" Width="180"/>

                            <DataGridTextColumn Header="Kan Grubu" Binding="{Binding BloodType}" Width="85"/>
                            <DataGridTextColumn Header="Hastalık Durumu" Binding="{Binding HealthStatus}" Width="140"/>
                            <DataGridTextColumn Header="Aşı Durumu" Binding="{Binding VaccineStatus}" Width="110"/>

                            <DataGridTextColumn Header="Pasaport Türü" Binding="{Binding PassportType}" Width="110"/>
                            <DataGridTextColumn Header="Pasaport No" Binding="{Binding PassportNo}" Width="100"/>
                            <DataGridTextColumn Header="Pasp. Başlangıç" Binding="{Binding PassportStartDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="110"/>
                            <DataGridTextColumn Header="Pasp. Bitiş" Binding="{Binding PassportEndDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="110"/>

                            <DataGridTextColumn Header="Durum" Binding="{Binding IsActive}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="NoPersonPanel"
                                Grid.Row="1"
                                Margin="0,15,0,0"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">

                        <TextBlock Text="Aradığınız kişi sistemde bulunamadı."
                                   Foreground="#EF4444"
                                   Margin="0,0,0,5"
                                   HorizontalAlignment="Center"/>

                        <Button x:Name="ShowQuickAddButton"
                                Content="➕ Bu Kişiyi Hızlıca Sisteme Kaydet"
                                Background="#10B981"
                                Foreground="White"
                                Padding="15,10"
                                FontWeight="Bold"
                                Click="ShowQuickAddButton_Click"/>
                    </StackPanel>

                    <Border x:Name="QuickAddFormPanel"
                            Grid.Row="1"
                            Background="#1F2937"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,15,0,0"
                            Width="780"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">

                        <StackPanel>
                            <TextBlock Text="👤 Yeni Kişi Detaylı Kayıt Formu"
                                       Foreground="#10B981"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"
                                       HorizontalAlignment="Center"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TC Kimlik No" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <TextBox x:Name="QuickTcTextBox" Background="#111827" Foreground="White" BorderBrush="#374151" Padding="5" Margin="0,0,0,10" MaxLength="11"/>

                                    <TextBlock Text="Adı" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <TextBox x:Name="QuickFirstNameTextBox" Background="#111827" Foreground="White" BorderBrush="#374151" Padding="5" Margin="0,0,0,10"/>

                                    <TextBlock Text="Soyadı" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <TextBox x:Name="QuickLastNameTextBox" Background="#111827" Foreground="White" BorderBrush="#374151" Padding="5" Margin="0,0,0,10"/>

                                    <TextBlock Text="Telefon Numarası" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <TextBox x:Name="QuickPhoneTextBox" Background="#111827" Foreground="White" BorderBrush="#374151" Padding="5" Margin="0,0,0,10"/>

                                    <TextBlock Text="Doğum Tarihi" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="QuickBirthDatePicker"
                                                Background="#111827"
                                                BorderBrush="#374151"
                                                Margin="0,0,0,10"
                                                Padding="3"
                                                SelectedDateChanged="QuickBirthDatePicker_SelectedDateChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Pasaport Numarası" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <TextBox x:Name="QuickPassportNumberTextBox" Background="#111827" Foreground="White" BorderBrush="#374151" Padding="5" Margin="0,0,0,10"/>

                                    <TextBlock Text="Pasaport Türü" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="QuickPassportTypeComboBox"
                                              Background="#111827"
                                              Foreground="White"
                                              BorderBrush="#374151"
                                              Padding="4"
                                              Margin="0,0,0,10"
                                              DisplayMemberPath="Value"
                                              SelectedValuePath="Value"/>

                                    <TextBlock Text="Pasaport Başlangıç Tarihi" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="QuickPassportStartDatePicker" Background="#111827" BorderBrush="#374151" Margin="0,0,0,10" Padding="3"/>

                                    <TextBlock Text="Pasaport Bitiş Tarihi" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <DatePicker x:Name="QuickPassportEndDatePicker" Background="#111827" BorderBrush="#374151" Margin="0,0,0,10" Padding="3"/>

                                    <TextBlock Text="Adres" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <TextBox x:Name="QuickAddressTextBox" Background="#111827" Foreground="White" BorderBrush="#374151" Padding="5" Margin="0,0,0,10"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Cinsiyet" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="QuickGenderComboBox"
                                              Background="#111827"
                                              Foreground="White"
                                              BorderBrush="#374151"
                                              Padding="4"
                                              Margin="0,0,0,10"
                                              DisplayMemberPath="Value"
                                              SelectedValuePath="Value"/>

                                    <TextBlock Text="Yaş Aralığı" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="QuickAgeRangeComboBox"
                                              Background="#111827"
                                              Foreground="White"
                                              BorderBrush="#374151"
                                              Padding="4"
                                              Margin="0,0,0,10"
                                              DisplayMemberPath="Value"
                                              SelectedValuePath="Value"/>

                                    <TextBlock Text="Kan Grubu" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="QuickBloodTypeComboBox"
                                              Background="#111827"
                                              Foreground="White"
                                              BorderBrush="#374151"
                                              Padding="4"
                                              Margin="0,0,0,10"
                                              DisplayMemberPath="Value"
                                              SelectedValuePath="Value"/>

                                    <TextBlock Text="Sağlık Durumu" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <TextBox x:Name="QuickHealthStatusTextBox" Background="#111827" Foreground="White" BorderBrush="#374151" Padding="5" Margin="0,0,0,10"/>

                                    <TextBlock Text="Aşı Durumu" Foreground="#9CA3AF" Margin="0,0,0,3" FontWeight="SemiBold"/>
                                    <TextBox x:Name="QuickVaccineStatusTextBox" Background="#111827" Foreground="White" BorderBrush="#374151" Padding="5" Margin="0,0,0,10"/>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="SaveQuickPersonButton"
                                    Content="👁️ Bilgileri Önizle ve Kaydet"
                                    Background="#10B981"
                                    Foreground="White"
                                    Padding="15,10"
                                    FontWeight="Bold"
                                    Margin="0,15,0,0"
                                    Click="SaveQuickPersonButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="Step2Grid" Visibility="Collapsed">
                <Border Background="#1F2937"
                        CornerRadius="8"
                        Padding="25"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Width="500"
                        Margin="0,10,0,0">

                    <StackPanel>
                        <TextBlock Text="🗺️ Tur ve Grup Bilgileri"
                                   Foreground="#06B6D4"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Tur Türü Seçiniz"
                                   Foreground="#9CA3AF"
                                   Margin="0,0,0,5"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="TourTypeComboBox"
                                  Background="#111827"
                                  Foreground="White"
                                  BorderBrush="#374151"
                                  Padding="8"
                                  Margin="0,0,0,15"
                                  SelectionChanged="TourDetails_SelectionChanged"/>

                        <TextBlock Text="Dönem Seçiniz"
                                   Foreground="#9CA3AF"
                                   Margin="0,0,0,5"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="PeriodComboBox"
                                  Background="#111827"
                                  Foreground="White"
                                  BorderBrush="#374151"
                                  Padding="8"
                                  Margin="0,0,0,15"
                                  SelectionChanged="TourDetails_SelectionChanged"/>

                        <TextBlock Text="Grup Türü Seçiniz"
                                   Foreground="#9CA3AF"
                                   Margin="0,0,0,5"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="GroupTypeComboBox"
                                  Background="#111827"
                                  Foreground="White"
                                  BorderBrush="#374151"
                                  Padding="8"
                                  Margin="0,0,0,15"
                                  SelectionChanged="TourDetails_SelectionChanged"/>

                        <TextBlock Text="Grup Süresi (Gün)"
                                   Foreground="#9CA3AF"
                                   Margin="0,0,0,5"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="DaysCountComboBox"
                                  Background="#111827"
                                  Foreground="White"
                                  BorderBrush="#374151"
                                  Padding="8"
                                  Margin="0,0,0,10"
                                  SelectionChanged="TourDetails_SelectionChanged"/>

                        <TextBlock Text="* Devam etmek için yukarıdaki tüm alanları doldurmanız zorunludur."
                                   Foreground="#EF4444"
                                   FontSize="11"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <Border Grid.Row="2" Background="#1F2937" Padding="15">
            <Grid>

                <Button x:Name="BackButton"
                        Content="Geri"
                        HorizontalAlignment="Left"
                        Background="#374151"
                        Foreground="White"
                        Padding="25,10"
                        FontWeight="Bold"
                        Click="BackButton_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="ToggleActiveButton"
                        Content="⚡ Seçilen Kişiyi Aktif Yap ve İlerle"
                        HorizontalAlignment="Center"
                        Background="#10B981"
                        Foreground="White"
                        Padding="20,10"
                        FontWeight="Bold"
                        Visibility="Collapsed"
                        Click="ToggleActiveButton_Click"/>

                <Button x:Name="NextButton"
                        Content="İleri"
                        HorizontalAlignment="Right"
                        Background="#06B6D4"
                        Foreground="White"
                        Padding="25,10"
                        FontWeight="Bold"
                        Click="NextButton_Click"
                        IsEnabled="False"/>
            </Grid>
        </Border>

    </Grid>
</Page>