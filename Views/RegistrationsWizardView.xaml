<Page x:Class="TurizmOperasyonSistemi.Views.RegistrationsWizardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TurizmOperasyonSistemi.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="RegistrationsWizardView">

    <Page.Resources>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="InputForegroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="InputFocusBrush" Color="#22D3EE"/>
        <SolidColorBrush x:Key="InputMutedBackgroundBrush" Color="#233043"/>
        <SolidColorBrush x:Key="InputMutedForegroundBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#223047"/>
        <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="GridRowBackgroundBrush" Color="#162033"/>
        <SolidColorBrush x:Key="GridAltRowBackgroundBrush" Color="#111827"/>
        <SolidColorBrush x:Key="GridSelectionBrush" Color="#0EA5E9"/>

        <!-- Footer button styles (copied locally so Registrations view can use them) -->
        <Style x:Key="RegFooterButtonBase" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#AA06B6D4" BlurRadius="44" ShadowDepth="10" Opacity="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#22D3EE"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#AA06B6D4" BlurRadius="28" ShadowDepth="4" Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.98"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RegFooterButtonPrimary" TargetType="Button" BasedOn="{StaticResource RegFooterButtonBase}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#06B6D4" Offset="0"/>
                        <GradientStop Color="#0894A8" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#0F5566"/>
        </Style>

        <Style x:Key="RegFooterButtonSave" TargetType="Button" BasedOn="{StaticResource RegFooterButtonBase}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#10B981" Offset="0"/>
                        <GradientStop Color="#0E9F6A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#0B7A54"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd"
                                    CornerRadius="12"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#AA10B981" BlurRadius="48" ShadowDepth="12" Opacity="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#AA10B981" BlurRadius="30" ShadowDepth="6" Opacity="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.98"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RegFooterButtonDanger" TargetType="Button" BasedOn="{StaticResource RegFooterButtonBase}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EF4444" Offset="0"/>
                        <GradientStop Color="#DC2626" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#7A1A1A"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputFocusBrush}"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{StaticResource InputMutedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource InputMutedForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="#7C8CA3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="12,0,8,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>

                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="#1E293B"
                                                  BorderBrush="#475569"
                                                  BorderThickness="1,0,0,0"
                                                  OverridesDefaultStyle="True">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1,0,0,0" CornerRadius="0,6,6,0">
                                                    <TextBlock Text="▼" Foreground="#E2E8F0" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- Transparent overlay so clicking anywhere inside the ComboBox opens the dropdown -->
                            <ToggleButton Grid.ColumnSpan="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Panel.ZIndex="10"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,4,0,0"
                                        Background="#182235"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- No hover effects: keep visual stable on mouse over -->
                            <!-- Focus: indicate with subtle border and gentle shadow -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                                <Setter TargetName="ComboBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.06"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#182235"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0EA5E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#0EA5E9"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5EEF8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="RowBackground" Value="{StaticResource GridRowBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource GridAltRowBackgroundBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#314158"/>
            <Setter Property="VerticalGridLinesBrush" Value="#243246"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource HeaderForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="#4B5C73"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid Background="#111827">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="WizardStepsPanel"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,20"
                    Visibility="Collapsed">

            <Border x:Name="Step1Border"
                    Background="#FFF59E0B"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step1Text"
                           Text="1. Kişi Seçimi"
                           Foreground="White"
                           FontWeight="Bold"/>
            </Border>

            <Border x:Name="Step2Border"
                    Background="#FFF59E0B"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step2Text"
                           Text="2. Tur"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step3Border"
                    Background="#FFF59E0B"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step3Text"
                           Text="3. Vize"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step4Border"
                    Background="#FFF59E0B"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step4Text"
                           Text="4. Bilet"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step5Border"
                    Background="#FFF59E0B"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step5Text"
                           Text="5. Kargo"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step6Border"
                    Background="#FFF59E0B"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step6Text"
                           Text="6. Oda Türü"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step7Border"
                    Background="#FFF59E0B"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step7Text"
                           Text="7. Katılım Şehri"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step8Border"
                    Background="#FFF59E0B"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step8Text"
                           Text="8. Fiyat Ödeme"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step9Border"
                    Background="#FFF59E0B"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step9Text"
                           Text="9. Referans"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step10Border"
                    Background="#FFF59E0B"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step10Text"
                           Text="10. Önizleme"
                           Foreground="#9CA3AF"/>
            </Border>

        </StackPanel>

        <Grid Grid.Row="1" Margin="20,0,20,20">

            <Grid x:Name="RegistrationBrowserGrid" Visibility="Visible">
                <Border x:Name="RegistrationBrowserContentBorder"
                        Background="#161B2E"
                        BorderBrush="#F59E0B"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Title row: should remain unblurred -->
                        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">
                            <TextBlock x:Name="RegistrationBrowserTitleTextBlock"
                                       Text="📋 Kaydedilen Operasyonlar"
                                       Foreground="#FBBF24"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Non-blurred area: description and search (user requested to exclude these from blur) -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <Grid Margin="0,4,0,8">


                                <!-- Ön plan net neon metin -->
                                <TextBlock x:Name="RegistrationBrowserInstructionTextBlock" Foreground="#E6FCFF"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center">
                                    <Run Text="İlgili dönemde yapmak istediğiniz TUR kaydının daha önceden yapılıp yapılmadığını kontrol etmek için "/>
                                    <Run Text="ADI SOYADI" Foreground="#F59E0B" FontWeight="Bold" />
                                    <Run Text=" ile arama yapınız." />
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#38BDF8" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="RegistrationSearchTextBox"
                                         Grid.Column="0"
                                         Background="#0F172A"
                                         Foreground="White"
                                         BorderBrush="#475569"
                                         Padding="10,8"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"
                                         TextChanged="RegistrationSearchTextBox_TextChanged"
                                         Tag="Yolcu adı, tur, şehir veya referans ara..."/>

                                <ComboBox x:Name="RegistrationPeriodFilterComboBox"
                                          Grid.Column="2"
                                          Background="#0F172A"
                                          Foreground="White"
                                          BorderBrush="#475569"
                                          Padding="8"
                                          FontSize="13"
                                          SelectionChanged="RegistrationPeriodFilterComboBox_SelectionChanged"/>
                            </Grid>

                            <!-- Inline no-results panel directly under the search box (shows when no matching registrations) -->
                            <Border x:Name="InlineNoRegistrationPanel"
                                    Background="#0B1220"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Panel.ZIndex="50">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock x:Name="InlineNoRegistrationMessageTextBlock"
                                               Text="Aradığınız tur kaydı listede bulunamadı"
                                               Foreground="#FBBF24"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                    <Button x:Name="InlineStartNewRegistrationButton"
                                            Content="Yeni Tur Kaydı Ekle +"
                                            Background="#10B981"
                                            Foreground="White"
                                            Padding="10,6"
                                            Margin="12,0,0,0"
                                            FontWeight="Bold"
                                            Click="StartNewRegistrationButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Blurable content: action buttons, grid, warning panel -->
                        <Grid x:Name="RegistrationBrowserBlurContainer" Grid.Row="2" Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Action buttons (these will be blurred together with the grid below) -->
                                <Button x:Name="EditRegistrationButton"
                                        Grid.Column="1"
                                        Style="{StaticResource RegFooterButtonPrimary}"
                                        Content="Kaydı Düzenle"
                                        Margin="18,30,10,0"
                                        Click="EditRegistrationButton_Click"
                                        Visibility="Collapsed"/>

                                <Button x:Name="SetRegistrationPassiveButton"
                                        Grid.Column="2"
                                        Style="{StaticResource RegFooterButtonSave}"
                                        Content="Pasif Yap"
                                        Margin="0,30,10,0"
                                        Click="SetRegistrationPassiveButton_Click"
                                        Visibility="Collapsed"/>

                                <Button x:Name="DeleteRegistrationButton"
                                        Grid.Column="3"
                                        Style="{StaticResource RegFooterButtonDanger}"
                                        Content="Kaydı Sil"
                                        Margin="0,30,0,0"
                                        Click="DeleteRegistrationButton_Click"
                                        Visibility="Collapsed"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <DataGrid x:Name="RegistrationsDataGrid" MouseDoubleClick="RegistrationsDataGrid_MouseDoubleClick"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      MinHeight="360"
                                      Background="#0F172A"
                                      RowBackground="#162033"
                                      AlternatingRowBackground="#111827"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      SelectionMode="Single"
                                      SelectionChanged="RegistrationsDataGrid_SelectionChanged"
                                      FrozenColumnCount="3"
                                      ColumnWidth="Auto">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="#475569"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="None" HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <!-- Default TextBlock inside DataGrid (cells) should trim long text but stay vertically centered -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="FontSize" Value="12.5"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="#162033"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pasif">
                                                    <Setter Property="Background" Value="#2B3240"/>
                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    <Setter Property="Opacity" Value="0.72"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="İptal">
