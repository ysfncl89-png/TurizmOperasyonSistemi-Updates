<Page x:Class="TurizmOperasyonSistemi.Views.RegistrationsWizardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TurizmOperasyonSistemi.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="RegistrationsWizardView">

    <Page.Resources>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="InputForegroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="InputFocusBrush" Color="#22D3EE"/>
        <SolidColorBrush x:Key="InputMutedBackgroundBrush" Color="#233043"/>
        <SolidColorBrush x:Key="InputMutedForegroundBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#223047"/>
        <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="GridRowBackgroundBrush" Color="#162033"/>
        <SolidColorBrush x:Key="GridAltRowBackgroundBrush" Color="#111827"/>
        <SolidColorBrush x:Key="GridSelectionBrush" Color="#0EA5E9"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputFocusBrush}"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{StaticResource InputMutedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource InputMutedForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="#7C8CA3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="12,0,8,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>

                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="#1E293B"
                                                  BorderBrush="#475569"
                                                  BorderThickness="1,0,0,0"
                                                  OverridesDefaultStyle="True">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1,0,0,0" CornerRadius="0,6,6,0">
                                                    <TextBlock Text="▼" Foreground="#E2E8F0" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- Transparent overlay so clicking anywhere inside the ComboBox opens the dropdown -->
                            <ToggleButton Grid.ColumnSpan="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Panel.ZIndex="10"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,4,0,0"
                                        Background="#182235"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- No hover effects: keep visual stable on mouse over -->
                            <!-- Focus: indicate with subtle border and gentle shadow -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                                <Setter TargetName="ComboBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.06"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#182235"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0EA5E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#0EA5E9"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5EEF8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="RowBackground" Value="{StaticResource GridRowBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource GridAltRowBackgroundBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#314158"/>
            <Setter Property="VerticalGridLinesBrush" Value="#243246"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource HeaderForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="#4B5C73"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GridSelectionBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#111827">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="WizardStepsPanel"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,20"
                    Visibility="Collapsed">

            <Border x:Name="Step1Border"
                    Background="#06B6D4"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step1Text"
                           Text="1. Kişi Seçimi"
                           Foreground="White"
                           FontWeight="Bold"/>
            </Border>

            <Border x:Name="Step2Border"
                    Background="#1F2937"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step2Text"
                           Text="2. Tur"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step3Border"
                    Background="#1F2937"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step3Text"
                           Text="3. Vize Bilet"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step4Border"
                    Background="#1F2937"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step4Text"
                           Text="4. Kargo"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step5Border"
                    Background="#1F2937"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step5Text"
                           Text="5. Oda Türü"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step6Border"
                    Background="#1F2937"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step6Text"
                           Text="6. Katılım Şehri"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step7Border"
                    Background="#1F2937"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step7Text"
                           Text="7. Fiyat Ödeme"
                           Foreground="#9CA3AF"/>
               
            </Border>

            <Border x:Name="Step8Border"
                    Background="#1F2937"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step8Text"
                           Text="8. Referans"
                           Foreground="#9CA3AF"/>
            </Border>

            <Border x:Name="Step9Border"
                    Background="#1F2937"
                    CornerRadius="15"
                    Padding="15,8"
                    Margin="5">
                <TextBlock x:Name="Step9Text"
                           Text="9. Önizleme"
                           Foreground="#9CA3AF"/>
            </Border>

        </StackPanel>

        <Grid Grid.Row="1" Margin="20,0,20,20">

            <Grid x:Name="RegistrationBrowserGrid" Visibility="Visible">
                <Border x:Name="RegistrationBrowserContentBorder"
                        Background="#161B2E"
                        BorderBrush="#F59E0B"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                        <TextBlock Text="📋 Kaydedilen Operasyonlar"
                                           Foreground="#FBBF24"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Yeni Tur Kaydı Yapmadan Önce Yapmak istediğiniz Kaydın Daha Önceden Yapılıp Yapılmadığını Kontrol Etmek İçin Arama Yapın"
                                           Foreground="#D1D5DB"
                                           Margin="0,4,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="RegistrationSearchTextBox"
                                             Grid.Column="0"
                                             Background="#0F172A"
                                             Foreground="White"
                                             BorderBrush="#475569"
                                             Padding="10,8"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"
                                             TextChanged="RegistrationSearchTextBox_TextChanged"
                                             Tag="Yolcu adı, tur, şehir veya referans ara..."/>

                                    <ComboBox x:Name="RegistrationPeriodFilterComboBox"
                                              Grid.Column="2"
                                              Background="#0F172A"
                                              Foreground="White"
                                              BorderBrush="#475569"
                                              Padding="8"
                                              FontSize="13"
                                              SelectionChanged="RegistrationPeriodFilterComboBox_SelectionChanged"/>
                                </Grid>
                            </StackPanel>

                            <Button x:Name="EditRegistrationButton"
                                    Grid.Column="1"
                                    Content="Kaydı Düzenle"
                                    Margin="18,30,10,0"
                                    Background="#2563EB"
                                    Foreground="White"
                                    Padding="16,10"
                                    FontWeight="Bold"
                                    Click="EditRegistrationButton_Click"
                                    IsEnabled="False"/>

                            <Button x:Name="SetRegistrationPassiveButton"
                                    Grid.Column="2"
                                    Content="Pasif Yap"
                                    Margin="0,30,10,0"
                                    Background="#F59E0B"
                                    Foreground="White"
                                    Padding="16,10"
                                    FontWeight="Bold"
                                    Click="SetRegistrationPassiveButton_Click"
                                    IsEnabled="False"/>

                            <Button x:Name="DeleteRegistrationButton"
                                    Grid.Column="3"
                                    Content="Kaydı Sil"
                                    Margin="0,30,0,0"
                                    Background="#DC2626"
                                    Foreground="White"
                                    Padding="16,10"
                                    FontWeight="Bold"
                                    Click="DeleteRegistrationButton_Click"
                                    IsEnabled="False"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <DataGrid x:Name="RegistrationsDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      MinHeight="360"
                                      Background="#0F172A"
                                      RowBackground="#162033"
                                      AlternatingRowBackground="#111827"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      SelectionMode="Single"
                                      SelectionChanged="RegistrationsDataGrid_SelectionChanged">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="#475569"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="FontSize" Value="12.5"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="#162033"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Pasif">
                                                <Setter Property="Background" Value="#2B3240"/>
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                <Setter Property="Opacity" Value="0.72"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="İptal">
                                                <Setter Property="Background" Value="#3A1F24"/>
                                                <Setter Property="Foreground" Value="#FCA5A5"/>
                                                <Setter Property="Opacity" Value="0.82"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Kaydı Düzenle"
                                                  Click="EditRegistrationMenuItem_Click"/>
                                        <MenuItem x:Name="SetRegistrationPassiveMenuItem"
                                                  Header="Pasif Yap"
                                                  Click="SetRegistrationPassiveMenuItem_Click"/>
                                        <MenuItem x:Name="DeleteRegistrationMenuItem"
                                                  Header="Kaydı Sil"
                                                  Click="DeleteRegistrationMenuItem_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kayıt No" Binding="{Binding Id}" Width="90"/>
                                    <DataGridTextColumn Header="Yolcu Adı" Binding="{Binding PersonFullName}" Width="180"/>
                                    <DataGridTextColumn Header="Tur Türü" Binding="{Binding TourType}" Width="130"/>
                                    <DataGridTextColumn Header="Dönem" Binding="{Binding Period}" Width="130"/>
                                    <DataGridTextColumn Header="Grup Türü" Binding="{Binding GroupType}" Width="120"/>
                                    <DataGridTextColumn Header="Gün Sayısı" Binding="{Binding DaysCount}" Width="100"/>
                                    <DataGridTextColumn Header="Vize Talebi" Binding="{Binding VisaRequest}" Width="110"/>
                                    <DataGridTextColumn Header="Bilet Talebi" Binding="{Binding TicketRequest}" Width="110"/>
                                    <DataGridTextColumn Header="Kargo Talebi" Binding="{Binding CargoRequest}" Width="110"/>
                                    <DataGridTextColumn Header="Oda Türü" Binding="{Binding RoomType}" Width="110"/>
                                    <DataGridTextColumn Header="Katılım Şehri" Binding="{Binding DepartureCity}" Width="120"/>
                                    <DataGridTextColumn Header="Aktarma" Binding="{Binding TransferStatus}" Width="90"/>
                                    <DataGridTextColumn Header="Aktarma Şehri" Binding="{Binding TransferCity}" Width="120"/>
                                    <DataGridTextColumn Header="İlçe" Binding="{Binding District}" Width="110"/>
                                    <DataGridTextColumn Header="Toplam Fiyat" Binding="{Binding TotalPriceDisplay}" Width="130"/>
                                    <DataGridTextColumn Header="Ödenen" Binding="{Binding PaidAmountDisplay}" Width="120"/>
                                    <DataGridTextColumn Header="Kalan" Binding="{Binding RemainingDebtDisplay}" Width="120"/>
                                    <DataGridTextColumn Header="Para Birimi" Binding="{Binding Currency}" Width="100"/>
                                    <DataGridTextColumn Header="Referans" Binding="{Binding Reference}" Width="140"/>
                                    <DataGridTextColumn Header="Kayıt Tarihi" Binding="{Binding CreatedDateDisplay}" Width="130"/>
                                    <DataGridTextColumn Header="Aktiflik" Binding="{Binding IsActiveDisplay}" Width="90"/>
                                    <DataGridTextColumn Header="Kayıt Durumu" Binding="{Binding Status}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border x:Name="NoRegistrationResultsPanel"
                                    Background="#0B1220"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="28,22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Bu Kayıt daha Önce Yapılmamış"
                                               Foreground="#FBBF24"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <Button x:Name="StartNewRegistrationButton"
                                            Content="Kayıt Yapmak İçin İlerle"
                                            Background="#10B981"
                                            Foreground="White"
                                            Padding="16,10"
                                            Margin="0,14,0,0"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            Click="StartNewRegistrationButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="RegistrationPeriodGuideOverlay"
                      Background="#7A0F172A"
                      Visibility="Collapsed"
                      Panel.ZIndex="40">
                    <Border Width="420"
                            Padding="24"
                            CornerRadius="18"
                            Background="#111827"
                            BorderBrush="#FBBF24"
                            BorderThickness="1.8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="Önce Dönem Seçin"
                                       Foreground="#FBBF24"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Kayıtları filtreleyerek ilerlemek için önce dönem seçin."
                                       Foreground="#E5E7EB"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,18"/>
                            <ComboBox x:Name="RegistrationPeriodGuideComboBox"
                                      Height="40"
                                      Background="#0F172A"
                                      Foreground="White"
                                      BorderBrush="#FBBF24"
                                      BorderThickness="2"
                                      Padding="8"
                                      FontSize="13"
                                      SelectionChanged="RegistrationPeriodGuideComboBox_SelectionChanged"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="Step1Grid" Visibility="Collapsed" Background="#990F172A">
                <Border Background="#111827"
                        CornerRadius="16"
                        Panel.ZIndex="200">
                    <Frame x:Name="PersonsModuleFrame"
                           NavigationUIVisibility="Hidden"/>
                </Border>

                <Border Background="#172033"
                        BorderBrush="#22D3EE"
                        BorderThickness="1.5"
                        CornerRadius="22"
                        Padding="24"
                        Width="1180"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="👤 Kişi Seçimi"
                                       Foreground="#F8FAFC"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Tur kaydını yapacağınız kişinin sistemde daha önce kayıtlı olup olmadığını kontrol edin. Kayıt varsa seçin, yoksa popup formdan yeni kişi oluşturun."
                                       Foreground="#CBD5E1"
                                       FontSize="13"
                                       Margin="0,8,0,16"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SearchTextBox"
                                     Background="#111827"
                                     Foreground="White"
                                     BorderBrush="#374151"
                                     Padding="10,8"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged"
                                     Tag="Ad, Soyad veya TC Kimlik No yazın..."/>

                            <CheckBox x:Name="ShowPassiveCheckBox"
                                      Content="Pasif Kişileri De Göster"
                                      Grid.Column="1"
                                      Foreground="White"
                                      Margin="15,0,0,0"
                                      VerticalAlignment="Center"
                                      FontWeight="Bold"
                                      Checked="ShowPassiveCheckBox_Changed"
                                      Unchecked="ShowPassiveCheckBox_Changed"/>

                            <Button x:Name="SearchButton"
                                    Content="Ara"
                                    Grid.Column="2"
                                    Margin="15,0,0,0"
                                    Background="#06B6D4"
                                    Foreground="White"
                                    Padding="20,0"
                                    FontWeight="Bold"
                                    Click="SearchButton_Click"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="PersonsDataGrid"
                                      Grid.Row="0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#1F2937"
                                      RowBackground="#1F2937"
                                      AlternatingRowBackground="#111827"
                                      Foreground="White"
                                      BorderBrush="#374151"
                                      HeadersVisibility="Column"
                                      SelectionChanged="PersonsDataGrid_SelectionChanged">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Adı" Binding="{Binding FirstName}" Width="120"/>
                                    <DataGridTextColumn Header="Soyadı" Binding="{Binding LastName}" Width="120"/>
                                    <DataGridTextColumn Header="TC Kimlik No" Binding="{Binding TcNo}" Width="110"/>
                                    <DataGridTextColumn Header="Cinsiyet" Binding="{Binding Gender}" Width="80"/>
                                    <DataGridTextColumn Header="Doğum Tarihi" Binding="{Binding BirthDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
