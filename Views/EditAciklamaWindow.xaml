<Window x:Class="TurizmOperasyonSistemi.Views.EditAciklamaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Açıklama Düzenle" Height="220" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0F1724">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Açıklama" Foreground="#E6F9FF" FontSize="14" FontWeight="SemiBold" />
        <TextBox x:Name="AciklamaTextBox" Grid.Row="1" Height="96" Margin="0,8,0,0" Background="#0F172A" Foreground="#E2F8FF" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="İptal" Width="100" Height="36" Margin="0,0,8,0" Click="CancelButton_Click" Background="#374151" Foreground="White"/>
            <Button x:Name="OkButton" Content="Kaydet" Width="100" Height="36" Click="OkButton_Click" Background="#06B6D4" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
