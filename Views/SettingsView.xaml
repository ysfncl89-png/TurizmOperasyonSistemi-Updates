<Page x:Class="TurizmOperasyonSistemi.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111827">

    <Page.Resources>

        <Style x:Key="SettingCardStyle" TargetType="Button">

            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect BlurRadius="25"
                                                          ShadowDepth="0"
                                                          Color="#38BDF8"
                                                          Opacity="0.8"/>

                                    </Setter.Value>

                                </Setter>

                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#67E8F9"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">

            <TextBlock Text="Ayarlar Modülü"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,25"/>

            <WrapPanel ItemWidth="220"
                       ItemHeight="120">

                <!-- CARD -->

                <Button Content="Cinsiyet"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Yaş Aralığı"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Kan Grubu"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Pasaport Türü"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Tur Türü"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Dönem"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Grup Türü"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Vize Talebi"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Kargo Talebi"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Bilet Talebi"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Aktarma Var mı?"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Aktarma Şehri"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Para Birimi"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Oda Türü"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Otel Ekle"
                        Style="{StaticResource SettingCardStyle}"
                        FontWeight="Bold"
                        
                        Click="SettingButton_Click"/>

               

            </WrapPanel>

        </StackPanel>

    </ScrollViewer>

</Page>