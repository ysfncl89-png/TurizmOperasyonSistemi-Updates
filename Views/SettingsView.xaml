<Page x:Class="TurizmOperasyonSistemi.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111827">

    <Page.Resources>

        <Style x:Key="SettingCardStyle" TargetType="Button">

            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#FFEC4899"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect BlurRadius="25"
                                                          ShadowDepth="0"
                                        Color="#FFEC4899"
                                                          Opacity="0.8"/>

                                    </Setter.Value>

                                </Setter>

                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#FFEC4899"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Neon search box to match setting cards -->
        <Style x:Key="NeonSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#FFEC4899"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFEC4899"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFEC4899" BlurRadius="22" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FFEC4899"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFEC4899" BlurRadius="30" ShadowDepth="0" Opacity="0.95"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        

    </Page.Resources>
    

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        

        <StackPanel Margin="25">
            

            <TextBlock Text="Ayarlar Modülü"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,25"/>
            <TextBlock Text="Programla ilgili ayarlamalar yapmak için bu kartları kullanabilirsiniz. "
           FontSize="15"
           FontWeight="Bold"
           Foreground="White"
           Margin="0,0,0,25"/>
            <TextBlock Text="DİKKAT ! Programdaki kutucukların içine giden bilgi buradan sağlanmaktadır. Kutucuklara yeni bilgi eklemek isterseniz Sıra numarasını yazınız. "
           FontSize="15"
           FontWeight="Bold"
           Foreground="#FBBF24"
           Margin="0,0,0,25"/>

            <DockPanel Margin="0,0,0,20">
                <TextBox x:Name="SearchTextBox"
                         Style="{StaticResource NeonSearchBoxStyle}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         TextChanged="SearchTextBox_TextChanged"/>
            </DockPanel>
            

            <WrapPanel x:Name="SettingsWrapPanel" ItemWidth="220"
                       ItemHeight="120">
                

                <!-- CARD -->
                

                <Button Content="Cinsiyet"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Yaş Aralığı"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Kan Grubu"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Pasaport Türü"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Uyruk"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Vize Durumu"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Pasaportu Geldi mi ?"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Bilet Durumu"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Tur Türü"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Dönem"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Grup Türü"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Kaç Günlük Grup"
        Style="{StaticResource SettingCardStyle}"
        Click="SettingButton_Click"/>

                <Button Content="Vize Talebi"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Kargo Talebi"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Bilet Talebi"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>
                
                <Button Content="Aktarma Şehri"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>



                <Button Content="Aktarma Var mı?"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Katılım Yapılacak Şehir"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Para Birimi"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Ödeme Yöntemi"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Oda Türü"
                        Style="{StaticResource SettingCardStyle}"
                        Click="SettingButton_Click"/>

                <Button Content="Otel Ekle"
                        Style="{StaticResource SettingCardStyle}"

                        
                        Click="SettingButton_Click"/>

               

            </WrapPanel>

        </StackPanel>

    </ScrollViewer>

</Page>
