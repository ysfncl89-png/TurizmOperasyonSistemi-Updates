<Window x:Class="TurizmOperasyonSistemi.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hakkında" Height="235" Width="620" WindowStyle="None" ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True">
    <Border Background="#FF4A7B8B" CornerRadius="12" Padding="16" BorderThickness="1" BorderBrush="#22324A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Turizm Operasyon Sistemi - Hakkında" Foreground="#E2E8F0" FontSize="16" FontWeight="Bold" />

            <StackPanel Grid.Row="1" Margin="0,12,0,12">
                <TextBlock x:Name="TxtProgramVersion" Foreground="#CBD5E1" FontSize="13" Margin="0,4" />
                <TextBlock x:Name="TxtReleaseTag" Foreground="#CBD5E1" FontSize="13" Margin="0,4" />
                <TextBlock x:Name="TxtMigrationVersion" Foreground="#CBD5E1" FontSize="13" Margin="0,4" />
                <TextBlock x:Name="TxtPendingMigrations" Foreground="#CBD5E1" FontSize="13" Margin="0,4" />
                <TextBlock x:Name="TxtDatabaseVersion" Foreground="#CBD5E1" FontSize="13" Margin="0,4" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Update status on the left -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <TextBlock x:Name="UpdateStatusIcon" Text="" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtUpdateStatus" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Update and close buttons on the right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnGetLatest" Content="Son güncellemeyi al" MinWidth="145" Margin="0,0,8,0" Background="#16A34A" Foreground="White" BorderThickness="0" Visibility="Collapsed" />
                    <Button x:Name="BtnClose" Content="Kapat" MinWidth="90" Margin="0,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
