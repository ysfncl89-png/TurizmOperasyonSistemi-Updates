<Window x:Class="TurizmOperasyonSistemi.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hakkında" Height="260" Width="420" WindowStyle="None" ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True">
    <Border Background="#0F172A" CornerRadius="12" Padding="16" BorderThickness="1" BorderBrush="#22324A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Turizm Operasyon Sistemi - Hakkında" Foreground="#E2E8F0" FontSize="16" FontWeight="Bold" />

            <StackPanel Grid.Row="1" Margin="0,12,0,12">
                <TextBlock x:Name="TxtProgramVersion" Foreground="#CBD5E1" FontSize="13" Margin="0,4" />
                <TextBlock x:Name="TxtManifestVersion" Foreground="#CBD5E1" FontSize="13" Margin="0,4" />
                <TextBlock x:Name="TxtManifestAppVersion" Foreground="#CBD5E1" FontSize="13" Margin="0,4" />
                <TextBlock x:Name="TxtMigrationVersion" Foreground="#CBD5E1" FontSize="13" Margin="0,4" />
                <TextBlock x:Name="TxtDatabaseVersion" Foreground="#CBD5E1" FontSize="13" Margin="0,4" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClose" Content="Kapat" MinWidth="90" Margin="0,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
