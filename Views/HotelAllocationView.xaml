<UserControl x:Class="TurizmOperasyonSistemi.Views.HotelAllocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TurizmOperasyonSistemi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#0F172A">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B" Padding="15" Margin="10" CornerRadius="8">
            <UniformGrid Columns="3" x:Name="WizardTabs">
                <Border x:Name="Tab1" Background="#06B6D4" CornerRadius="4" Margin="5" Padding="10">
                    <TextBlock Text="1. Otel Seçimi"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border x:Name="Tab2" Background="#334155" CornerRadius="4" Margin="5" Padding="10">
                    <TextBlock Text="2. Tur Kriterleri"
                               Foreground="#94A3B8"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border x:Name="Tab3" Background="#334155" CornerRadius="4" Margin="5" Padding="10">
                    <TextBlock Text="3. Odalama Motoru"
                               Foreground="#94A3B8"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="1" Margin="15">

            <Grid x:Name="Step1Grid" Visibility="Visible">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="400">

                    <TextBlock Text="🏨 Odalama Yapılacak Oteli Seçin"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center"/>

                    <ComboBox x:Name="HotelSelectComboBox"
                              Height="40"
                              Background="#1E293B"
                              Foreground="White"
                              BorderBrush="#334155"
                              Padding="10,5"/>

                    <TextBlock Text="* Ayarlar modülünde eklediğiniz oteller burada listelenir."
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="Step2Grid" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="450">

                    <TextBlock Text="🔍 Yolcu Havuzu Filtreleme Kriterleri"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Tur Türü"
                               Foreground="#94A3B8"
                               Margin="0,5,0,5"/>

                    <ComboBox x:Name="TourTypeComboBox"
                              Height="35"
                              Background="#1E293B"
                              Foreground="White"
                              BorderBrush="#334155"/>

                    <TextBlock Text="Dönem"
                               Foreground="#94A3B8"
                               Margin="0,10,0,5"/>

                    <ComboBox x:Name="PeriodComboBox"
                              Height="35"
                              Background="#1E293B"
                              Foreground="White"
                              BorderBrush="#334155"/>

                    <Grid Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">

                            <TextBlock Text="Grup Türü"
                                       Foreground="#94A3B8"
                                       Margin="0,0,0,5"/>

                            <ComboBox x:Name="GroupTypeComboBox"
                                      Height="35"
                                      Background="#1E293B"
                                      Foreground="White"
                                      BorderBrush="#334155"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,0,0">

                            <TextBlock Text="Süre (Gün)"
                                       Foreground="#94A3B8"
                                       Margin="0,0,0,5"/>

                            <ComboBox x:Name="DurationComboBox"
                                      Height="35"
                                      Background="#1E293B"
                                      Foreground="White"
                                      BorderBrush="#334155"/>
                        </StackPanel>

                    </Grid>

                </StackPanel>
            </Grid>

            <Grid x:Name="Step3Grid" Visibility="Collapsed">
                <TextBlock Text="Odalama Motoru Buraya Gelecek"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

        </Grid>

        <Border Grid.Row="2"
                Background="#1E293B"
                Padding="15"
                CornerRadius="0,0,8,8">

            <Grid>

                <Button x:Name="BackButton"
                        Content="◀ Geri"
                        HorizontalAlignment="Left"
                        Width="100"
                        Height="35"
                        Background="#334155"
                        Foreground="White"
                        BorderThickness="0"
                        Click="BackButton_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="NextButton"
                        Content="İleri ▶"
                        HorizontalAlignment="Right"
                        Width="100"
                        Height="35"
                        Background="#06B6D4"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="NextButton_Click"/>
            </Grid>

        </Border>

    </Grid>

</UserControl>