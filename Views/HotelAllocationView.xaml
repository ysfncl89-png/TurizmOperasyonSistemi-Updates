<UserControl x:Class="TurizmOperasyonSistemi.Views.HotelAllocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TurizmOperasyonSistemi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="#0F172A">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B" Padding="15" Margin="10" CornerRadius="8">
            <UniformGrid Columns="3" x:Name="WizardTabs">
                <Border x:Name="Tab1" Background="#06B6D4" CornerRadius="4" Margin="5" Padding="10">
                    <TextBlock Text="1. Otel Seçimi"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border x:Name="Tab2" Background="#334155" CornerRadius="4" Margin="5" Padding="10">
                    <TextBlock Text="2. Tur Kriterleri"
                               Foreground="#94A3B8"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border x:Name="Tab3" Background="#334155" CornerRadius="4" Margin="5" Padding="10">
                    <TextBlock Text="3. Odalama Motoru"
                               Foreground="#94A3B8"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="1" Margin="15">

            <Grid x:Name="Step1Grid" Visibility="Visible">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="400">

                    <TextBlock Text="🏨 Odalama Yapılacak Oteli Seçin"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center"/>

                    <ComboBox x:Name="HotelSelectComboBox"
                              Height="40"
                              Background="#1E293B"
                              Foreground="White"
                              BorderBrush="#334155"
                              Padding="10,5"/>

                    <TextBlock Text="* Ayarlar modülünde eklediğiniz oteller burada listelenir."
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="Step2Grid" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="450">

                    <TextBlock Text="🔍 Yolcu Havuzu Filtreleme Kriterleri"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Tur Türü"
                               Foreground="#94A3B8"
                               Margin="0,5,0,5"/>

                    <ComboBox x:Name="TourTypeComboBox"
                              Height="35"
                              Background="#1E293B"
                              Foreground="White"
                              BorderBrush="#334155"/>

                    <TextBlock Text="Dönem"
                               Foreground="#94A3B8"
                               Margin="0,10,0,5"/>

                    <ComboBox x:Name="PeriodComboBox"
                              Height="35"
                              Background="#1E293B"
                              Foreground="White"
                              BorderBrush="#334155"/>

                    <Grid Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">

                            <TextBlock Text="Grup Türü"
                                       Foreground="#94A3B8"
                                       Margin="0,0,0,5"/>

                            <ComboBox x:Name="GroupTypeComboBox"
                                      Height="35"
                                      Background="#1E293B"
                                      Foreground="White"
                                      BorderBrush="#334155"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,0,0">

                            <TextBlock Text="Süre (Gün)"
                                       Foreground="#94A3B8"
                                       Margin="0,0,0,5"/>

                            <ComboBox x:Name="DurationComboBox"
                                      Height="35"
                                      Background="#1E293B"
                                      Foreground="White"
                                      BorderBrush="#334155"/>
                        </StackPanel>

                    </Grid>

                </StackPanel>
            </Grid>

            <Grid x:Name="Step3Grid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="3.5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Margin="0,0,10,0" Padding="15" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="👥 Odalanacak Yolcu Havuzu" Foreground="#06B6D4" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="PassengerCountLabel" Text="Seçilen Kriterlere Uygun: 0 Yolcu Bulundu" Foreground="#94A3B8" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" x:Name="UnallocatedPassengersGrid" 
          Background="Transparent" RowBackground="#0F172A" AlternatingRowBackground="#1E293B"
          Foreground="White" BorderThickness="0" GridLinesVisibility="None"
          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#334155"/>
                                    <Setter Property="Foreground" Value="#06B6D4"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Adı Soyadı" Binding="{Binding FullName}" Width="2*"/>
                                <DataGridTextColumn Header="Talep Edilen Oda" Binding="{Binding RoomType}" Width="1*"/>
                                <DataGridTemplateColumn Header="İşlem" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Odaya Ekle" Background="#06B6D4" Foreground="White" FontWeight="Bold" Padding="5,2" BorderThickness="0" Click="AllocatePassengerButton_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Margin="10,0,0,0" Padding="15" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="SelectedHotelTitleLabel" Text="🏨 Seçilen Otel: Oda Yerleşim Düzeni" Foreground="#06B6D4" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Yolcuları yerleştirmek için sol taraftan yolcu seçip odaya atayın." Foreground="#94A3B8" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#0F172A" Padding="10" CornerRadius="6" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Açılacak Oda Türü (Ayarlar Modülünden)" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="NewRoomCapacityComboBox" Height="28" Background="#1E293B" Foreground="White" BorderBrush="#334155"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="➕ Oda Bloğu Oluştur" Background="#10B981" Foreground="White" FontWeight="Bold" Height="28" VerticalAlignment="Bottom" BorderThickness="0" Click="AddRoomButton_Click"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RoomsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="210" Margin="5" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding RoomNumberDisplay}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12"/>
                                                </Grid>

                                                <Separator Background="#334155" Margin="0,8"/>

                                                <ListBox ItemsSource="{Binding Occupants}" Background="Transparent" BorderThickness="0" Height="80">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Width="180">
                                                                <TextBlock Text="{Binding FullName}" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                                                                <Button Content="❌" Background="Transparent" Foreground="#EF4444" BorderThickness="0" HorizontalAlignment="Right" Padding="2,0" Click="RemovePassengerFromRoomButton_Click" Tag="{Binding PersonId}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <Border Grid.Row="2"
                Background="#1E293B"
                Padding="15"
                CornerRadius="0,0,8,8">

            <Grid>

                <Button x:Name="BackButton"
                        Content="◀ Geri"
                        HorizontalAlignment="Left"
                        Width="100"
                        Height="35"
                        Background="#334155"
                        Foreground="White"
                        BorderThickness="0"
                        Click="BackButton_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="NextButton"
                        Content="İleri ▶"
                        HorizontalAlignment="Right"
                        Width="100"
                        Height="35"
                        Background="#06B6D4"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="NextButton_Click"/>
            </Grid>

        </Border>

    </Grid>

</UserControl>