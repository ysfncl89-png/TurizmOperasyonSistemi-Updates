<UserControl x:Class="TurizmOperasyonSistemi.Views.HotelAllocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TurizmOperasyonSistemi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="HotelComboBackgroundBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="HotelComboForegroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="HotelComboBorderBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="HotelComboFocusBrush" Color="#22D3EE"/>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource HotelComboBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource HotelComboForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HotelComboBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.3"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource HotelComboForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="12,0,8,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>

                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="#1E293B"
                                                  BorderBrush="#475569"
                                                  BorderThickness="1,0,0,0">
                                        <TextBlock Text="▼"
                                                   Foreground="#E2E8F0"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,4,0,0"
                                        Background="#182235"
                                        BorderBrush="#64748B"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource HotelComboFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#182235"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0EA5E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0F172A">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B" Padding="15" Margin="10" CornerRadius="8">
            <UniformGrid Columns="3" x:Name="WizardTabs">

                <Border x:Name="Tab1" Background="#06B6D4" CornerRadius="4" Margin="5" Padding="10">
                    <TextBlock Text="1. Ara Filtrele"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border x:Name="Tab2" Background="#334155" CornerRadius="4" Margin="5" Padding="10">
                    <TextBlock Text="2. Kriter Seçimi"
                               Foreground="#94A3B8"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border x:Name="Tab3" Background="#334155" CornerRadius="4" Margin="5" Padding="10">
                    <TextBlock Text="3. Odalama Motoru"
                               Foreground="#94A3B8"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

            </UniformGrid>
        </Border>

        <Grid Grid.Row="1" Margin="15">

            <ScrollViewer x:Name="Step1Grid"
                          Visibility="Visible"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="HotelSelectionPanel"
                                Grid.Row="0"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Center"
                                Width="620"
                                Margin="0,20,0,20"
                                Visibility="Visible">

                    <TextBlock Text="🔎 Ara Filtrele Adımında Kriterleri Sırayla Seçin"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center"/>

                    <Border x:Name="Step1TourTypeBorder"
                            CornerRadius="10"

                            Padding="12"
                            Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD166" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Tur Türü"
                                       Foreground="#F8FAFC"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="Step1TourTypeComboBox"
                                      Height="40"
                                      Background="#1E293B"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      Padding="10,5"
                                      SelectionChanged="Step1Selection_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Step1PeriodBorder"
                            CornerRadius="10"
                            
                            Padding="12"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD166" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Dönem"
                                       Foreground="#F8FAFC"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="Step1PeriodComboBox"
                                      Height="40"
                                      Background="#1E293B"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      Padding="10,5"
                                      SelectionChanged="Step1Selection_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Step1GroupTypeBorder"
                            CornerRadius="10"
                            
                            Padding="12"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD166" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Grup Türü"
                                       Foreground="#F8FAFC"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="Step1GroupTypeComboBox"
                                      Height="40"
                                      Background="#1E293B"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      Padding="10,5"
                                      SelectionChanged="Step1Selection_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Step1DurationBorder"
                            CornerRadius="10"
                           
                            Padding="12"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD166" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Grup Süresi (Gün)"
                                       Foreground="#F8FAFC"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="Step1DurationComboBox"
                                      Height="40"
                                      Background="#1E293B"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      Padding="10,5"
                                      SelectionChanged="Step1Selection_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="HotelComboHighlightBorder"
                            CornerRadius="10"
                            
                            Padding="12"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD166" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Otel Seçimi"
                                       Foreground="#F8FAFC"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="HotelSelectComboBox"
                                      Height="40"
                                      Background="#1E293B"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      Padding="10,5"
                                      SelectionChanged="HotelSelectComboBox_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="* Ayarlar modülünde eklediğiniz oteller burada listelenir."
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>

                    <Border x:Name="Step1NoMatchPanel"
                            Background="#142033"
                            
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD166" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Aradığınız kriterlerde bir kayıt daha önce yapılmamış. Odalama kaydı açmak için ilerleyin."
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       FontWeight="Bold"/>
                            <Button x:Name="Step1ProceedToCriteriaButton"
                                    Content="İleri"
                                    Margin="0,14,0,0"
                                    Padding="20,10"
                                    Background="#0F172A"
                                    Foreground="#F8FAFC"
                                    
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Click="Step1ProceedToCriteriaButton_Click">
                                <Button.Effect>
                                    <DropShadowEffect Color="#FFD166" BlurRadius="18" ShadowDepth="0" Opacity="0.95"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Border x:Name="SavedAllocationsContainer"
                                Background="#1E293B"
                                CornerRadius="8"
                                Padding="15"
                                BorderBrush="#334155"
                                BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock x:Name="SavedAllocationsTitleLabel"
                                       Text="Eşleşen Oda Yerleşimi"
                                       Foreground="#06B6D4"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Seçtiğiniz 5 kritere ait daha önce yapılmış odalama kaydı burada görünür."
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="#0F172A"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Kayıt Bulma Araçları"
                                           Foreground="#E2E8F0"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <TextBox x:Name="SavedAllocationSearchTextBox"
                                         Height="36"
                                         Background="#1E293B"
                                         Foreground="#F8FAFC"
                                         BorderBrush="#475569"
                                         BorderThickness="1.2"
                                         Padding="10,6"
                                         ToolTip="Ara: otel, tur türü, dönem, grup, oda veya kişi"
                                         TextChanged="SavedAllocationFilter_Changed"/>

                                <UniformGrid Columns="4" Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Tur Türü"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SavedAllocationTourTypeFilterComboBox"
                                                  Height="34"
                                                  SelectionChanged="SavedAllocationFilter_Changed"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Dönem"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SavedAllocationPeriodFilterComboBox"
                                                  Height="34"
                                                  SelectionChanged="SavedAllocationFilter_Changed"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Grup Türü"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SavedAllocationGroupTypeFilterComboBox"
                                                  Height="34"
                                                  SelectionChanged="SavedAllocationFilter_Changed"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Gün Sayısı"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SavedAllocationDaysFilterComboBox"
                                                  Height="34"
                                                  SelectionChanged="SavedAllocationFilter_Changed"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <DataGrid
                                  x:Name="SavedAllocationsGrid"
                                  Background="Transparent"
                                  RowBackground="#0F172A"
                                  AlternatingRowBackground="#1E293B"
                                  Foreground="White"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#334155"/>
                                    <Setter Property="Foreground" Value="#06B6D4"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatchedHighlight}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FFD166"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="#3C3310"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Otel" Binding="{Binding HotelName}" Width="1.3*"/>
                                <DataGridTextColumn Header="Tur Türü" Binding="{Binding TourType}" Width="1*"/>
                                <DataGridTextColumn Header="Dönem" Binding="{Binding Period}" Width="1*"/>
                                <DataGridTextColumn Header="Grup Türü" Binding="{Binding GroupType}" Width="1*"/>
                                <DataGridTextColumn Header="Grup Gün Sayısı" Binding="{Binding DaysCount}" Width="1*"/>
                                <DataGridTextColumn Header="Oda Sayısı" Binding="{Binding RoomCount}" Width="0.8*"/>
                                <DataGridTextColumn Header="Oda Listesi" Binding="{Binding RoomSummary}" Width="1.8*"/>
                                <DataGridTextColumn Header="Kişi Sayısı" Binding="{Binding OccupantCount}" Width="0.8*"/>
                                <DataGridTextColumn Header="Yerleşen Kişiler" Binding="{Binding OccupantNames}" Width="2.4*"/>
                                <DataGridTemplateColumn Header="İşlem" Width="2.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Düzenle"
                                                        Background="#2563EB"
                                                        Foreground="White"
                                                        FontWeight="Bold"
                                                        Padding="8,3"
                                                        BorderThickness="0"
                                                        Margin="0,0,6,0"
                                                        Click="EditSavedAllocationButton_Click"/>
                                                <Button Content="Kaydı Sil"
                                                        Background="#DC2626"
                                                        Foreground="White"
                                                        FontWeight="Bold"
                                                        Padding="8,3"
                                                        BorderThickness="0"
                                                        Click="DeleteSavedAllocationButton_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            </DataGrid>

                            <Border x:Name="NoSavedAllocationResultPanel"
                                    Visibility="Collapsed"
                                    Background="#CC0F172A"
                                    CornerRadius="10"
                                    Padding="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="460">
                                <StackPanel>
                                    <TextBlock Text="Aradığınız kriterlerde kayıt bulunamadı."
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="Yeni bir odalama kaydı oluşturmak isterseniz şimdi otel seçimine geçebilirsiniz."
                                               Foreground="#CBD5E1"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                    <Button Content="Yeni Odalama Kaydı Oluştur"
                                            Margin="0,16,0,0"
                                            Padding="18,8"
                                            Background="#06B6D4"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            Click="GoToNewAllocationFromGridButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                        </Border>

                        <Border x:Name="HotelSelectionGuideOverlay"
                                Background="#801E293B"
                                CornerRadius="8"
                                Visibility="Collapsed">
                        <Border Background="#0F172A"
                                BorderBrush="#06B6D4"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="24"
                                Width="460"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="HotelSelectionGuideTitleText"
                                           Text="Önce otel seçin"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="HotelSelectionGuideDescriptionText"
                                           Text="Otel odalama kaydı yapmanız için önce yukarıdaki otel seçimi kutusundan bir otel seçin."
                                           Foreground="#E2E8F0"
                                           FontSize="16"
                                           Margin="0,8,0,0"
                                           MaxWidth="380"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        </Border>

                    <Border x:Name="Step1PreviewPanel"
                            Background="Transparent"
                            Visibility="Collapsed">
                        <Border Background="#0F172A"
                                BorderBrush="#06B6D4"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="24"
                                Width="520"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step1PreviewTitleText"
                                           Text="Kayıt önizlemesi hazır"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="Step1PreviewDescriptionText"
                                           Text="Kaydınız datagrid içinde gösteriliyor."
                                           Foreground="#E2E8F0"
                                           FontSize="15"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <Button x:Name="CloseStep1PreviewButton"
                                        Content="Önizlemeyi Kapat"
                                        Margin="0,18,0,0"
                                        Padding="18,8"
                                        Background="#06B6D4"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        Click="CloseStep1PreviewButton_Click"/>
                            </StackPanel>
                        </Border>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="Step2Grid"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Border x:Name="CriteriaSelectionPanel"
                            Width="540"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#1E293B"
                            CornerRadius="14"
                            Padding="24"
                            BorderBrush="#334155"
                            BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock Text="🧭 Kriter Seçimi"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Odalama motoruna geçmeden önce seçtiğiniz 5 kriter burada alt alta durur."
                                       Foreground="#94A3B8"
                                       FontSize="13"
                                       Margin="0,8,0,18"
                                       TextAlignment="Center"/>

                            <TextBlock Text="Tur Türü"
                                       Foreground="#94A3B8"
                                       Margin="0,5,0,5"/>

                            <Border 
                                    CornerRadius="10"
                                    Padding="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD166" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                                </Border.Effect>
                                <ComboBox x:Name="TourTypeComboBox"
                                          Height="35"
                                          Background="#1E293B"
                                          Foreground="White"
                                          BorderBrush="#334155"
                                          SelectionChanged="Step2Selection_Changed"/>
                            </Border>

                            <TextBlock Text="Dönem"
                                       Foreground="#94A3B8"
                                       Margin="0,10,0,5"/>

                            <Border 
                                    CornerRadius="10"
                                    Padding="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD166" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                                </Border.Effect>
                                <ComboBox x:Name="PeriodComboBox"
                                          Height="35"
                                          Background="#1E293B"
                                          Foreground="White"
                                          BorderBrush="#334155"
                                          SelectionChanged="Step2Selection_Changed"/>
                            </Border>

                            <TextBlock Text="Grup Türü"
                                       Foreground="#94A3B8"
                                       Margin="0,10,0,5"/>

                            <Border 
                                    CornerRadius="10"
                                    Padding="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD166" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                                </Border.Effect>
                                <ComboBox x:Name="GroupTypeComboBox"
                                          Height="35"
                                          Background="#1E293B"
                                          Foreground="White"
                                          BorderBrush="#334155"
                                          SelectionChanged="Step2Selection_Changed"/>
                            </Border>

                            <TextBlock Text="Grup Süresi (Gün)"
                                       Foreground="#94A3B8"
                                       Margin="0,10,0,5"/>

                            <Border 
                                    CornerRadius="10"
                                    Padding="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD166" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                                </Border.Effect>
                                <ComboBox x:Name="DurationComboBox"
                                          Height="35"
                                          Background="#1E293B"
                                          Foreground="White"
                                          BorderBrush="#334155"
                                          SelectionChanged="Step2Selection_Changed"/>
                            </Border>

                            <TextBlock Text="Otel Seçimi"
                                       Foreground="#94A3B8"
                                       Margin="0,10,0,5"/>

                            <Border 
                                    CornerRadius="10"
                                    Padding="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD166" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                                </Border.Effect>
                                <ComboBox x:Name="Step2HotelComboBox"
                                          Height="35"
                                          Background="#1E293B"
                                          Foreground="White"
                                          BorderBrush="#334155"
                                          SelectionChanged="Step2Selection_Changed"/>
                            </Border>

                            <Button x:Name="ProceedToRoomingButton"
                                    Content="Odalama Motoruna İlerle"
                                    Visibility="Collapsed"
                                    Margin="0,18,0,0"
                                    Padding="18,8"
                                    Background="#0F172A"
                                    Foreground="White"
                                    
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Click="ProceedToRoomingButton_Click">
                                <Button.Effect>
                                    <DropShadowEffect Color="#FFD166" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                                </Button.Effect>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Step2DecisionOverlay"
                            Background="#801E293B"
                            CornerRadius="14"
                            Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>

            <Grid x:Name="Step3Grid" Visibility="Collapsed" PreviewMouseDown="Step3Grid_PreviewMouseDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="3.5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Margin="0,0,10,0" Padding="15"
                        BorderBrush="#334155" BorderThickness="1">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="👥 Odalanacak Yolcu Havuzu"
                                       Foreground="#06B6D4"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="PassengerCountLabel"
                                       Text="Seçilen Kriterlere Uygun: 0 Yolcu Bulundu"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="#142033"
                                BorderBrush="#2D415C"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Nasıl ilerleyeceksiniz?"
                                           Foreground="#F8FAFC"
                                           FontSize="13"
                                           FontWeight="Bold"/>
                                <TextBlock Text="1. Sağ taraftan önce bir oda açın."
                                           Foreground="#CBD5E1"
                                           Margin="0,6,0,0"/>
                                <TextBlock Text="2. Odaya tıklayıp aktif oda olarak seçin."
                                           Foreground="#CBD5E1"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="3. Soldaki yolculardan istediğinizi Odaya Ekle ile yerleştirin."
                                           Foreground="#CBD5E1"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="4. Gerekirse odayı kapatınca yolcular otomatik havuza geri döner."
                                           Foreground="#CBD5E1"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  x:Name="UnallocatedPassengersGrid"
                                  Background="Transparent"
                                  RowBackground="#0F172A"
                                  AlternatingRowBackground="#1E293B"
                                  Foreground="White"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#334155"/>
                                    <Setter Property="Foreground" Value="#06B6D4"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Adı Soyadı" Binding="{Binding FullName}" Width="2*"/>
                                <DataGridTextColumn Header="Talep Edilen Oda" Binding="{Binding RoomType}" Width="1*"/>
                                <DataGridTemplateColumn Header="İşlem" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Odaya Ekle"
                                                    Background="#06B6D4"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    Padding="5,2"
                                                    BorderThickness="0"
                                                    Click="AllocatePassengerButton_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Margin="10,0,0,0"
                        Padding="15" BorderBrush="#334155" BorderThickness="1">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="SelectedHotelTitleLabel"
                                       Text="🏨 Seçilen Otel: Oda Yerleşim Düzeni"
                                       Foreground="#06B6D4"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Yolcuları yerleştirmek için sol taraftan yolcu seçip odaya atayın."
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#0F172A" Padding="10" CornerRadius="6" Margin="0,0,0,15">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Açılacak Oda Türü"
                                               Foreground="#94A3B8"
                                               FontSize="11"
                                               Margin="0,0,0,4"/>

                                    <ComboBox x:Name="NewRoomCapacityComboBox"
                                              Height="28"
                                              Background="#1E293B"
                                              Foreground="White"
                                              BorderBrush="#334155"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="➕ Oda Aç"
                                        Background="#10B981"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Height="28"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Bottom"
                                        BorderThickness="0"
                                        Click="AddRoomButton_Click"/>

                                <Button Grid.Column="2"
                                        Content="🔗 Connection Yap"
                                        Background="#8B5CF6"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Height="28"
                                        VerticalAlignment="Bottom"
                                        BorderThickness="0"
                                        Click="ConnectRoomsButton_Click"/>

                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">

                            <ItemsControl x:Name="RoomsItemsControl">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border Width="210"
                                                Margin="{Binding RoomMargin}"
                                                Background="#0F172A"
                                                BorderBrush="{Binding ConnectionBorderBrush}"
                                                BorderThickness="2"
                                                CornerRadius="8"
                                                Padding="10"
                                                PreviewMouseDown="RoomCard_PreviewMouseDown"
                                                Cursor="Hand">

                                            <Border Background="{Binding SelectionBackground}"
                                                    BorderBrush="{Binding SelectionBorderBrush}"
                                                    BorderThickness="{Binding SelectionBorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="8">

                                            <StackPanel>

                                                <TextBlock Text="{Binding ConnectionGroupText}"
                                                           Foreground="#A855F7"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,4"/>

                                                <Grid>
                                                    <TextBlock Text="{Binding RoomNumberDisplay}"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="12"/>

                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="{Binding StatusColor}"
                                                               FontWeight="Bold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Separator Background="#334155" Margin="0,8"/>

                                                <ListBox ItemsSource="{Binding Occupants}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Height="80">

                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Width="180">
                                                                <TextBlock Text="{Binding FullName}"
                                                                           Foreground="#CBD5E1"
                                                                           FontSize="12"
                                                                           VerticalAlignment="Center"/>

                                                                <Button Content="❌"
                                                                        Background="Transparent"
                                                                        Foreground="#EF4444"
                                                                        BorderThickness="0"
                                                                        HorizontalAlignment="Right"
                                                                        Padding="2,0"
                                                                        Click="RemovePassengerFromRoomButton_Click"
                                                                        Tag="{Binding PersonId}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>

                                                </ListBox>

                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">

                                                    <Button Content="❌ Odayı Kapat" Background="#EF4444" Foreground="White" FontSize="11" FontWeight="SemiBold" 
                                                            Padding="6,2" Height="22" BorderThickness="0" Cursor="Hand" Margin="0,0,5,0"
                                                            Click="CloseRoomButton_Click" Tag="{Binding}"/>

                                                    <Button Content="🔓 Bağlantıyı Kopar" Background="#F59E0B" Foreground="White" FontSize="11" FontWeight="SemiBold" 
                                                            Padding="6,2" Height="22" BorderThickness="0" Cursor="Hand"
                                                            Click="BreakConnectionButton_Click" Tag="{Binding}"
                                                            Visibility="{Binding IsConnection, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

                                                </StackPanel>

                                            </StackPanel>
                                            </Border>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Grid>
                </Border>

            </Grid>

        </Grid>

        <Border Grid.Row="2"
                Background="#1E293B"
                Padding="15"
                CornerRadius="0,0,8,8">

            <Grid>

                <Button x:Name="BackButton"
                        Content="◀ Geri"
                        HorizontalAlignment="Left"
                        Width="100"
                        Height="35"
                        Background="#334155"
                        Foreground="White"
                        BorderThickness="0"
                        Click="BackButton_Click"
                        Visibility="Collapsed"/>

                <Button x:Name="NextButton"
                        Content="İleri ▶"
                        HorizontalAlignment="Right"
                        Width="100"
                        Height="35"
                        Background="#06B6D4"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Visibility="Collapsed"
                        Click="NextButton_Click"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
