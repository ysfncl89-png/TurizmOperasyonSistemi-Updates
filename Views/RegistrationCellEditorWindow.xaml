<Window x:Class="TurizmOperasyonSistemi.Views.RegistrationCellEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kayıt Düzenle" Height="360" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#111827" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Operasyon Talep / Durum Düzenle" Foreground="#06B6D4" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4"/>

        <StackPanel Grid.Row="1" Margin="8" VerticalAlignment="Top">
            <StackPanel x:Name="VisaPanel">
                <TextBlock Text="Vize Talebi" Foreground="#E6FCFF"/>
                <ComboBox x:Name="VisaRequestComboBox" Margin="0,6,0,10"/>

                <TextBlock Text="Pasaportu Geldi mi ?" Foreground="#E6FCFF"/>
                <ComboBox x:Name="PassportArrivedComboBox" Margin="0,6,0,10" DisplayMemberPath="Value"/>

                <TextBlock Text="Vize Durumu" Foreground="#E6FCFF"/>
                <ComboBox x:Name="VisaStatusComboBox" Margin="0,6,0,10"/>
            </StackPanel>

            <StackPanel x:Name="TicketPanel" Visibility="Collapsed">
                <TextBlock Text="Bilet Talebi" Foreground="#E6FCFF"/>
                <ComboBox x:Name="TicketRequestComboBox" Margin="0,6,0,10"/>

                <TextBlock Text="Bilet Durumu" Foreground="#E6FCFF"/>
                <ComboBox x:Name="TicketStatusComboBox" Margin="0,6,0,10"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Content="İptal" Width="100" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Kaydet" Width="120" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>