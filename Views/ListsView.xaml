<Page x:Class="TurizmOperasyonSistemi.Views.ListsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F1724">

    <Page.Resources>

        <!-- Per-option theme colors so button base and hover glow stay consistent -->
        <Color x:Key="TkGenelBaseColor">#8B5CF6</Color>
        <SolidColorBrush x:Key="TkGenelBaseBrush" Color="{StaticResource TkGenelBaseColor}"/>
        <Color x:Key="TkGenelHoverColor">#2F1B7A</Color>

        <Color x:Key="TkVizeBaseColor">#EC4899</Color>
        <SolidColorBrush x:Key="TkVizeBaseBrush" Color="{StaticResource TkVizeBaseColor}"/>
        <Color x:Key="TkVizeHoverColor">#7A1238</Color>

        <Color x:Key="TkBiletBaseColor">#3B82F6</Color>
        <SolidColorBrush x:Key="TkBiletBaseBrush" Color="{StaticResource TkBiletBaseColor}"/>
        <Color x:Key="TkBiletHoverColor">#1E40AF</Color>

        <Color x:Key="TkAktarmaBaseColor">#10B981</Color>
        <SolidColorBrush x:Key="TkAktarmaBaseBrush" Color="{StaticResource TkAktarmaBaseColor}"/>
        <Color x:Key="TkAktarmaHoverColor">#0A5E40</Color>

        <Color x:Key="TkHavayoluBaseColor">#F59E0B</Color>
        <SolidColorBrush x:Key="TkHavayoluBaseBrush" Color="{StaticResource TkHavayoluBaseColor}"/>
        <Color x:Key="TkHavayoluHoverColor">#7A4E00</Color>

        <Color x:Key="TkReferansBaseColor">#EF4444</Color>
        <SolidColorBrush x:Key="TkReferansBaseBrush" Color="{StaticResource TkReferansBaseColor}"/>
        <Color x:Key="TkReferansHoverColor">#7A0B0B</Color>

        <Color x:Key="TkPasaportBaseColor">#06B6D4</Color>
        <SolidColorBrush x:Key="TkPasaportBaseBrush" Color="{StaticResource TkPasaportBaseColor}"/>
        <Color x:Key="TkPasaportHoverColor">#03636f</Color>


        <!-- Card background brushes so we can animate color on hover -->
        <SolidColorBrush x:Key="CardBg1" Color="#0B1220" />
        <!-- kept for compatibility with existing references -->
        <SolidColorBrush x:Key="CardBgBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="CardBg2" Color="#0B1220" />
        <SolidColorBrush x:Key="CardBg3" Color="#0B1220" />
        <SolidColorBrush x:Key="CardBg4" Color="#0B1220" />
        <SolidColorBrush x:Key="CardBg5" Color="#0B1220" />

        <!-- hover target colors (subtle neon tint) -->
        <Color x:Key="HoverColor1">#112033</Color>
        <Color x:Key="HoverColor2">#331122</Color>
        <Color x:Key="HoverColor3">#112033</Color>
        <Color x:Key="HoverColor4">#112033</Color>
        <Color x:Key="HoverColor5">#112033</Color>


        <!-- Center white button style -->
        <Style x:Key="CenterButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Option small circular button -->
        <Style x:Key="OptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="ell" Fill="{TemplateBinding Background}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{Binding Fill.Color, RelativeSource={RelativeSource Self}}" BlurRadius="0" ShadowDepth="0" Opacity="0" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Panel.ZIndex" Value="200"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="ell" Storyboard.TargetProperty="Effect.(DropShadowEffect.BlurRadius)" To="20" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ell" Storyboard.TargetProperty="Effect.(DropShadowEffect.Opacity)" To="0.9" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ell" Storyboard.TargetProperty="Effect.(DropShadowEffect.BlurRadius)" To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ell" Storyboard.TargetProperty="Effect.(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Panel.ZIndex" Value="1"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">

            <TextBlock Text="LİSTELER MODÜLÜ"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10"/>

            <TextBlock Foreground="#E6FCFF"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center">
                                    <Run Text="NE TÜR BİR LİSTE ÜRETMEK İSTİYORSUNUZ?  "/>
                                    <Run Text="KARTLARIN ÜZERİNE GİDEREK" />
                                    <Run Text="LİSTE TÜRÜNÜ SEÇİN." Foreground="#F59E0B" FontWeight="Bold" />
                                    
                <TextBlock.Effect>
                    <DropShadowEffect Color="#38BDF8" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/>
                </TextBlock.Effect>
            </TextBlock>

            <UniformGrid Columns="3" HorizontalAlignment="Stretch" VerticalAlignment="Top">

                <!-- Kişisel Bilgiler Card (3 options) -->
                <Border x:Name="border1" MinWidth="280" MaxWidth="420" Height="260" CornerRadius="18" Background="{StaticResource CardBg1}" Margin="18" Padding="18" ClipToBounds="False" MouseEnter="Border_MouseEnter" MouseLeave="Border_MouseLeave">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="border1" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#112033" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="kb_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.75" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="kb_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="28" Duration="0:0:0.18" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="border1" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="kb_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="kb_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="0" Duration="0:0:0.12" />
                                    <!-- restore center icon -->
                                    <DoubleAnimation Storyboard.TargetName="kb_center" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid x:Name="card1">

                        <!-- Title -->
                        <TextBlock Text="Kişisel Bilgiler" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>

                        <!-- Option buttons -->
                        <Button x:Name="kb_opt1" Style="{StaticResource OptionButtonStyle}" Background="#8B5CF6" Opacity="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" ToolTip="Telefon">
                            <Button.Content>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="📞" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="kb_label1" Text="Telefon" FontSize="14" FontWeight="Bold" Opacity="0" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="kb_t1" />
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border1" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource TkGenelHoverColor}" Duration="0:0:0.12" />
                                            <ColorAnimation Storyboard.TargetName="kb_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" To="{StaticResource TkGenelHoverColor}" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="kb_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.2" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border1" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="kb_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.75" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button x:Name="kb_opt2" Style="{StaticResource OptionButtonStyle}" Background="#EC4899" Opacity="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" ToolTip="Sağlık">
                            <Button.Content>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="🩺" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="kb_label2" Text="Sağlık" FontSize="14" FontWeight="Bold" Opacity="0" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="kb_t2" />
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border1" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#7A1238" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="kb_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.2" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border1" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="kb_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.75" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- Pasaport moved to Tur Kayıtları -->

                        <!-- Center main button -->
                        <Button x:Name="kb_center" Style="{StaticResource CenterButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2">
                            <Button.Content>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.Effect>
                                <DropShadowEffect Color="#7EE3FD" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Button.Effect>
                        </Button>



                    </Grid>
                </Border>

                <!-- Tur Kayıtları Card (6 options) -->
                <Border x:Name="border2" MinWidth="280" MaxWidth="420" Height="260" CornerRadius="18" Background="{StaticResource CardBg2}" Margin="18" Padding="18" ClipToBounds="False" MouseEnter="Border_MouseEnter" MouseLeave="Border_MouseLeave">
                    <Grid x:Name="card2">
                        <TextBlock Text="Tur Kayıtları" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>

                        <!-- 7 option buttons arranged in target clockwise order starting at 12 o'clock -->
                        <Button x:Name="tk_o1" Style="{StaticResource OptionButtonStyle}" Background="{StaticResource TkGenelBaseBrush}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" ToolTip="Genel">
                            <Button.Content>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="tk_label1" Text="Genel" FontSize="14" FontWeight="Bold" Opacity="0" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="tk_t1" />
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource TkGenelHoverColor}" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button x:Name="tk_o3" Style="{StaticResource OptionButtonStyle}" Background="{StaticResource TkBiletBaseBrush}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" ToolTip="Bilet">
                            <Button.Content>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="🎫" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="tk_label3" Text="Bilet" FontSize="14" FontWeight="Bold" Opacity="0" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="tk_t3" />
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource TkBiletHoverColor}" Duration="0:0:0.12" />

                                            <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.15" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.12" />
                                    <!-- restore center icon -->
                                    <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button x:Name="tk_o4" Style="{StaticResource OptionButtonStyle}" Background="{StaticResource TkAktarmaBaseBrush}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" ToolTip="Aktarma">
                            <Button.Content>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="🔁" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="tk_label4" Text="Aktarma" FontSize="14" FontWeight="Bold" Opacity="0" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="tk_t4" />
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource TkAktarmaHoverColor}" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.15" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button x:Name="tk_o5" Style="{StaticResource OptionButtonStyle}" Background="{StaticResource TkHavayoluBaseBrush}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" ToolTip="Havayolu">
                            <Button.Content>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="✈️" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="tk_label5" Text="Havayolu" FontSize="14" FontWeight="Bold" Opacity="0" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="tk_t5" />
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource TkHavayoluHoverColor}" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.15" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button x:Name="tk_o6" Style="{StaticResource OptionButtonStyle}" Background="{StaticResource TkReferansBaseBrush}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" ToolTip="Referans">
                            <Button.Content>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="🔖" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="tk_label6" Text="Referans" FontSize="14" FontWeight="Bold" Opacity="0" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="tk_t6" />
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource TkReferansHoverColor}" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.15" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button x:Name="tk_o7" Style="{StaticResource OptionButtonStyle}" Background="{StaticResource TkPasaportBaseBrush}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" ToolTip="Pasaport">
                            <Button.Content>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="🛂" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="tk_label7" Text="Pasaport" FontSize="14" FontWeight="Bold" Opacity="0" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="tk_t7" />
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource TkPasaportHoverColor}" Duration="0:0:0.12" />
                                            <ColorAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" To="{StaticResource TkPasaportHoverColor}" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.15" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button x:Name="tk_o2" Style="{StaticResource OptionButtonStyle}" Background="#EC4899" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" ToolTip="Vize">
                            <Button.Content>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="🛂" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="tk_label2" Text="Vize" FontSize="14" FontWeight="Bold" Opacity="0" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="tk_t2" />
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#7A1238" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.15" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border2" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="tk_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button x:Name="tk_center" Style="{StaticResource CenterButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2">
                            <Button.Content>
                                <TextBlock Text="🧭" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button.Content>
                            <Button.Effect>
                                <DropShadowEffect Color="#4ADE80" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Button.Effect>
                        </Button>



                    </Grid>
                </Border>

                <!-- Oda Listesi Card (simple icon card) -->
                <Border x:Name="border3" MinWidth="280" MaxWidth="420" Height="260" CornerRadius="18" Background="{StaticResource CardBg3}" Margin="18" Padding="18" ClipToBounds="True">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="border3" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#112033" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="oo_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.75" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="oo_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="28" Duration="0:0:0.18" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="border3" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="oo_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="oo_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="0" Duration="0:0:0.12" />
                                    <!-- restore center icon visibility -->
                                    <DoubleAnimation Storyboard.TargetName="oo_center" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid x:Name="card3">
                        <TextBlock Text="Oda Listesi" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>

                        <!-- small option button -->
                        <Button x:Name="oo_opt1" Style="{StaticResource OptionButtonStyle}" Background="{StaticResource TkGenelBaseBrush}" Opacity="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10" ToolTip="Oda">
                            <Button.Content>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="🏨" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="oo_label1" Text="Oda" FontSize="14" FontWeight="Bold" Opacity="0" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="oo_t1" />
                            </Button.RenderTransform>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border3" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource TkGenelHoverColor}" Duration="0:0:0.12" />
                                            <ColorAnimation Storyboard.TargetName="oo_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)" To="{StaticResource TkGenelHoverColor}" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="oo_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.2" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border3" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0B1220" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="oo_center" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.75" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button x:Name="oo_center" Style="{StaticResource CenterButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2" ToolTip="Otel Odalama">
                            <Button.Content>
                                <TextBlock Text="🛏️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button.Content>
                            <Button.Effect>
                                <DropShadowEffect Color="#7EE3FD" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Button.Effect>
                        </Button>

                        <TextBlock Text="Otel odaları ve yerleştirme işlemleri" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                    </Grid>
                </Border>

                <!-- Ödeme Card (simple icon card) -->
                <Border x:Name="border4" MinWidth="280" MaxWidth="420" Height="260" CornerRadius="18" Background="{StaticResource CardBg4}" Margin="18" Padding="18" ClipToBounds="True">
                    <Grid x:Name="card4">
                        <TextBlock Text="Ödeme" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>

                        <Button x:Name="od_center" Style="{StaticResource CenterButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2" ToolTip="Ödeme">
                            <Button.Content>
                                <TextBlock Text="💳" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button.Content>
                        </Button>

                        <TextBlock Text="Ödeme yöntemleri ve kayıtları" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                    </Grid>
                </Border>

                <!-- Kargo Card (simple icon card) -->
                <Border x:Name="border5" MinWidth="280" MaxWidth="420" Height="260" CornerRadius="18" Background="{StaticResource CardBg5}" Margin="18" Padding="18" ClipToBounds="True">
                    <Grid x:Name="card5">
                        <TextBlock Text="Kargo" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>

                        <Button x:Name="kg_center" Style="{StaticResource CenterButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2" ToolTip="Kargo">
                            <Button.Content>
                                <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button.Content>
                        </Button>

                        <TextBlock Text="Kargo gönderimleri ve takip" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                    </Grid>
                </Border>

            </UniformGrid>

        </StackPanel>
    </ScrollViewer>

</Page>
