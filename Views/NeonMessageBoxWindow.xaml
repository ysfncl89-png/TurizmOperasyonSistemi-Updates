<Window x:Class="TurizmOperasyonSistemi.Views.NeonMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeonMessageBox" Height="200" Width="460" WindowStyle="None" ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True">
    <Border Background="#0F172A" CornerRadius="12" Padding="18" BorderThickness="1" BorderBrush="#22324A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Foreground="#E2E8F0" FontSize="16" FontWeight="Bold" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
                <TextBlock x:Name="MessageText" Foreground="#CBD5E1" TextWrapping="Wrap" FontSize="13"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSecondary" Content="İptal" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button x:Name="BtnPrimary" Content="Tamam" MinWidth="100"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>