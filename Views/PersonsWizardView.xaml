<Page x:Class="TurizmOperasyonSistemi.Views.PersonsWizardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PersonsWizardView"
      Background="#111827">

    <Page.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="CaretBrush" Value="#22D3EE"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#243244"/>
                    <Setter Property="Foreground" Value="#E2E8F0"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#22D3EE"/>
                </Trigger>
                <Trigger Property="Tag" Value="RequiredError">
                    <Setter Property="BorderBrush" Value="#FF4D6D"/>
                    <Setter Property="BorderThickness" Value="2.4"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF4D6D"
                                              BlurRadius="18"
                                              ShadowDepth="0"
                                              Opacity="0.95"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="#E2E8F0"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="12,0,8,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="#0F172A"/>

                                    <Border Grid.Column="1"
                                            Background="#31527B"
                                            CornerRadius="0,10,10,0">
                                        <TextBlock Text="▼"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Grid.ColumnSpan="2"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Panel.ZIndex="10"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,4,0,0"
                                        Background="#1E293B"
                                        BorderBrush="#475569"
                                        BorderThickness="1.4"
                                        CornerRadius="10">
                                    <ScrollViewer MaxHeight="260">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#22D3EE"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="RequiredError">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FF4D6D"/>
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="2.4"/>
                                <Setter TargetName="ComboBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF4D6D"
                                                          BlurRadius="18"
                                                          ShadowDepth="0"
                                                          Opacity="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ComboBox_PreviewMouseLeftButtonDown"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#0F766E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#06B6D4"/>
                    <Setter Property="Foreground" Value="#04111D"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>

        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- Daha küçük padding ile tarih metninin kutuya sığmasını sağla -->
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#162033"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="#162033"/>
            <Setter Property="AlternatingRowBackground" Value="#1D2A40"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#22324A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#162033"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#243244"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#22D3EE"/>
                    <Setter Property="Foreground" Value="#04111D"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Foreground" Value="#A8B2C3"/>
                    <Setter Property="Background" Value="#2B3444"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,25">
                <Border x:Name="Step1Border"
                        Width="150"
                        Height="50"
                        CornerRadius="12"
                        Background="#06B6D4"
                        Margin="0,0,10,0">
                    <TextBlock Text="1 • Kimlik"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>

                <Border x:Name="Step2Border"
                        Width="150"
                        Height="50"
                        CornerRadius="12"
                        Background="#1F2937"
                        Margin="0,0,10,0">
                    <TextBlock Text="2 • Telefon"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>

                <Border x:Name="Step3Border"
                        Width="150"
                        Height="50"
                        CornerRadius="12"
                        Background="#1F2937"
                        Margin="0,0,10,0">
                    <TextBlock Text="3 • Sağlık"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>

                <Border x:Name="Step4Border"
                        Width="150"
                        Height="50"
                        CornerRadius="12"
                        Background="#1F2937"
                        Margin="0,0,10,0">
                    <TextBlock Text="4 • Pasaport"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>

                <Border x:Name="Step5Border"
                        Width="150"
                        Height="50"
                        CornerRadius="12"
                        Background="#1F2937">
                    <TextBlock Text="5 • Önizleme"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#1F2937"
                    CornerRadius="20"
                    Padding="25">

                <Grid>
                    <Grid x:Name="Step1Grid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Veritabanında kişi kaydını bulmak için önce arama yapın."
                                       Foreground="#22D3EE"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Ad, soyad, ad soyad ya da TC kimlik ile arama yapabilirsiniz."
                                       Foreground="#CBD5E1"
                                       FontSize="13"
                                       Margin="0,6,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="SearchTextBox"
                                         Grid.Column="0"
                                         Height="40"
                                         TextChanged="SearchTextBox_TextChanged"
                                         BorderBrush="#22D3EE"
                                         BorderThickness="2"
                                         Padding="12,7"
                                         Background="#0F172A"
                                         Foreground="#E2F9FF">
                                    <TextBox.Effect>
                                        <DropShadowEffect Color="#22D3EE" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                                    </TextBox.Effect>
                                </TextBox>

                                <Border x:Name="SearchStateBorder"
                                        Grid.Column="1"
                                        Margin="14,0,14,0"
                                        Padding="14,10"
                                        Background="#102033"
                                        CornerRadius="12"
                                        BorderBrush="#284B63"
                                        BorderThickness="1">
                                    <TextBlock x:Name="SearchStateTextBlock"
                                               Foreground="#D9F99D"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Button x:Name="EditSelectedButton"
                                        Grid.Column="2"
                                        Content="Düzenle"
                                        Height="40"
                                        Width="115"
                                        Background="#2563EB"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Visibility="Collapsed"
                                        Margin="0,0,10,0"
                                        Click="EditSelectedButton_Click"/>
                                <Button x:Name="DeleteSelectedButton"
                                        Grid.Column="3"
                                        Content="Sil"
                                        Height="40"
                                        Width="115"
                                        Background="#DC2626"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Visibility="Collapsed"
                                        Click="DeleteSelectedButton_Click"/>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Margin="0,22,0,22">
                            <Border x:Name="ResultsPanel"
                                    Background="#152234"
                                    CornerRadius="18"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Kişi Sonuçları"
                                               Foreground="#22D3EE"
                                               FontSize="20"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Kayıt bulunduysa kişiyi seçin. Aktif pasif durumunu burada yönetebilir veya düzenlemeye geçebilirsiniz."
                                               Foreground="#CBD5E1"
                                               FontSize="12"
                                               Margin="0,5,0,12"
                                               TextWrapping="Wrap"/>

                                    <DataGrid x:Name="PersonsDataGrid"
                                              AutoGenerateColumns="False"
                                              Height="320"
                                              RowHeight="38"
                                              SelectionMode="Single"
                                              SelectionChanged="PersonsDataGrid_SelectionChanged"
                                              ColumnHeaderHeight="44"
                                              HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Resources>
                                            <Style x:Key="LocalHeaderStyle" TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#16394A"/>
                                                <Setter Property="Foreground" Value="#E6F9FF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="12,8"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Setter Property="BorderBrush" Value="#20333F"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,2"/>
                                            </Style>
                                            <Style x:Key="LocalCellStyle" TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="10,6"/>
                                                <Setter Property="Foreground" Value="#E6F7FF"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="BorderBrush" Value="#20333F"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.ColumnHeaderStyle>
                                            <StaticResource ResourceKey="LocalHeaderStyle"/>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.CellStyle>
                                            <StaticResource ResourceKey="LocalCellStyle"/>
                                        </DataGrid.CellStyle>
                                        <DataGrid.GridLinesVisibility>Vertical</DataGrid.GridLinesVisibility>

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Visibility="Collapsed"/>
                                            <DataGridTextColumn Header="Ad" Binding="{Binding FirstName}" Width="150"/>
                                            <DataGridTextColumn Header="Soyad" Binding="{Binding LastName}" Width="150"/>
                                            <DataGridTextColumn Header="Uyruk" Binding="{Binding Nationality}" Width="120"/>
                                            <DataGridTextColumn Header="TC Kimlik No" Binding="{Binding TcKimlikNo}" Width="150"/>
                                            <DataGridTextColumn Header="Cinsiyet" Binding="{Binding Gender}" Width="90" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Doğum Tarihi" Binding="{Binding BirthDate, StringFormat=d}" Width="120"/>
                                            <DataGridTextColumn Header="Yaş Aralığı" Binding="{Binding AgeRange}" Width="100"/>
                                            <DataGridTextColumn Header="Telefon" Binding="{Binding PhoneNumber}" Width="120"/>
                                            <DataGridTextColumn Header="Adres" Binding="{Binding Address}" Width="220"/>
                                            <DataGridTextColumn Header="Pasaport Türü" Binding="{Binding PassportType}" Width="120"/>
                                            <DataGridTextColumn Header="Pasaport No" Binding="{Binding PassportNumber}" Width="120"/>
                                            <DataGridTextColumn Header="Pasaport Başlangıç" Binding="{Binding PassportStartDate, StringFormat=d}" Width="130"/>
                                            <DataGridTextColumn Header="Pasaport Bitiş" Binding="{Binding PassportEndDate, StringFormat=d}" Width="130"/>
                                            <DataGridTextColumn Header="Kan Grubu" Binding="{Binding BloodType}" Width="90"/>
                                            <DataGridTextColumn Header="Hastalık Durumu" Binding="{Binding HealthStatus}" Width="150"/>
                                            <DataGridTextColumn Header="Aşı Durumu" Binding="{Binding VaccineStatus}" Width="130"/>
                                            <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ResultsOverlay"
                                    Background="#CC0F172A"
                                    CornerRadius="18">
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            MaxWidth="520"
                                            Margin="30">
                                    <TextBlock x:Name="ResultsOverlayTitle"
                                               Text="Önce arama yapın"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>
                                    <TextBlock x:Name="ResultsOverlayText"
                                               Text="Aramayı yukarıdaki kutudan başlatın. Kayıt bulunduğunda sonuç listesi burada açılacak."
                                               Foreground="#E2E8F0"
                                               FontSize="14"
                                               Margin="0,12,0,0"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               LineHeight="22"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Border x:Name="FormPanel"
                                    Background="#152234"
                                    CornerRadius="18"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Kişi Kayıt Formu"
                                               Foreground="#22D3EE"
                                               FontSize="20"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="FormCaptionTextBlock"
                                               Text="Yeni kişi kaydı oluşturmak ya da seçili kişiyi güncellemek için bu alanı kullanın."
                                               Foreground="#CBD5E1"
                                               FontSize="12"
                                               Margin="0,5,0,15"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="NoPersonNoticeTextBlock"
                                               Text=""
                                               Foreground="#FBBF24"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Margin="0,0,0,8"
                                               Visibility="Collapsed"/>

                                    <TextBlock Text="Ad"
                                               Foreground="#F8FAFC"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                    <TextBox x:Name="FirstNameTextBox"
                                             Height="36"
                                             TextChanged="RequiredField_TextChanged"/>

                                    <TextBlock Text="Soyad"
                                               Foreground="#F8FAFC"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                    <TextBox x:Name="LastNameTextBox"
                                             Height="36"
                                             TextChanged="RequiredField_TextChanged"/>
                                    <TextBlock Text="Uyruk"
                                               Foreground="#F8FAFC"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                    <ItemsControl x:Name="NationalityOptionsPanel">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <!-- Backwards-compatibility hidden combo (some code still expects NationalityComboBox) -->
                                    <ComboBox x:Name="NationalityComboBox" Visibility="Collapsed"/>

                                    <TextBlock x:Name="TcLabel" Text="TC Kimlik No"
                                               Foreground="#F8FAFC"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                    <TextBox x:Name="TcTextBox"
                                             Height="36"
                                             TextChanged="RequiredField_TextChanged"/>

                                    <TextBlock Text="Cinsiyet"
                                               Foreground="#F8FAFC"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                    <ComboBox x:Name="GenderComboBox"
                                              Height="36"
                                              SelectionChanged="GenderComboBox_SelectionChanged"/>

                                    <TextBlock Text="Doğum Tarihi"
                                               Foreground="#F8FAFC"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                    <DatePicker x:Name="BirthDatePicker"
                                                Height="36"
                                                SelectedDateChanged="BirthDatePicker_SelectedDateChanged"
                                                SelectedDateFormat="Short"/>

                                    <TextBlock Text="Yaş"
                                               Foreground="#F8FAFC"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                    <TextBox x:Name="AgeTextBox"
                                             Height="36"
                                             IsReadOnly="True"/>

                                    <TextBlock Text="Yaş Aralığı"
                                               Foreground="#F8FAFC"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                    <ComboBox x:Name="AgeRangeComboBox"
                                              Height="36"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="FormOverlay"
                                    Background="#CC0F172A"
                                    CornerRadius="18">
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            MaxWidth="560"
                                            Margin="30">
                                    <TextBlock x:Name="FormOverlayTitle"
                                               Text="Arama sonucunu bekliyoruz"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>
                                    <TextBlock x:Name="FormOverlayText"
                                               Text="Kayıt bulunduysa listeden kişiyi seçip Düzenle ile devam edebilirsiniz. Kayıt yoksa arama sonucuna göre bu form açılacaktır."
                                               Foreground="#E2E8F0"
                                               FontSize="14"
                                               Margin="0,12,0,0"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               LineHeight="22"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="Step2Grid" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Telefon"
                                       Foreground="#F8FAFC"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <TextBox x:Name="PhoneTextBox"
                                     Height="36"/>

                            <TextBlock Text="Adres"
                                       Foreground="#F8FAFC"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <TextBox x:Name="AddressTextBox"
                                     Height="120"
                                     FontSize="13"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="Step3Grid" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Kan Grubu"
                                       Foreground="#F8FAFC"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <ComboBox x:Name="BloodComboBox"
                                      Height="36"/>

                            <TextBlock Text="Hastalık Durumu"
                                       Foreground="#F8FAFC"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <TextBox x:Name="HealthTextBox"
                                     Height="36"/>

                            <TextBlock Text="Aşı Durumu"
                                       Foreground="#F8FAFC"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <TextBox x:Name="VaccineTextBox"
                                     Height="36"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="Step4Grid" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Pasaport Türü"
                                       Foreground="#F8FAFC"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <ComboBox x:Name="PassportTypeComboBox"
                                      Height="36"/>

                            <TextBlock Text="Pasaport No"
                                       Foreground="#F8FAFC"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <TextBox x:Name="PassportTextBox"
                                     Height="36"/>

                            <TextBlock Text="Pasaport Başlangıç"
                                       Foreground="#F8FAFC"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <DatePicker x:Name="PassportStartPicker"
                                        Height="36"
                                        SelectedDateFormat="Short"/>

                            <TextBlock Text="Pasaport Bitiş"
                                       Foreground="#F8FAFC"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <DatePicker x:Name="PassportEndPicker"
                                        Height="36"
                                        SelectedDateFormat="Short"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="Step5Grid" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Kayıt Önizleme"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Margin="0,0,0,20"/>

                            <Border Background="#111827"
                                    CornerRadius="15"
                                    Padding="20"
                                    MinHeight="300">
                                <TextBlock x:Name="PreviewTextBlock"
                                           Foreground="White"
                                           FontSize="15"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Button x:Name="SaveButton"
                                    Content="Kaydet"
                                    Height="45"
                                    Margin="0,25,0,0"
                                    Background="#10B981"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Click="SaveButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Content="Geri"
                        Height="45"
                        Margin="0,10,10,0"
                        Background="#374151"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BackButton_Click"/>

                <Button x:Name="NextButton"
                        Grid.Column="1"
                        Content="İleri"
                        Height="45"
                        Margin="10,10,0,0"
                        Background="#06B6D4"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="NextButton_Click"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
