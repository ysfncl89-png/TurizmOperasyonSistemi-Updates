<Page x:Class="TurizmOperasyonSistemi.Views.PersonsWizardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PersonsWizardView"
      Background="#111827">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="25">

            <!-- ✅ FIX: Auto layout (650 kaldırıldı) -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="350"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,25">

                <Border x:Name="Step1Border"
                        Width="150"
                        Height="50"
                        CornerRadius="12"
                        Background="#06B6D4"
                        Margin="0,0,10,0">
                    <TextBlock Text="1 • Kimlik"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>

                <Border x:Name="Step2Border"
                        Width="150"
                        Height="50"
                        CornerRadius="12"
                        Background="#1F2937"
                        Margin="0,0,10,0">
                    <TextBlock Text="2 • İletişim"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>

                <Border x:Name="Step3Border"
                        Width="150"
                        Height="50"
                        CornerRadius="12"
                        Background="#1F2937"
                        Margin="0,0,10,0">
                    <TextBlock Text="3 • Sağlık"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>

                <Border x:Name="Step4Border"
                        Width="150"
                        Height="50"
                        CornerRadius="12"
                        Background="#1F2937"
                        Margin="0,0,10,0">
                    <TextBlock Text="4 • Pasaport"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>

                <Border x:Name="Step5Border"
                        Width="150"
                        Height="50"
                        CornerRadius="12"
                        Background="#1F2937">
                    <TextBlock Text="5 • Önizleme"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>

            </StackPanel>

            <!-- CONTENT -->
            <Border Grid.Row="1"
                    Background="#1F2937"
                    CornerRadius="20"
                    Padding="25">

                <Grid>

                    <!-- STEP 1 -->
                    <Grid x:Name="Step1Grid">
                        <StackPanel>
                            <TextBlock Text="Ad" Foreground="White"/>
                            <TextBox x:Name="FirstNameTextBox" Height="35" Margin="0,5,0,15"/>

                            <TextBlock Text="Soyad" Foreground="White"/>
                            <TextBox x:Name="LastNameTextBox" Height="35" Margin="0,5,0,15"/>

                            <TextBlock Text="TC Kimlik No" Foreground="White"/>
                            <TextBox x:Name="TcTextBox" Height="35" Margin="0,5,0,15"/>

                            <TextBlock Text="Cinsiyet" Foreground="White"/>
                            <ComboBox x:Name="GenderComboBox" Height="35" Margin="0,5,0,15"/>

                            <TextBlock Text="Doğum Tarihi" Foreground="White"/>
                            <DatePicker x:Name="BirthDatePicker"
                                        Height="35"
                                        Margin="0,5,0,15"
                                        SelectedDateChanged="BirthDatePicker_SelectedDateChanged"/>

                            <TextBlock Text="Yaş" Foreground="White"/>
                            <TextBox x:Name="AgeTextBox"
                                     Height="35"
                                     IsReadOnly="True"
                                     Margin="0,5,0,15"/>

                            <TextBlock Text="Yaş Aralığı" Foreground="White"/>
                            <ComboBox x:Name="AgeRangeComboBox"
                                      Height="35"
                                      Margin="0,5,0,15"/>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 2 -->
                    <Grid x:Name="Step2Grid" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Telefon" Foreground="White"/>
                            <TextBox x:Name="PhoneTextBox" Height="35" Margin="0,5,0,15"/>

                            <TextBlock Text="Adres" Foreground="White"/>
                            <TextBox x:Name="AddressTextBox"
                                     Height="120"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Margin="0,5,0,15"/>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 3 -->
                    <Grid x:Name="Step3Grid" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Kan Grubu" Foreground="White"/>
                            <ComboBox x:Name="BloodComboBox" Height="35" Margin="0,5,0,15"/>

                            <TextBlock Text="Hastalık Durumu" Foreground="White"/>
                            <TextBox x:Name="HealthTextBox" Height="35" Margin="0,5,0,15"/>

                            <TextBlock Text="Aşı Durumu" Foreground="White"/>
                            <TextBox x:Name="VaccineTextBox" Height="35" Margin="0,5,0,15"/>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 4 -->
                    <Grid x:Name="Step4Grid" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Pasaport Türü" Foreground="White"/>
                            <ComboBox x:Name="PassportTypeComboBox" Height="35" Margin="0,5,0,15"/>

                            <TextBlock Text="Pasaport No" Foreground="White"/>
                            <TextBox x:Name="PassportTextBox" Height="35" Margin="0,5,0,15"/>

                            <TextBlock Text="Pasaport Başlangıç" Foreground="White"/>
                            <DatePicker x:Name="PassportStartPicker" Height="35" Margin="0,5,0,15"/>

                            <TextBlock Text="Pasaport Bitiş" Foreground="White"/>
                            <DatePicker x:Name="PassportEndPicker" Height="35" Margin="0,5,0,15"/>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 5 -->
                    <Grid x:Name="Step5Grid" Visibility="Collapsed">
                        <StackPanel>

                            <TextBlock Text="Kayıt Önizleme"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Margin="0,0,0,20"/>

                            <Border Background="#111827"
        CornerRadius="15"
        Padding="20"
        MinHeight="300">

                                <TextBlock x:Name="PreviewTextBlock"
                                           Foreground="White"
                                           FontSize="15"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Button x:Name="SaveButton"
                                    Content="Kaydet"
                                    Height="45"
                                    Margin="0,25,0,0"
                                    Background="#10B981"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Click="SaveButton_Click"/>
                        </StackPanel>
                    </Grid>

                </Grid>

            </Border>

            <!-- FOOTER -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Content="Geri"
                        Height="45"
                        Margin="0,10,10,0"
                        Background="#374151"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BackButton_Click"/>

                <Button x:Name="NextButton"
                        Grid.Column="1"
                        Content="İleri"
                        Height="45"
                        Margin="10,10,0,0"
                        Background="#06B6D4"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="NextButton_Click"/>
            </Grid>

            <!-- DATA GRID -->
            <DataGrid x:Name="PersonsDataGrid"
                      Grid.Row="3"
                      Margin="0,30,0,0"
                      AutoGenerateColumns="True"
                      Height="340"
                      Background="#1F2937"
                      Foreground="White"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowBackground="#1F2937"
                      AlternatingRowBackground="#111827"
                      SelectionChanged="PersonsDataGrid_SelectionChanged"/>

        </Grid>

    </ScrollViewer>

</Page>