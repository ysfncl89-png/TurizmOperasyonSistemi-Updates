<Window x:Class="TurizmOperasyonSistemi.Views.CargoInspectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kargo İncele" Height="360" Width="520" WindowStartupLocation="CenterOwner" Background="#0B1220">

    <Grid Margin="14">
        <Border CornerRadius="10" Background="#0F172A" Padding="12" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Kargo İncele" FontSize="18" FontWeight="SemiBold" Foreground="#E2F8FF" Margin="4" />

                <UniformGrid Columns="2" Margin="4" HorizontalAlignment="Stretch">
                    <StackPanel Margin="6">
                        <TextBlock Text="Ad" Foreground="#9FB2CB" Margin="2"/>
                        <TextBox x:Name="TbFirstName" Height="32" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="Soyad" Foreground="#9FB2CB" Margin="2"/>
                        <TextBox x:Name="TbLastName" Height="32" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" />
                    </StackPanel>

                    <StackPanel Margin="6">
                        <TextBlock Text="TC Kimlik No" Foreground="#9FB2CB" Margin="2"/>
                        <TextBox x:Name="TbTc" Height="32" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Text="Telefon" Foreground="#9FB2CB" Margin="2"/>
                        <TextBox x:Name="TbPhone" Height="32" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" />
                    </StackPanel>

                    <StackPanel Grid.ColumnSpan="2" Margin="6">
                        <TextBlock Text="Adres" Foreground="#9FB2CB" Margin="2"/>
                        <TextBox x:Name="TbAddress" Height="64" AcceptsReturn="True" TextWrapping="Wrap" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" />
                    </StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
                    <Button x:Name="BtnCancel" Content="Vazgeç" Width="100" Height="36" Margin="6" Click="BtnCancel_Click" Background="#123046" Foreground="White"/>
                    <Button x:Name="BtnConfirm" Content="Onayla" Width="120" Height="36" Margin="6" Click="BtnConfirm_Click" Background="#059669" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
