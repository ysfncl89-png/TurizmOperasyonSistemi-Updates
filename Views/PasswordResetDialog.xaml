<Window x:Class="TurizmOperasyonSistemi.Views.PasswordResetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parola Sıfırlama" Height="260" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Sıfırlanacak admin kullanıcı adını girin:" FontWeight="Bold"/>
        <TextBox x:Name="UsernameTextBox" Grid.Row="1" Height="34" FontSize="14" Margin="0,6,0,12"/>

        <TextBlock Text="Yeni Şifre" Grid.Row="2"/>
        <PasswordBox x:Name="NewPasswordBox" Grid.Row="2" Margin="0,22,0,0" Height="34"/>

        <TextBlock Text="Şifre Tekrar" Grid.Row="3" Margin="0,6,0,0"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="3" Margin="0,28,0,0" Height="34"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
            <Button Content="İptal" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Sıfırla" Width="100" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
