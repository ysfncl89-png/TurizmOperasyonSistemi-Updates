<Window x:Class="TurizmOperasyonSistemi.Views.PaymentHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ödeme Hareketleri" Height="360" Width="700" WindowStartupLocation="CenterOwner" Background="#00FFFFFF" WindowStyle="None" AllowsTransparency="True">
    <Border Background="#1F3443" CornerRadius="10" Padding="14" BorderBrush="#3A6B7B" BorderThickness="1.2">
        <Border.Resources>
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="#152234" />
                <Setter Property="Foreground" Value="#E2F8FF" />
                <Setter Property="RowBackground" Value="#152234" />
                <Setter Property="AlternatingRowBackground" Value="#12313F" />
                <Setter Property="BorderBrush" Value="#334155" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#22324A" />
                <Setter Property="Foreground" Value="#E2F8FF" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="BorderBrush" Value="#334155" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="#E2F8FF" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Border.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Ödeme Hareketleri" FontWeight="Bold" Foreground="#E2F8FF" FontSize="16"/>

            <DataGrid x:Name="PaymentsGrid" Grid.Row="1" AutoGenerateColumns="False" RowHeight="30" Background="#152234" Foreground="#E2F8FF">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tarih" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="160"/>
                    <DataGridTextColumn Header="Miktar (Orj)" Binding="{Binding OriginalAmountDisplay}" Width="140"/>
                    <DataGridTextColumn Header="Dönüştürülmüş" Binding="{Binding ConvertedDisplay}" Width="140"/>
                    <DataGridTextColumn Header="Kur" Binding="{Binding Rate}" Width="90"/>
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Note}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Kapat" Width="110" Height="34" Click="CloseBtn_Click" Background="#8B5CF6" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
