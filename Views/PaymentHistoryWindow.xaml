<Window x:Class="TurizmOperasyonSistemi.Views.PaymentHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ödeme Hareketleri" Height="360" Width="1000" WindowStartupLocation="CenterOwner" Background="#00FFFFFF" WindowStyle="None" AllowsTransparency="True">
    <Border Background="#1F3443" CornerRadius="10" Padding="14" BorderBrush="#3A6B7B" BorderThickness="1.2">
        <Border.Resources>
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="#152234" />
                <Setter Property="Foreground" Value="#E2F8FF" />
                <Setter Property="RowBackground" Value="#152234" />
                <Setter Property="AlternatingRowBackground" Value="#12313F" />
                <Setter Property="BorderBrush" Value="#334155" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#22324A" />
                <Setter Property="Foreground" Value="#E2F8FF" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="BorderBrush" Value="#334155" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="#E2F8FF" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Cell style to color amounts: refunds (IsRefund true) -> red, payments -> green -->
            <Style x:Key="AmountCellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground" Value="#E2F8FF" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRefund}" Value="True">
                        <Setter Property="Foreground" Value="#DC2626" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRefund}" Value="False">
                        <Setter Property="Foreground" Value="#10B981" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Ödeme Hareketleri" FontWeight="Bold" Foreground="#E2F8FF" FontSize="16"/>

            <DataGrid x:Name="PaymentsGrid" Grid.Row="1" AutoGenerateColumns="False" RowHeight="30" Background="#152234" Foreground="#E2F8FF">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tarih" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="160"/>
                    <DataGridTextColumn Header="Miktar (Orj)" Binding="{Binding OriginalAmountDisplay}" Width="120">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource AmountCellStyle}" />
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Dönüştürülmüş" Binding="{Binding ConvertedDisplay}" Width="160">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource AmountCellStyle}" />
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Kur" Binding="{Binding Rate}" Width="60"/>
                    <DataGridTextColumn Header="Ödeme Yöntemi" Binding="{Binding PaymentMethod}" Width="140"/>
                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Note}" Width="*"/>
                    <DataGridTemplateColumn Header="Dekont" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Göster" Width="100" Height="28" Margin="0,0,6,0" Click="OpenDocumentBtn_Click" CommandParameter="{Binding UploadedDocumentPath}" />
                                    <Button Content="Sil" Width="60" Height="28" Click="DeletePaymentBtn_Click" CommandParameter="{Binding Id}" Background="#DC2626" Foreground="White" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="ExportButton" Content="Çıktı Al / İndir" Width="160" Height="34" Margin="0,0,8,0" Click="ExportButton_Click" Background="#172033" Foreground="#F8FAFC" BorderBrush="#8B5CF6" BorderThickness="1.2">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Word (.docx)" Click="ExportWord_Click" />
                            <MenuItem Header="Excel (.xlsx)" Click="ExportExcel_Click" />
                            <MenuItem Header="PDF (.pdf)" Click="ExportPdf_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="Kapat" Width="110" Height="34" Click="CloseBtn_Click" Background="#8B5CF6" Foreground="White"/>

                <!-- Popup for export options (popup placed next to ExportButton) -->

                <Popup x:Name="ExportPopup"
                       PlacementTarget="{Binding ElementName=ExportButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="#0B1220" CornerRadius="8" Padding="10" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Width="110" Height="90" Margin="6" Click="ExportWord_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Word" Foreground="#E2F8FF" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="İndir" Foreground="#9CAFC0" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Width="110" Height="90" Margin="6" Click="ExportExcel_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Excel" Foreground="#E2F8FF" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="İndir" Foreground="#9CAFC0" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Width="110" Height="90" Margin="6" Click="ExportPdf_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="PDF" Foreground="#E2F8FF" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="İndir" Foreground="#9CAFC0" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>
    </Border>
</Window>
