<Window x:Class="TurizmOperasyonSistemi.Views.CurrencySelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Para Birimi Seç" Height="180" Width="380" WindowStartupLocation="CenterOwner" Background="#40000000" AllowsTransparency="True" WindowStyle="None">

    <Border Background="#335E6B" CornerRadius="8" Padding="12" BorderBrush="#4A7B8B" BorderThickness="1.2">
        <StackPanel>
            <TextBlock Text="Para Birimi" Foreground="#9CAFC0" Margin="4" />
            <ComboBox x:Name="CbCurrency" Height="34" Background="#0F172A" Foreground="#E2F8FF" BorderBrush="#334155" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="İptal" Width="90" Height="34" Margin="0,0,8,0" Click="CancelBtn_Click"/>
                <Button x:Name="OkBtn" Content="Seç" Width="90" Height="34" Click="OkBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
