<Page x:Class="TurizmOperasyonSistemi.Views.PersonsSearchView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PersonsSearchView"
      Background="#111827">

    <Page.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#162033"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="#162033"/>
            <Setter Property="AlternatingRowBackground" Value="#1D2A40"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#22324A"/>
            <Setter Property="Foreground" Value="#E2F8FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#162033"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#243244"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#22D3EE"/>
                    <Setter Property="Foreground" Value="#04111D"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="BackButton" Content="← Geri" Width="100" Height="40" Margin="0,0,12,0" Click="BackButton_Click"
                    Background="#8B5CF6" Foreground="White" FontWeight="SemiBold" FontSize="14" BorderThickness="0" Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
                </Button.Effect>
            </Button>
            <Grid Width="420" Height="40">
                <TextBox x:Name="SearchTextBox" Height="40" FontSize="14" Padding="12,6" VerticalContentAlignment="Center"
                         Background="#0F172A" Foreground="#E2F9FF" BorderBrush="#22D3EE" BorderThickness="2" 
                         TextChanged="SearchTextBox_TextChanged"/>
                <TextBlock IsHitTestVisible="False" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#9CAFC0" FontSize="13"
                           Text="Ad, Soyad TC veya Telefon No ile ara..." x:Name="SearchHint"/>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Background="#152234" CornerRadius="12" Padding="12">
            <DataGrid x:Name="PersonsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowHeight="36" MouseDoubleClick="PersonsDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ad" Binding="{Binding FirstName}" Width="200"/>
                    <DataGridTextColumn Header="Soyad" Binding="{Binding LastName}" Width="200"/>
                    <DataGridTextColumn Header="TC Kimlik" Binding="{Binding TcKimlikNo}" Width="150"/>
                    <DataGridTextColumn Header="Cinsiyet" Binding="{Binding Gender}" Width="90"/>
					<DataGridTextColumn Header="Telefon" Binding="{Binding PhoneNumber}" Width="SizeToCells">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#F59E0B"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle> 
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>