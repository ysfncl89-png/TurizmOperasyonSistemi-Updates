<Page x:Class="TurizmOperasyonSistemi.Views.RoomView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RoomView"
      Background="#111827">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">

            <!-- BAŞLIK -->

            <TextBlock Text="Oda Yönetimi"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <!-- ARAMA -->

            <TextBox x:Name="SearchTextBox"
                     Height="40"
                     FontSize="16"
                     Margin="0,0,0,20"
                     Background="#1F2937"
                     Foreground="White"
                     BorderBrush="#374151"
                     TextChanged="SearchTextBox_TextChanged"/>

            <!-- PASİF GÖSTER -->

            <CheckBox x:Name="ShowPassiveCheckBox"
                      Content="Pasif Odaları Göster"
                      Foreground="White"
                      Margin="0,0,0,15"
                      Checked="ShowPassiveCheckBox_Checked"
                      Unchecked="ShowPassiveCheckBox_Checked"/>

            <!-- FORM -->

            <Border Background="#1F2937"
                    CornerRadius="15"
                    Padding="20">

                <StackPanel>

                    <!-- HOTEL -->

                    <TextBlock Text="Otel"
                               Foreground="White"/>

                    <ComboBox x:Name="HotelComboBox"
                              Height="35"
                              Margin="0,5,0,15"/>

                    <!-- ODA NO -->

                    <TextBlock Text="Oda Numarası"
                               Foreground="White"/>

                    <TextBox x:Name="RoomNumberTextBox"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <!-- ODA TİPİ -->

                    <TextBlock Text="Oda Tipi"
                               Foreground="White"/>

                    <ComboBox x:Name="RoomTypeComboBox"
                              Height="35"
                              Margin="0,5,0,15">

                        <ComboBoxItem Content="Single"/>
                        <ComboBoxItem Content="Double"/>
                        <ComboBoxItem Content="Triple"/>
                        <ComboBoxItem Content="Quad"/>

                    </ComboBox>

                    <!-- KAPASİTE -->

                    <TextBlock Text="Kapasite"
                               Foreground="White"/>

                    <TextBox x:Name="CapacityTextBox"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <!-- CİNSİYET -->

                    <TextBlock Text="Cinsiyet Tipi"
                               Foreground="White"/>

                    <ComboBox x:Name="GenderTypeComboBox"
                              Height="35"
                              Margin="0,5,0,20">

                        <ComboBoxItem Content="Erkek"/>
                        <ComboBoxItem Content="Kadın"/>
                        <ComboBoxItem Content="Aile"/>
                        <ComboBoxItem Content="Karışık"/>

                    </ComboBox>

                    <!-- KAYDET -->

                    <Button Content="Kaydet"
                            Height="45"
                            Background="#06B6D4"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="SaveButton_Click"/>

                    <!-- PASİF -->

                    <Button x:Name="PassiveButton"
                            Content="Pasif Yap"
                            Height="45"
                            Margin="0,10,0,0"
                            Background="#EF4444"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="PassiveButton_Click"/>

                </StackPanel>

            </Border>

            <!-- DATA GRID -->

            <DataGrid x:Name="RoomsDataGrid"
                      Margin="0,20,0,0"
                      AutoGenerateColumns="True"
                      Height="350"
                      Background="#1F2937"
                      Foreground="White"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowBackground="#1F2937"
                      AlternatingRowBackground="#111827"
                      SelectionChanged="RoomsDataGrid_SelectionChanged"/>

        </StackPanel>

    </ScrollViewer>

</Page>