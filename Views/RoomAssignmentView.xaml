<Page x:Class="TurizmOperasyonSistemi.Views.RoomAssignmentView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RoomAssignmentView"
      Background="#111827">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">

            <TextBlock Text="Oda Yerleştirme"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <!-- FİLTRELER -->

            <Border Background="#1F2937"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Tur Türü"
                               Foreground="White"/>

                    <ComboBox x:Name="TourTypeComboBox"
                              Height="35"
                              Margin="0,5,0,15"/>

                    <TextBlock Text="Dönem"
                               Foreground="White"/>

                    <ComboBox x:Name="PeriodComboBox"
                              Height="35"
                              Margin="0,5,0,15"/>

                    <TextBlock Text="Grup Türü"
                               Foreground="White"/>

                    <ComboBox x:Name="GroupTypeComboBox"
                              Height="35"
                              Margin="0,5,0,15"/>

                    <TextBlock Text="Kaç Gün"
                               Foreground="White"/>

                    <ComboBox x:Name="DayCountComboBox"
                              Height="35"
                              Margin="0,5,0,20"/>

                    <Button Content="Kayıtları Getir"
                            Height="45"
                            Background="#06B6D4"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="LoadButton_Click"/>

                </StackPanel>

            </Border>

            <!-- KAYITLAR -->

            <DataGrid x:Name="RegistrationsDataGrid"
                      Height="300"
                      Margin="0,0,0,20"
                      AutoGenerateColumns="True"
                      Background="#1F2937"
                      Foreground="White"/>

            <!-- ODA SEÇ -->

            <Border Background="#1F2937"
                    CornerRadius="15"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Oda Seç"
                               Foreground="White"/>

                    <ComboBox x:Name="RoomComboBox"
                              Height="35"
                              Margin="0,5,0,20"/>

                    <Button Content="Odaya Yerleştir"
                            Height="45"
                            Background="#10B981"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="AssignButton_Click"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Page>