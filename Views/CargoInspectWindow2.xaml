<Window x:Class="TurizmOperasyonSistemi.Views.CargoInspectWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kargo İncele" Height="480" Width="720" MinHeight="400" MinWidth="520" WindowStartupLocation="CenterOwner" Background="#0B1220">

    <Grid Margin="12">
        <Border CornerRadius="10" Background="#0F172A" Padding="12" BorderBrush="#334155" BorderThickness="1" MinHeight="520">
        <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Kargo İncele" FontSize="18" FontWeight="SemiBold" Foreground="#E2F8FF" Margin="4 2 4 8" />

                <!-- Ad / Soyad -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Margin="4 2">
                    <TextBlock Text="Ad" Foreground="#9FB2CB" Margin="2" FontSize="13"/>
                    <TextBox x:Name="TbFirstName" Height="34" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" Padding="8,4" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="4 2">
                    <TextBlock Text="Soyad" Foreground="#9FB2CB" Margin="2" FontSize="13"/>
                    <TextBox x:Name="TbLastName" Height="34" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" Padding="8,4" HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- TC Kimlik / Telefon placed under Ad/Soyad -->
                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Vertical" Margin="4 2">
                    <TextBlock Text="TC Kimlik No" Foreground="#9FB2CB" Margin="2" FontSize="13"/>
                    <TextBox x:Name="TbTc" Height="34" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" Padding="8,4" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Margin="4 2">
                    <TextBlock Text="Telefon" Foreground="#9FB2CB" Margin="2" FontSize="13"/>
                    <TextBox x:Name="TbPhone" Height="34" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" Padding="8,4" HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Address below TC/Telefon -->
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Vertical" Margin="4 6 4 2">
                    <TextBlock Text="Adres" Foreground="#9FB2CB" Margin="2" FontSize="13"/>
                    <TextBox x:Name="TbAddress" Height="120" AcceptsReturn="True" TextWrapping="Wrap" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" VerticalScrollBarVisibility="Auto" Padding="8" HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Buttons placed immediately under address, aligned right -->
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4 8 4 6">
                    <Button x:Name="BtnCancel" Content="Vazgeç" Width="100" Height="36" Margin="6" Click="BtnCancel_Click" Background="#123046" Foreground="White"/>
                    <Button x:Name="BtnConfirm" Content="Onayla" Width="120" Height="36" Margin="6" Click="BtnConfirm_Click" Background="#059669" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
