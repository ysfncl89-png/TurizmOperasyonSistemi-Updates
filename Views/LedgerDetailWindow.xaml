<Window x:Class="TurizmOperasyonSistemi.Views.LedgerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TurizmOperasyonSistemi.Views.Converters"
        Title="Cari Hesap Detayı" Height="520" Width="1250" WindowStartupLocation="CenterOwner" Background="#40000000" AllowsTransparency="True" WindowStyle="None">

    <Border Background="#335E6B" CornerRadius="10" Padding="14" BorderBrush="#4A7B8B" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity="0.45" />
        </Border.Effect>
        <Border.Resources>
            <converters:RemainingToBrushConverter x:Key="RemainingBrushConverter" />
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="#152234" />
                <Setter Property="Foreground" Value="#E2F8FF" />
                <Setter Property="RowBackground" Value="#152234" />
                <Setter Property="AlternatingRowBackground" Value="#12313F" />
                <Setter Property="BorderBrush" Value="#334155" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#22324A" />
                <Setter Property="Foreground" Value="#E2F8FF" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="BorderBrush" Value="#334155" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="#E2F8FF" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- üstteki alan boş kaldı (başlık yok) -->
            <StackPanel Grid.Row="0" />

            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,6,0,6">
                <TextBlock Text="Ad Soyad" Foreground="#9CAFC0"/> 
                <TextBox x:Name="TbName" IsReadOnly="True" Background="#0F172A" Foreground="#E2F8FF" BorderBrush="#334155"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,6,0,6">
                <TextBlock Text="TC / Pasaport" Foreground="#9CAFC0"/>
                <TextBox x:Name="TbTc" IsReadOnly="True" Background="#0F172A" Foreground="#FFF59E0B" BorderBrush="#334155"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,6,0,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,6">
                    <StackPanel Width="220" Margin="0,0,12,0">
                        <TextBlock Text="Toplam Borç" Foreground="#9CAFC0"/>
                        <TextBox x:Name="TbTotal" IsReadOnly="False" Background="#0F172A" Foreground="#E2F8FF" BorderBrush="#334155"
                                 PreviewMouseLeftButtonDown="TbTotal_PreviewMouseLeftButtonDown"
                                 PreviewTextInput="TbNumeric_PreviewTextInput"
                                 LostFocus="TbTotal_LostFocus"
                                 GotFocus="TbTotal_GotFocus"
                                 DataObject.Pasting="TbNumeric_Pasting"/>
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,12,0">
                        <TextBlock Text="Toplam Ödenen" Foreground="#9CAFC0"/>
                        <TextBox x:Name="TbPaid" IsReadOnly="True" Background="#0F172A" Foreground="#10B981" BorderBrush="#334155"/>
                    </StackPanel>
                    <StackPanel Width="220">
                        <TextBlock Text="Toplam Kalan" Foreground="#9CAFC0"/>
                        <TextBox x:Name="TbRemaining" IsReadOnly="True" Background="#0F172A" Foreground="#DC2626" BorderBrush="#334155"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Dönem Bazlı Detaylar" Foreground="#9CAFC0" FontWeight="SemiBold" Margin="0,8,0,6"/>
                <DataGrid x:Name="DetailGrid" AutoGenerateColumns="False" RowHeight="34" Background="#152234" Foreground="#E2F8FF" MouseDoubleClick="DetailGrid_MouseDoubleClick">
                <DataGrid.Columns>
                        <DataGridTextColumn Header="Tur" Binding="{Binding TourType}" Width="*"/>
                        <DataGridTextColumn Header="Dönem" Binding="{Binding Period}" Width="140"/>
                        <DataGridTextColumn Header="Grup Türü" Binding="{Binding GroupType}" Width="140"/>
                        <DataGridTextColumn Header="Gün" Binding="{Binding DaysCount}" Width="80"/>
                        <DataGridTextColumn Header="Borç" Binding="{Binding TotalPrice, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Ödenen" Binding="{Binding PaidAmount, StringFormat=N2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#10B981" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Kalan" Binding="{Binding RemainingDebt, StringFormat=N2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding RemainingDebt, Converter={StaticResource RemainingBrushConverter}}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Para Birimi" Binding="{Binding Currency}" Width="100" />
                        <DataGridTemplateColumn Header="İşlem" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="110" Height="28" Click="PaymentRecord_Click" BorderThickness="0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="Ödeme Kaydı +" />
                                                <Setter Property="Background" Value="#10B981" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverpaid}" Value="True">
                                                        <Setter Property="Content" Value="Ödeme yap -" />
                                                        <Setter Property="Background" Value="#DC2626" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="İncele" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Ödeme Hareketleri İncele" Width="160" Height="28" Click="PaymentHistory_Click"
                                            Background="#F59E0B" Foreground="Black" BorderThickness="0" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <!-- Çıktı Alma ve Kapat butonları: sol (çıktı) ve sağ (kapat) -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Sol tarafta Çıktı Al dropdown menüsü -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0">
                        <Button x:Name="ExportBtn" Width="160" Height="38" FontWeight="Bold" Cursor="Hand"
                                Background="#10B981" Foreground="White" BorderThickness="0" Padding="10,4"
                                Click="ExportBtn_Click">
                            <Button.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="18" ShadowDepth="0" Opacity="0.65" />
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📥 Çıktı Al" VerticalAlignment="Center" Margin="0,0,6,0" />
                            </StackPanel>
                        </Button>
                    <Popup x:Name="ExportPopup" PlacementTarget="{x:Reference ExportBtn}" Placement="Top" StaysOpen="False">
                        <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="4">
                            <StackPanel>
                                <Button x:Name="ExportWordBtn" Content="📄 Word (.docx)" Height="36" Click="ExportWord_Click" 
                                        Background="#3B82F6" Foreground="White" BorderThickness="0" FontSize="12" 
                                        Cursor="Hand" Margin="2" />
                                <Button x:Name="ExportExcelBtn" Content="📊 Excel (.xlsx)" Height="36" Click="ExportExcel_Click" 
                                        Background="#059669" Foreground="White" BorderThickness="0" FontSize="12" 
                                        Cursor="Hand" Margin="2" />
                                <Button x:Name="ExportPdfBtn" Content="📋 PDF (.pdf)" Height="36" Click="ExportPdf_Click" 
                                        Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="12" 
                                        Cursor="Hand" Margin="2" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Sağ tarafta Kapat butonu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0">
                    <Button x:Name="CloseBtn" Content="Kapat" Width="120" Height="38" Click="CloseBtn_Click" FontWeight="Bold" Cursor="Hand"
                            Background="#8B5CF6" Foreground="White" BorderThickness="0" Padding="10,4">
                        <Button.Effect>
                            <DropShadowEffect Color="#8B5CF6" BlurRadius="18" ShadowDepth="0" Opacity="0.65" />
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
