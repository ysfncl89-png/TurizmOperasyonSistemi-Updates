<Page x:Class="TurizmOperasyonSistemi.Views.TurProgramPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F1724">

    <Page.Resources>
        <SolidColorBrush x:Key="NeonGlowBrush" Color="#FF8B5CF6"/>
        <Color x:Key="NeonGlowColor">#FF8B5CF6</Color>
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Background" Value="#2D3748"/>
            <Setter Property="Foreground" Value="#E2F8FF"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000000" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{StaticResource NeonGlowColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="{StaticResource NeonGlowBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Ensure DatePickerTextBox uses dark background and light text -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#E2F8FF"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="BackButton" Content="← Geri" Click="BackButton_Click" Padding="8" Height="32" Width="87" Style="{StaticResource NeonButton}"/>
            <TextBlock Text="Tur Programı Hazırla" Foreground="#E2F8FF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/>
        </DockPanel>

        <!-- Card container to match Lists module visuals -->
        <Border Grid.Row="1" Background="#0B1220" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12" SnapsToDevicePixels="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Image upload and preview -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <Button x:Name="UploadImageButton" Click="UploadImageButton_Click" Padding="8" Style="{StaticResource NeonButton}">Görsel Yükle</Button>
                            <TextBlock Text="  (Üstte görünecek logo veya fotoğraf)" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <Border Background="#0F172A" CornerRadius="6" BorderBrush="#122238" BorderThickness="1" Padding="8" Height="160" HorizontalAlignment="Stretch">
                            <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Left"/>
                        </Border>
                    </StackPanel>

                    <!-- Entries list -->
                    <!-- Column headers to label fields -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" FontSize="14" Margin="0,0,6,0" Foreground="#9CA3AF"/>
                            <TextBlock Text="Tarih" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE917;" FontSize="14" Margin="0,0,6,0" Foreground="#9CA3AF"/>
                            <TextBlock Text="Saat" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="14" Margin="0,0,6,0" Foreground="#9CA3AF"/>
                            <TextBlock Text="Açıklama" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <ListBox x:Name="EntriesControl" BorderThickness="0" Background="Transparent" AllowDrop="True" 
                             PreviewMouseLeftButtonDown="EntriesList_PreviewMouseLeftButtonDown" 
                             MouseMove="EntriesList_MouseMove" 
                             Drop="EntriesList_Drop" 
                             DragOver="EntriesList_DragOver"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="6" Padding="8" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- DatePicker (use built-in small calendar button) -->
                                        <DatePicker SelectedDate="{Binding Date}" Grid.Column="0" Height="32" VerticalAlignment="Center" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" BorderThickness="1" />
                                        <TextBox Text="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="8,0,0,0" VerticalContentAlignment="Center" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" BorderThickness="1" Padding="8" />
                                        <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" Margin="8,0,0,0" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Background="#0B1220" Foreground="#E2F8FF" BorderBrush="#334155" BorderThickness="1" Padding="8" VerticalContentAlignment="Top"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                        <Button Grid.Column="3" Click="RemoveEntry_Click" Tag="{Binding}" Padding="6" Style="{StaticResource NeonButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#E2F8FF"/>
                                                <TextBlock Text="Kaldır" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button x:Name="AddRowButton" Click="AddRowButton_Click" Width="140" HorizontalAlignment="Left" Padding="8" Style="{StaticResource NeonButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Satır Ekle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Bottom actions inside card -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="ExportWordButton" Click="ExportWordButton_Click" Margin="8" Padding="8" Style="{StaticResource NeonButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Çıktı Al (Word)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportPdfButton" Click="ExportPdfButton_Click" Margin="8" Padding="8" Style="{StaticResource NeonButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Çıktı Al (PDF)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>

</Page>
