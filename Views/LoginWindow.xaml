<Window x:Class="TurizmOperasyonSistemi.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turizm Operasyon Sistemi - Giriş" 
        Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1F1F1F"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <!-- Logo/Title -->
            <TextBlock Text="Turizm Operasyon Sistemi" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#FF8B5CF6"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Giriş Yap" 
                       FontSize="16" 
                       Foreground="#CCCCCC"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Login Mode Content -->
            <StackPanel x:Name="LoginPanel">
                <!-- Username -->
                <TextBlock Text="Kullanıcı Adı" 
                           Foreground="#CCCCCC" 
                           FontSize="12"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameTextBox" 
                         Padding="10"
                         Height="40"
                         FontSize="14"
                         Background="#2D2D2D"
                         Foreground="#FFFFFF"
                         BorderThickness="1"
                         BorderBrush="#444444"
                         Margin="0,0,0,15"/>

                <!-- Password -->
                <TextBlock Text="Şifre" 
                           Foreground="#CCCCCC" 
                           FontSize="12"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" 
                             Padding="10"
                             Height="40"
                             FontSize="14"
                             Background="#2D2D2D"
                             Foreground="#FFFFFF"
                             BorderThickness="1"
                             BorderBrush="#444444"
                             Margin="0,0,0,20"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorMessage" 
                           Foreground="#FF4444" 
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,0,0,15"
                           Visibility="Collapsed"/>

                <!-- Login Button -->
                <Button Content="Giriş Yap"
                        Click="LoginButton_Click"
                        Padding="10"
                        Height="40"
                        FontSize="14"
                        Background="#FF8B5CF6"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,0,10"/>
                <!-- Şifremi unuttum -->
                <TextBlock TextAlignment="Center" Margin="0,0,0,10">
                    <Hyperlink Click="ForgotPasswordLink_Click" Foreground="#FF8B5CF6">Şifremi unuttum</Hyperlink>
                </TextBlock>

                <!-- Kayıt (Kaydol) linki kaldırıldı: yalnızca ilk çalıştırmada admin oluşturma izni verilir -->

            </StackPanel>

            <!-- Register Mode Content -->
            <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                <!-- New Username -->
                <TextBlock Text="Kullanıcı Adı" 
                           Foreground="#CCCCCC" 
                           FontSize="12"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="NewUsernameTextBox" 
                         Padding="10"
                         Height="40"
                         FontSize="14"
                         Background="#2D2D2D"
                         Foreground="#FFFFFF"
                         BorderThickness="1"
                         BorderBrush="#444444"
                         Margin="0,0,0,15"/>

                <!-- New Password -->
                <TextBlock Text="Şifre" 
                           Foreground="#CCCCCC" 
                           FontSize="12"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="NewPasswordBox" 
                             Padding="10"
                             Height="40"
                             FontSize="14"
                             Background="#2D2D2D"
                             Foreground="#FFFFFF"
                             BorderThickness="1"
                             BorderBrush="#444444"
                             Margin="0,0,0,15"/>

                <!-- Confirm Password -->
                <TextBlock Text="Şifre Tekrar" 
                           Foreground="#CCCCCC" 
                           FontSize="12"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordBox" 
                             Padding="10"
                             Height="40"
                             FontSize="14"
                             Background="#2D2D2D"
                             Foreground="#FFFFFF"
                             BorderThickness="1"
                             BorderBrush="#444444"
                             Margin="0,0,0,20"/>

                <!-- Error Message -->
                <TextBlock x:Name="RegisterErrorMessage" 
                           Foreground="#FF4444" 
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,0,0,15"
                           Visibility="Collapsed"/>

                <!-- No-login option for first setup -->
                <CheckBox x:Name="NoLoginModeCheckBox"
                          Content="Programı kullanıcı girişi olmadan kullanmak istiyorum"
                          Foreground="#CCCCCC"
                          Margin="0,0,0,12"
                          Visibility="Visible"/>

                <!-- Register Button -->
                <Button Content="Kaydol"
                        Click="RegisterButton_Click"
                        Padding="10"
                        Height="40"
                        FontSize="14"
                        Background="#FF8B5CF6"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,0,10"/>

                <!-- Back to Login Link -->
                <TextBlock TextAlignment="Center" Margin="0,0,0,0">
                    <Run Text="Zaten hesabınız var mı? " Foreground="#CCCCCC"/>
                    <Hyperlink Click="BackToLoginLink_Click" Foreground="#FF8B5CF6">Giriş Yap</Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
