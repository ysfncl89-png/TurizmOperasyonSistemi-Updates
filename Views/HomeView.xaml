<Page x:Class="TurizmOperasyonSistemi.Views.HomeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E293B">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ÜST BAŞLIK + SAAT -->
        <Grid Grid.Row="0" Margin="30,20,30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sol üst: Aktif Turlar combobox (daha düzenli Grid ile hizalandı) -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Height="114">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Sol: etiket -->
                <Border Grid.Column="0" Background="Transparent" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="ActiveToursLabel" Text="Aktif Turlar:" Foreground="#CBD5E1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                </Border>

                <!-- Orta: Combo ve kişi sayısı (vertical) -->
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <ComboBox x:Name="ActiveToursCombo" Width="420" Height="36" SelectionChanged="ActiveToursCombo_SelectionChanged"/>

                    <!-- Kayıtlı kişi sayısı kutucuğu -->
                    <Border x:Name="ActiveTourPeopleCountBox" Background="#0B1220" CornerRadius="6" Padding="8" Margin="0,8,0,0" Width="420">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="ActivePeopleText" Foreground="#7EE787" FontWeight="Bold" Text="Aktif Kişi: 0" Margin="0,0,16,0" />
                            <TextBlock x:Name="InactivePeopleText" Foreground="#FCA5A5" FontWeight="Bold" Text="Pasif Kişi: 0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sağ: Toplam tahsilat / kalan -->
                <Border Grid.Column="2" x:Name="TotalsPanel" Background="#0B1220" CornerRadius="6" Padding="12" Margin="18,0,0,0" VerticalAlignment="Center" Width="320">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="Toplam Tahsilat:" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalCollectedText" Text="USD -" Foreground="#7EE787" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <TextBlock Text="Toplam Kalan:" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalRemainingText" Text="USD -" Foreground="#FCA5A5" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Sağ üst: Saat ile aynı hizada kurlar olacak şekilde iki sütunlu düzen -->
            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Kurlar paneli (orta sütun) -->

                <!-- Bildirim ikonu (şimdilik sadece görüntü) -->
                <Button x:Name="NotificationsButton" Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="6" ToolTip="Bildirimler">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="19" Height="19">
                            <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1 .9 2 2 2zm6-6V11c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5S10.5 3.17 10.5 4v.68C7.63 5.36 6 7.92 6 11v5l-1.99 2H20l-1.99-2z" Fill="#F6C85F" Stretch="Uniform">
                                <Path.Effect>
                                    <DropShadowEffect Color="#F6C85F" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
                                </Path.Effect>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Dijital saat ve tarih (sağ sütun) -->
                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="8" Padding="8" Width="160" HorizontalAlignment="Right">
                        <StackPanel>
                            <TextBlock x:Name="DigitalTimeText" Text="00:00:00" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="6" ShadowDepth="0" Opacity="0.25" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="DateText"
                                       Text="Gün, dd MMMM yyyy"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Right" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ASIL İÇERİK -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,153,0,68" Grid.RowSpan="2">
            <StackPanel Margin="30">
                <!-- Dashboard özet kartları: Vize / Bilet / Kargo / Odalama -->
                <Grid Margin="0,6,0,18" Height="336">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Vize Kartı -->
                    <Border Grid.Column="0" Background="#0B1220" CornerRadius="8" Padding="12" Margin="6,0,6,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="Vize" Foreground="#E6EEF8" FontWeight="Bold" FontSize="14" />
                                <TextBlock Text="  " />
                                <TextBlock x:Name="VisaStatusText" Text="(Özet)" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Vize Alacağız" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="VisaWillGetText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Vizeyi Kendisi Alacak" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="VisaSelfGetText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Vize Çıktı" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="VisaIssuedText" Text="0" Foreground="#7EE787" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Vize Çıkmadı" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="VisaNotIssuedText" Text="0" Foreground="#FCA5A5" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Vizesi Alınıyor" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="VisaInProgressText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Pasaport Bekleniyor" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="PassportPendingText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                                    <TextBlock Text="Pasaport Geldi (Evet)" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="PassportArrivedYesText" Text="0" Foreground="#7EE787" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Pasaport Geldi (Hayır)" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="PassportArrivedNoText" Text="0" Foreground="#FCA5A5" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="VisaHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Bilet Kartı -->
                    <Border Grid.Column="1" Background="#0B1220" CornerRadius="8" Padding="12" Margin="6,0,6,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bilet" Foreground="#E6EEF8" FontWeight="Bold" FontSize="14" />
                                <TextBlock x:Name="TicketStatusText" Text="(Özet)" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Biletini Alacağız" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="TicketWillGetText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Bileti Kendisi Alacak" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="TicketSelfGetText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Bileti Geldi" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="TicketArrivedText" Text="0" Foreground="#7EE787" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Bileti Gelmedi" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="TicketNotArrivedText" Text="0" Foreground="#FCA5A5" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Bileti Alınıyor" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="TicketInProgressText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                                    <TextBlock Text="Bağlantı uçuşu olan kişi" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="TicketTransferCountText" Text="0" Foreground="#7EE787" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <TextBlock x:Name="TicketHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Kargo Kartı -->
                    <Border Grid.Column="2" Background="#0B1220" CornerRadius="8" Padding="12" Margin="6,0,6,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Kargo" Foreground="#E6EEF8" FontWeight="Bold" FontSize="14" />
                                <TextBlock x:Name="CargoStatusText" Text="(Özet)" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Kargo Gönderilecek" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="CargoWillSendText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Kargo Gönderildi" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="CargoSentText" Text="0" Foreground="#7EE787" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Kargo Almayacak" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="CargoNoSendText" Text="0" Foreground="#FCA5A5" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Elden Teslim Alacak" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="CargoPickupWillText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                    <TextBlock Text="Elden Teslim Aldı" Foreground="#CBD5E1" Width="160" />
                                    <TextBlock x:Name="CargoPickedText" Text="0" Foreground="#7EE787" FontWeight="Bold" HorizontalAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="CargoHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Oda Kartı -->
                    <Border Grid.Column="3" Background="#0B1220" CornerRadius="8" Padding="12" Margin="6,0,6,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Odalama" Foreground="#E6EEF8" FontWeight="Bold" FontSize="14" />
                                <TextBlock x:Name="RoomAllocStatusText" Text="(Özet)" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Rezerv ve Boş bölümleri kaldırıldı: bu özet alan yalnızca gerekli bilgiler gösterir -->
                            <TextBlock x:Name="RoomAllocHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Diğer içerik yerleşimi (gerektiğinde buraya ek kartlar veya listeler eklenebilir) -->
            </StackPanel>
        </ScrollViewer>

        <!-- Rezerv alan: Analog ve tarih hizasına denk gelecek şekilde sağa yaslı, aşağıya kadar uzanan görünmez bölge -->

        <!-- ALT FOOTER -->
        <TextBlock Grid.Row="2"
                   Text="© 2026 Turizm Operasyon Sistemi — Tüm hakları saklıdır."
                   FontSize="12"
                   Foreground="#94A3B8"
                   Opacity="0.9"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,12,0,12" />

    </Grid>

</Page>
