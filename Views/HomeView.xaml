<Page x:Class="TurizmOperasyonSistemi.Views.HomeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E293B">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <!-- BAŞLIK -->

            <TextBlock Text="ANASAYFA DASHBOARD"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,30"/>

            <!-- KARTLAR -->

            <WrapPanel>

                <!-- Kart 1 -->

                <Border Width="250"
                        Height="140"
                        Background="#0F172A"
                        CornerRadius="20"
                        Margin="10"
                        BorderBrush="#06B6D4"
                        BorderThickness="1">

                    <StackPanel Margin="20">

                        <TextBlock Text="TOPLAM KİŞİ"
                                   Foreground="#94A3B8"
                                   FontSize="16"/>

                        <TextBlock Text="1.248"
                                   Foreground="#06B6D4"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="+12 bugün"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Kart 2 -->

                <Border Width="250"
                        Height="140"
                        Background="#0F172A"
                        CornerRadius="20"
                        Margin="10"
                        BorderBrush="#8B5CF6"
                        BorderThickness="1">

                    <StackPanel Margin="20">

                        <TextBlock Text="TOPLAM KAYIT"
                                   Foreground="#94A3B8"
                                   FontSize="16"/>

                        <TextBlock Text="532"
                                   Foreground="#8B5CF6"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="+8 bugün"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Kart 3 -->

                <Border Width="250"
                        Height="140"
                        Background="#0F172A"
                        CornerRadius="20"
                        Margin="10"
                        BorderBrush="#10B981"
                        BorderThickness="1">

                    <StackPanel Margin="20">

                        <TextBlock Text="KARGO BEKLEYEN"
                                   Foreground="#94A3B8"
                                   FontSize="16"/>

                        <TextBlock Text="38"
                                   Foreground="#10B981"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="Gönderim bekliyor"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Kart 4 -->

                <Border Width="250"
                        Height="140"
                        Background="#0F172A"
                        CornerRadius="20"
                        Margin="10"
                        BorderBrush="#F59E0B"
                        BorderThickness="1">

                    <StackPanel Margin="20">

                        <TextBlock Text="PASAPORT BEKLEYEN"
                                   Foreground="#94A3B8"
                                   FontSize="16"/>

                        <TextBlock Text="15"
                                   Foreground="#F59E0B"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="Teslim edilmedi"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

            </WrapPanel>

        </StackPanel>

    </ScrollViewer>

</Page>