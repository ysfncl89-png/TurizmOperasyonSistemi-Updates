<Page x:Class="TurizmOperasyonSistemi.Views.HomeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E293B">

    <Grid>
        <Grid.Resources>
            <!-- Dashboard card style: subtle dark panel with soft border and inner padding -->
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#0B1220" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="6,0,6,10" />
                <Setter Property="BorderBrush" Value="#172433" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.12" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DashboardCardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#E6EEF8" />
            </Style>

            <Style x:Key="DashboardCardSub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="#94A3B8" />
            </Style>

            <Style x:Key="DashboardCardRowText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#CBD5E1" />
            </Style>

            <Style x:Key="DashboardCardRowNumber" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <!-- Card header style: subtle top band to separate header from content -->
            <Style x:Key="CardHeaderStyle" TargetType="Border">
                <Setter Property="Background" Value="#071426" />
                <Setter Property="CornerRadius" Value="8,8,0,0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Margin" Value="-14,-14,-14,8" />
                <Setter Property="BorderBrush" Value="#172433" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ÜST BAŞLIK + SAAT -->
        <Grid Grid.Row="0" Margin="30,20,30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sol üst: Aktif Turlar combobox (daha düzenli Grid ile hizalandı) -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Height="154">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Sol: etiket -->
                <Border Grid.Column="0" Background="Transparent" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="ActiveToursLabel" Text="Aktif Turlar:" Foreground="#CBD5E1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                </Border>

                <!-- Orta: Combo ve kişi sayısı (vertical) -->
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#0F172A" Padding="4" Margin="0" BorderBrush="#8B5CF6" BorderThickness="1">
                        <Grid>
                            <ComboBox x:Name="ActiveToursCombo" Width="420" Height="36" SelectionChanged="ActiveToursCombo_SelectionChanged" Background="Transparent" Foreground="#E2F8FF" BorderThickness="0" />
                        </Grid>
                        <Border.Effect>
                            <DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.12" />
                        </Border.Effect>
                    </Border>
                    <TextBlock x:Name="ActiveToursInfoText" Text="Şu an seçili olan turun özet bilgilerine bakıyorsunuz." Foreground="#94A3B8" FontSize="12" Margin="6,6,0,0" Opacity="0.95" />

                    <!-- Kayıtlı kişi sayısı kutucuğu -->
                    <Border x:Name="ActiveTourPeopleCountBox" Background="#0B1220" CornerRadius="6" Padding="8" Margin="0,8,0,0" Width="420">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="👤" FontSize="14" Margin="0,0,6,0" Foreground="#7EE787" VerticalAlignment="Center" />
                                <TextBlock x:Name="ActivePeopleText" Foreground="#7EE787" FontWeight="Bold" Text="Aktif: 0" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚫" FontSize="14" Margin="0,0,6,0" Foreground="#FCA5A5" VerticalAlignment="Center" />
                                <TextBlock x:Name="InactivePeopleText" Foreground="#FCA5A5" FontWeight="Bold" Text="Pasif: 0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sağ: Toplam tahsilat / kalan -->
                <Border Grid.Column="2" x:Name="TotalsPanel" Background="#0B1220" CornerRadius="6" Padding="12" Margin="18,0,0,0" VerticalAlignment="Top" Width="390" Height="134">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Stroke="#F59E0B" StrokeThickness="0">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F6C85F" Offset="0" />
                                            <GradientStop Color="#F59E0B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="$" Foreground="#0B6623" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            </Grid>
                            <TextBlock Text="Toplam Tahsilat:" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalCollectedText" Text="USD -" Foreground="#7EE787" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Tahsilat Progress Bar -->
                        <StackPanel Orientation="Vertical" Margin="28,4,0,0">
                            <Border Height="18" Background="#1A1F3A" CornerRadius="6" Margin="0,0,0,2" Padding="0" ClipToBounds="True">
                                <Grid>
                                    <ProgressBar x:Name="CollectedProgressBar" Value="0" Maximum="100" Height="18" Background="Transparent" Foreground="#7EE787" BorderThickness="0" />
                                    <TextBlock x:Name="CollectedPercentageText" Text="0%" Foreground="#E6EEF8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Fill="#FCA5A5" Stroke="#F97316" StrokeThickness="0" />
                                <TextBlock Text="$" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            </Grid>
                            <TextBlock Text="Toplam Kalan:" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalRemainingText" Text="USD -" Foreground="#FCA5A5" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Kalan Progress Bar -->
                        <StackPanel Orientation="Vertical" Margin="28,4,0,0">
                            <Border Height="18" Background="#1A1F3A" CornerRadius="6" Margin="0,0,0,2" Padding="0" ClipToBounds="True">
                                <Grid>
                                    <ProgressBar x:Name="RemainingProgressBar" Value="0" Maximum="100" Height="18" Background="Transparent" Foreground="#FCA5A5" BorderThickness="0" />
                                    <TextBlock x:Name="RemainingPercentageText" Text="0%" Foreground="#E6EEF8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Sağ üst: Saat ile aynı hizada kurlar olacak şekilde iki sütunlu düzen -->
            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Kurlar paneli (orta sütun) -->

                <!-- Bildirim ikonu: badge + sallanma animasyonu -->
                <Grid Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="NotificationsButton" Width="40" Height="40" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="6" ToolTip="Bildirimler" Click="NotificationsButton_Click" RenderTransformOrigin="0.5,0.2">
                        <Button.Resources>
                            <!-- Zil sallanma storyboard (button namescope içinde) -->
                            <Storyboard x:Key="NotificationsShakeStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NotificationsRotateTransform" Storyboard.TargetProperty="Angle">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="-18" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="12" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="-8" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="4" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </Button.Resources>
                        <Button.RenderTransform>
                            <RotateTransform x:Name="NotificationsRotateTransform" Angle="0" />
                        </Button.RenderTransform>
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="19" Height="19">
                                <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1 .9 2 2 2zm6-6V11c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5S10.5 3.17 10.5 4v.68C7.63 5.36 6 7.92 6 11v5l-1.99 2H20l-1.99-2z" Fill="#F6C85F" Stretch="Uniform">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#F6C85F" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
                                    </Path.Effect>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Küçük kırmızı badge: görünürlük kod tarafından kontrol edilecek -->
                    <Border x:Name="NotificationBadge" Width="18" Height="18" Background="#EF4444" CornerRadius="9" BorderBrush="#FFFFFF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="NotificationBadgeText" Text="0" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Bildirim listesi popup'ı -->
                    <Popup x:Name="NotificationsPopup" PlacementTarget="{Binding ElementName=NotificationsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <!-- Use requested color for popup background -->
                        <Border Background="#FF4A7B8B" CornerRadius="8" BorderBrush="#172433" BorderThickness="1" Width="360" MaxHeight="500" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Bildirimler" FontWeight="Bold" Foreground="#E6EEF8" Margin="6" />
                                <ScrollViewer Height="500" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="NotificationsPopupStack" />
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button x:Name="NotificationsMarkAllReadButton" Content="Tümünü okundu işaretle" Padding="6,4" Margin="6,0,0,0" Click="NotificationsMarkAllReadButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Dijital saat ve tarih (sağ sütun) -->
                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="8" Padding="8" Width="160" HorizontalAlignment="Right">
                        <StackPanel>
                            <TextBlock x:Name="DigitalTimeText" Text="00:00:00" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="6" ShadowDepth="0" Opacity="0.25" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="DateText"
                                       Text="Gün, dd MMMM yyyy"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Right" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ASIL İÇERİK -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,19,0,88" Grid.Row="1">
            <StackPanel Margin="30">
                <!-- Dashboard özet kartları: Vize / Bilet / Kargo / Odalama -->
                <Grid Margin="0,6,0,18" Height="259">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Vize Kartı -->
                    <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="6,0,6,-143">
                        <Border.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.12" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🛂" FontSize="18" Margin="0,0,8,0" Foreground="#8B5CF6" VerticalAlignment="Center" Grid.Column="0" />
                                    <TextBlock Text="Vize" Style="{StaticResource DashboardCardTitle}" Grid.Column="1" VerticalAlignment="Center" />
                                    <TextBlock x:Name="VisaStatusText" Text="(Özet)" Style="{StaticResource DashboardCardSub}" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Column="2" />
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,8,0,0" Height="267">
                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vize Alacağız" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="VisaWillGetText" Text="0" Foreground="#F59E0B" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vizeyi Kendisi Alacak" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="VisaSelfGetText" Text="0" Foreground="#F59E0B" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vize Çıktı" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="VisaIssuedText" Text="0" Foreground="#7EE787" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vize Çıkmadı" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="VisaNotIssuedText" Text="0" Foreground="#FCA5A5" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vizesi Alınıyor" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="VisaInProgressText" Text="0" Foreground="#F59E0B" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pasaport Bekleniyor" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="PassportPendingText" Text="0" Foreground="#F59E0B" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pasaport Geldi (Evet)" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="PassportArrivedYesText" Text="0" Foreground="#7EE787" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pasaport Geldi (Hayır)" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="PassportArrivedNoText" Text="0" Foreground="#FCA5A5" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="VisaHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="12" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Bilet Kartı -->
                    <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Margin="6,0,6,-143">
                        <Border.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.12" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="✈️" FontSize="18" Margin="0,0,8,0" Foreground="#8B5CF6" VerticalAlignment="Center" Grid.Column="0" />
                                    <TextBlock Text="Bilet" Style="{StaticResource DashboardCardTitle}" Grid.Column="1" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TicketStatusText" Text="(Özet)" Style="{StaticResource DashboardCardSub}" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="0,8,0,0">
                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Biletini Alacağız" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="TicketWillGetText" Text="0" Foreground="#F59E0B" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bileti Kendisi Alacak" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="TicketSelfGetText" Text="0" Foreground="#F59E0B" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bileti Geldi" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="TicketArrivedText" Text="0" Foreground="#7EE787" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bileti Gelmedi" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="TicketNotArrivedText" Text="0" Foreground="#FCA5A5" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bileti Alınıyor" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="TicketInProgressText" Text="0" Foreground="#F59E0B" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bağlantı uçuşu olan kişi" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="TicketTransferCountText" Text="0" Foreground="#7EE787" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="TicketHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Kargo Kartı -->
                    <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Margin="6,0,6,-143">
                        <Border.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.12" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📦" FontSize="18" Margin="0,0,8,0" Foreground="#8B5CF6" VerticalAlignment="Center" Grid.Column="0" />
                                    <TextBlock Text="Kargo" Style="{StaticResource DashboardCardTitle}" Grid.Column="1" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CargoStatusText" Text="(Özet)" Style="{StaticResource DashboardCardSub}" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="0,8,0,0">
                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Kargo Gönderilecek" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="CargoWillSendText" Text="0" Foreground="#F59E0B" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Kargo Gönderildi" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="CargoSentText" Text="0" Foreground="#7EE787" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Kargo Almayacak" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="CargoNoSendText" Text="0" Foreground="#FCA5A5" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Elden Teslim Alacak" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="CargoPickupWillText" Text="0" Foreground="#F59E0B" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Elden Teslim Aldı" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="CargoPickedText" Text="0" Foreground="#7EE787" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="CargoHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="12" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Oda Kartı -->
                    <Border Grid.Column="3" Style="{StaticResource DashboardCardStyle}" Margin="6,0,6,-143">
                        <Border.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.12" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🏨" FontSize="18" Margin="0,0,8,0" Foreground="#8B5CF6" VerticalAlignment="Center" Grid.Column="0" />
                                    <TextBlock Text="Odalama" Style="{StaticResource DashboardCardTitle}" Grid.Column="1" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RoomAllocStatusText" Text="(Özet)" Style="{StaticResource DashboardCardSub}" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Column="2" />
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,8,0,0">
                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Odalama yapıldı" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="RoomAllocReservedText" Text="0" Foreground="#7EE787" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <Border Background="#071225" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="odalanmamış" Foreground="#CBD5E1" Style="{StaticResource DashboardCardRowText}" />
                                        <TextBlock x:Name="RoomAllocAvailableText" Text="0" Foreground="#F59E0B" Style="{StaticResource DashboardCardRowNumber}" Grid.Column="1" />
                                    </Grid>
                                </Border>

                                <StackPanel>
                                    <StackPanel x:Name="RoomAllocPerHotelPanel" />
                                    <TextBlock x:Name="RoomAllocHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>


                <!-- Diğer içerik yerleşimi (gerektiğinde buraya ek kartlar veya listeler eklenebilir) -->
            </StackPanel>
        </ScrollViewer>

        <!-- Rezerv alan: Analog ve tarih hizasına denk gelecek şekilde sağa yaslı, aşağıya kadar uzanan görünmez bölge -->

        <!-- ALT FOOTER -->
        <TextBlock Grid.Row="2"
                   Text="© 2026 TOS Lite ( Turizm Operasyon Sistemi ) — Tüm hakları saklıdır."
                   FontSize="12"
                   Foreground="#94A3B8"
                   Opacity="0.9"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,12,0,12" />

    </Grid>

</Page>
