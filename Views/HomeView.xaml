<Page x:Class="TurizmOperasyonSistemi.Views.HomeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E293B">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ÜST BAŞLIK + SAAT -->
        <Grid Grid.Row="0" Margin="30,20,30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sol üst: Aktif Turlar combobox -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Height="114">
                <TextBlock Text="Aktif Turlar:" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Combo ve altındaki kişi sayısı kutucuğu dikey olarak gruplanır -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <ComboBox x:Name="ActiveToursCombo" Width="320" Height="34" SelectionChanged="ActiveToursCombo_SelectionChanged"/>

                    <!-- Kayıtlı kişi sayısı kutucuk -->
                    <Border x:Name="ActiveTourPeopleCountBox" Background="#0B1220" CornerRadius="6" Padding="8" Margin="0,8,0,0" Width="320">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="ActivePeopleText" Foreground="#7EE787" FontWeight="Bold" Text="Aktif Kişi: 0" Margin="0,0,12,0" />
                            <TextBlock x:Name="InactivePeopleText" Foreground="#FCA5A5" FontWeight="Bold" Text="Pasif Kişi: 0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Background="#111827" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ActiveToursCountText" Foreground="#CBD5E1" FontWeight="Bold" Text="Aktif: 0" />
                </Border>

                <!-- Toplam Tahsilat / Toplam Kalan (USD) kutucuğu -->
                <Border x:Name="TotalsPanel" Background="#0B1220" CornerRadius="6" Padding="8" Margin="12,0,0,0" VerticalAlignment="Center" Width="356" Height="74">
                    <StackPanel Orientation="Vertical" Margin="0,0,-8,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="Toplam Tahsilat:" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalCollectedText" Text="USD -" Foreground="#7EE787" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBlock Text="Toplam Kalan:" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalRemainingText" Text="USD -" Foreground="#FCA5A5" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Sağ üst: Saat ile aynı hizada kurlar olacak şekilde iki sütunlu düzen -->
            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Kurlar paneli (orta sütun) -->
                <Border x:Name="ExchangeRatesPanel" Grid.Column="1" Background="#0B1220" CornerRadius="8" Padding="8" Margin="8,0,12,0" Width="320" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Merkez Bankası Kurları" Foreground="#CBD5E1" FontWeight="Bold" FontSize="13" HorizontalAlignment="Left" Margin="0,0,0,6" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Dolar (USD)" Foreground="#CBD5E1" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Alış:" Foreground="#94A3B8" Margin="12,0,4,0" />
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="UsdBuyText" Text="-" Foreground="#7EE787" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Satış:" Foreground="#94A3B8" Margin="12,0,4,0" />
                            <TextBlock Grid.Row="0" Grid.Column="4" x:Name="UsdSellText" Text="-" Foreground="#FCA5A5" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Euro (EUR)" Foreground="#CBD5E1" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Alış:" Foreground="#94A3B8" Margin="12,6,4,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="EurBuyText" Text="-" Foreground="#7EE787" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Satış:" Foreground="#94A3B8" Margin="12,6,4,0" />
                            <TextBlock Grid.Row="1" Grid.Column="4" x:Name="EurSellText" Text="-" Foreground="#FCA5A5" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="İng. Sterlini (GBP)" Foreground="#CBD5E1" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Alış:" Foreground="#94A3B8" Margin="12,6,4,0" />
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="GbpBuyText" Text="-" Foreground="#7EE787" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Satış:" Foreground="#94A3B8" Margin="12,6,4,0" />
                            <TextBlock Grid.Row="2" Grid.Column="4" x:Name="GbpSellText" Text="-" Foreground="#FCA5A5" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Suudi Riyali (SAR)" Foreground="#CBD5E1" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Alış:" Foreground="#94A3B8" Margin="12,6,4,0" />
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="SarBuyText" Text="-" Foreground="#7EE787" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="Satış:" Foreground="#94A3B8" Margin="12,6,4,0" />
                            <TextBlock Grid.Row="3" Grid.Column="4" x:Name="SarSellText" Text="-" Foreground="#FCA5A5" Margin="0,6,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Bildirim ikonu (şimdilik sadece görüntü) -->
                <Button x:Name="NotificationsButton" Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="6" ToolTip="Bildirimler">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="19" Height="19">
                            <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1 .9 2 2 2zm6-6V11c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5S10.5 3.17 10.5 4v.68C7.63 5.36 6 7.92 6 11v5l-1.99 2H20l-1.99-2z" Fill="#F6C85F" Stretch="Uniform">
                                <Path.Effect>
                                    <DropShadowEffect Color="#F6C85F" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
                                </Path.Effect>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Analog saat ve tarih (sağ sütun) -->
                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Width="110" Height="110" HorizontalAlignment="Right" Margin="0,0,0,6">
                        <Ellipse Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Saat işaretleri: kod-behind tarafından oluşturulacak 60 işaret -->
                        <Canvas x:Name="MarkersCanvas" Width="110" Height="110" />

                        <!-- Saat kolları: RenderTransformOrigin merkezde -->
                        <Line x:Name="HourHand" X1="55" Y1="55" X2="55" Y2="36" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Line.RenderTransform>
                                <RotateTransform x:Name="HourRotate" Angle="0" />
                            </Line.RenderTransform>
                            <Line.Effect>
                                <!-- Hafif parlak glow efekti -->
                                <DropShadowEffect Color="#FF8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.85" />
                            </Line.Effect>
                        </Line>

                        <Line x:Name="MinuteHand" X1="55" Y1="55" X2="55" Y2="18" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Line.RenderTransform>
                                <RotateTransform x:Name="MinuteRotate" Angle="0" />
                            </Line.RenderTransform>
                            <Line.Effect>
                                <DropShadowEffect Color="#FFFFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.65" />
                            </Line.Effect>
                        </Line>

                        <Line x:Name="SecondHand" X1="55" Y1="60" X2="55" Y2="12" Stroke="#FF8B5CF6" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Line.RenderTransform>
                                <RotateTransform x:Name="SecondRotate" Angle="0" />
                            </Line.RenderTransform>
                        </Line>

                        <!-- Merkez düğme -->
                        <Ellipse Width="6" Height="6" Fill="#FF8B5CF6" Canvas.Left="52" Canvas.Top="52" />
                    </Grid>

                    <TextBlock x:Name="DateText"
                               Text="Gün, dd MMMM yyyy"
                               FontSize="13"
                               Foreground="#CBD5E1"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ASIL İÇERİK -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <!-- Dashboard özet kartları: Vize / Bilet / Kargo / Odalama -->
                <Grid Margin="0,6,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Vize Kartı -->
                    <Border Grid.Column="0" Background="#0B1220" CornerRadius="8" Padding="12" Margin="6,6,6,36">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock Text="Vize" Foreground="#E6EEF8" FontWeight="Bold" FontSize="14" />
                                    <TextBlock Text="  " />
                                    <TextBlock x:Name="VisaStatusText" Text="(Özet)" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                        <TextBlock Text="Vize Alacağız" Foreground="#CBD5E1" Width="160" />
                                        <TextBlock x:Name="VisaWillGetText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                        <TextBlock Text="Vizeyi Kendisi Alacak" Foreground="#CBD5E1" Width="160" />
                                        <TextBlock x:Name="VisaSelfGetText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                        <TextBlock Text="Vize Çıktı" Foreground="#CBD5E1" Width="160" />
                                        <TextBlock x:Name="VisaIssuedText" Text="0" Foreground="#7EE787" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                        <TextBlock Text="Vize Çıkmadı" Foreground="#CBD5E1" Width="160" />
                                        <TextBlock x:Name="VisaNotIssuedText" Text="0" Foreground="#FCA5A5" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                        <TextBlock Text="Vizesi Alınıyor" Foreground="#CBD5E1" Width="160" />
                                        <TextBlock x:Name="VisaInProgressText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                        <TextBlock Text="Pasaport Bekleniyor" Foreground="#CBD5E1" Width="160" />
                                        <TextBlock x:Name="PassportPendingText" Text="0" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                                        <TextBlock Text="Pasaport Geldi (Evet)" Foreground="#CBD5E1" Width="160" />
                                        <TextBlock x:Name="PassportArrivedYesText" Text="0" Foreground="#7EE787" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,2">
                                        <TextBlock Text="Pasaport Geldi (Hayır)" Foreground="#CBD5E1" Width="160" />
                                        <TextBlock x:Name="PassportArrivedNoText" Text="0" Foreground="#FCA5A5" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="VisaHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0" />
                            </StackPanel>
                    </Border>

                    <!-- Bilet Kartı -->
                    <Border Grid.Column="1" Background="#0B1220" CornerRadius="8" Padding="12" Margin="6" Height="120">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bilet" Foreground="#E6EEF8" FontWeight="Bold" FontSize="14" />
                                <TextBlock x:Name="TicketStatusText" Text="(Özet)" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel Width="60">
                                    <TextBlock Text="Bekleyen" Foreground="#CBD5E1" FontSize="12" />
                                    <TextBlock x:Name="TicketPendingText" Text="0" Foreground="#F59E0B" FontWeight="Bold" FontSize="16" />
                                </StackPanel>
                                <StackPanel Width="60" Margin="12,0,0,0">
                                    <TextBlock Text="Hazır" Foreground="#CBD5E1" FontSize="12" />
                                    <TextBlock x:Name="TicketReadyText" Text="0" Foreground="#7EE787" FontWeight="Bold" FontSize="16" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="TicketHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Kargo Kartı -->
                    <Border Grid.Column="2" Background="#0B1220" CornerRadius="8" Padding="12" Margin="6" Height="120">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Kargo" Foreground="#E6EEF8" FontWeight="Bold" FontSize="14" />
                                <TextBlock x:Name="CargoStatusText" Text="(Özet)" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel Width="60">
                                    <TextBlock Text="Bekleyen" Foreground="#CBD5E1" FontSize="12" />
                                    <TextBlock x:Name="CargoPendingText" Text="0" Foreground="#F59E0B" FontWeight="Bold" FontSize="16" />
                                </StackPanel>
                                <StackPanel Width="60" Margin="12,0,0,0">
                                    <TextBlock Text="Teslim" Foreground="#CBD5E1" FontSize="12" />
                                    <TextBlock x:Name="CargoDeliveredText" Text="0" Foreground="#7EE787" FontWeight="Bold" FontSize="16" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="CargoHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Oda Kartı -->
                    <Border Grid.Column="3" Background="#0B1220" CornerRadius="8" Padding="12" Margin="6" Height="120">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Odalama" Foreground="#E6EEF8" FontWeight="Bold" FontSize="14" />
                                <TextBlock x:Name="RoomAllocStatusText" Text="(Özet)" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel Width="80">
                                    <TextBlock Text="Rezerv" Foreground="#CBD5E1" FontSize="12" />
                                    <TextBlock x:Name="RoomAllocReservedText" Text="0" Foreground="#7EE787" FontWeight="Bold" FontSize="16" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="12,0,0,0">
                                    <TextBlock Text="Boş" Foreground="#CBD5E1" FontSize="12" />
                                    <TextBlock x:Name="RoomAllocAvailableText" Text="0" Foreground="#F59E0B" FontWeight="Bold" FontSize="16" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="RoomAllocHintText" Text="Son güncelleme: -" Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Diğer içerik yerleşimi (gerektiğinde buraya ek kartlar veya listeler eklenebilir) -->
            </StackPanel>
        </ScrollViewer>

        <!-- Rezerv alan: Analog ve tarih hizasına denk gelecek şekilde sağa yaslı, aşağıya kadar uzanan görünmez bölge -->

        <!-- ALT FOOTER -->
        <TextBlock Grid.Row="2"
                   Text="© 2026 Turizm Operasyon Sistemi — Tüm hakları saklıdır."
                   FontSize="12"
                   Foreground="#94A3B8"
                   Opacity="0.9"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,12,0,12" />

    </Grid>

</Page>
