<Window x:Class="TurizmOperasyonSistemi.Views.QRUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR ile Yükle" Height="420" Width="360" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Telefonla QR okutun" FontWeight="Bold" FontSize="16" />

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="QrImage" Width="240" Height="240" />
            <TextBlock x:Name="QrStatus" Text="Bağlantı bekleniyor..." Margin="0,8,0,0" HorizontalAlignment="Center" />
            <TextBox x:Name="QrTargetTextBox" IsReadOnly="True" Margin="0,8,0,0" Width="300" HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="İptal" Width="90" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
