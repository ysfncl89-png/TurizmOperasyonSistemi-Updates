<UserControl x:Class="TurizmOperasyonSistemi.Views.TourProfitabilityAnalysisWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TurizmOperasyonSistemi.Views"
             Background="#0F172A"
             Foreground="#E2E8F0">
    <UserControl.Resources>
        <!-- Local style for the export popup buttons (kept small and self-contained) -->
        <Style x:Key="ExportPopupButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#123046"/>
            <Setter Property="BorderBrush" Value="#8B5CF6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#2B76A6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="#2B76A6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Half-width converter for expense textboxes -->
        <local:HalfConverter x:Key="HalfConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TUR SEÇİMİ -->
            <Border Grid.Row="0"
                    Background="#111827"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="TUR SEÇİMİ" 
                               Foreground="#CBD5E1" 
                               FontWeight="SemiBold" 
                               FontSize="13"
                               Margin="0,0,0,8"/>
                    <ComboBox x:Name="TourComboBox"
                              Height="40"
                              IsEditable="False"
                              SelectionChanged="TourComboBox_SelectionChanged"
                              DisplayMemberPath="DisplayText"
                              TextSearch.TextPath="DisplayText"
                              Padding="8"
                              FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- TUR ÖZETİ -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,10,0" Background="#1F2937" BorderBrush="#8B5CF6" BorderThickness="2" CornerRadius="12" Padding="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TOPLAM SATIŞ" Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock x:Name="TotalPriceTextBlock" Text="-" Margin="0,8,0,0" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="10,0,10,0" Background="#1F2937" BorderBrush="#10B981" BorderThickness="2" CornerRadius="12" Padding="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TAHSIL EDILEN" Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock x:Name="TotalPaidTextBlock" Text="-" Margin="0,8,0,0" FontSize="20" FontWeight="Bold" Foreground="#6EE7B7" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="10,0,0,0" Background="#1F2937" BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="12" Padding="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BEKLEYEN TAHSILAT" Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock x:Name="TotalRemainingTextBlock" Text="-" Margin="0,8,0,0" FontSize="20" FontWeight="Bold" Foreground="#FBBF24" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- GİDERLER (SOL) | SONUÇ (SAĞ) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- SOL: GİDERLER -->
                <Border Grid.Column="0" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="GİDERLER" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>

                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="🏨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Otel ve Yemek Mekke" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HotelExpenseTextBox" Height="28" FontSize="11" Padding="6,3" TextChanged="ExpenseTextBox_TextChanged" Grid.Column="0"
                                         Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource HalfConverter}}"
                                         HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="$" Foreground="#10B981" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.95" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="🏨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Otel ve Yemek Medine" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HotelMedineExpenseTextBox" Height="28" FontSize="11" Padding="6,3" TextChanged="ExpenseTextBox_TextChanged" Grid.Column="0"
                                         Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource HalfConverter}}"
                                         HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="$" Foreground="#10B981" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.95" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="✈️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Uçak Bileti" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TicketExpenseTextBox" Height="28" FontSize="11" Padding="6,3" TextChanged="ExpenseTextBox_TextChanged" Grid.Column="0"
                                         Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource HalfConverter}}"
                                         HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="$" Foreground="#10B981" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.95" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="🛂" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Vize Masrafı" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VisaExpenseTextBox" Height="28" FontSize="11" Padding="6,3" TextChanged="ExpenseTextBox_TextChanged" Grid.Column="0"
                                         Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource HalfConverter}}"
                                         HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="$" Foreground="#10B981" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.95" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="🧳" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Çanta / Kitapçık" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BagExpenseTextBox" Height="28" FontSize="11" Padding="6,3" TextChanged="ExpenseTextBox_TextChanged" Grid.Column="0"
                                         Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource HalfConverter}}"
                                         HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="$" Foreground="#10B981" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.95" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="👥" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Eleman Gideri" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="StaffExpenseTextBox" Height="28" FontSize="11" Padding="6,3" TextChanged="ExpenseTextBox_TextChanged" Grid.Column="0"
                                         Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource HalfConverter}}"
                                         HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="$" Foreground="#10B981" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.95" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="📝" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Diğer Gider" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OtherExpenseTextBox" Height="28" FontSize="11" Padding="6,3" TextChanged="ExpenseTextBox_TextChanged" Grid.Column="0"
                                         Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource HalfConverter}}"
                                         HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="$" Foreground="#10B981" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SAĞ: SONUÇ -->
                <Border Grid.Column="1" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="12" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Çıktı Al Butonu -->
                        <Button x:Name="ExportButton" Grid.Row="0" Height="36" Background="#1F2937" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12" Click="ExportButton_Click" BorderBrush="#8B5CF6" BorderThickness="1">
                            <Button.ContextMenu>
                                <ContextMenu Foreground="#E2E8F0" Background="#1F2937">
                                    <MenuItem Header="Word'e İndir" Click="ExportWord_Click"/>
                                    <MenuItem Header="Excel'e İndir" Click="ExportExcel_Click"/>
                                    <MenuItem Header="PDF'ye İndir" Click="ExportPdf_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            📥 Çıktı Al
                        </Button>

                        <!-- Popup with large icon buttons (similar to PersonsGeneralView) -->
                        <Popup x:Name="ExportPopup"
                               PlacementTarget="{Binding ElementName=ExportButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">

                            <Border Background="#0B1220"
                                    CornerRadius="10"
                                    Padding="12"
                                    BorderBrush="#334155"
                                    BorderThickness="1">

                                <Border.Effect>
                                    <DropShadowEffect Color="#000000"
                                                      BlurRadius="18"
                                                      ShadowDepth="0"
                                                      Opacity="0.25"/>
                                </Border.Effect>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <!-- WORD -->
                                    <Button x:Name="PopupWordButton"
                                            Style="{StaticResource ExportPopupButtonStyle}"
                                            Click="ExportWord_Click"
                                            Width="110"
                                            Height="110"
                                            Margin="6"
                                            Cursor="Hand">

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                            <Image Source="pack://application:,,,/Assets/Icons/word.png"
                                                   Width="40"
                                                   Height="40"
                                                   HorizontalAlignment="Center"/>

                                            <TextBlock Text="Word"
                                                       Foreground="#E2F8FF"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>

                                            <TextBlock Text="İndir"
                                                       Foreground="#9CAFC0"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- EXCEL -->
                                    <Button x:Name="PopupExcelButton"
                                            Style="{StaticResource ExportPopupButtonStyle}"
                                            Click="ExportExcel_Click"
                                            Width="110"
                                            Height="110"
                                            Margin="6"
                                            Cursor="Hand">

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                            <Image Source="pack://application:,,,/Assets/Icons/excel.png"
                                                   Width="40"
                                                   Height="40"
                                                   HorizontalAlignment="Center"/>

                                            <TextBlock Text="Excel"
                                                       Foreground="#E2F8FF"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>

                                            <TextBlock Text="İndir"
                                                       Foreground="#9CAFC0"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- PDF -->
                                    <Button x:Name="PopupPdfButton"
                                            Style="{StaticResource ExportPopupButtonStyle}"
                                            Click="ExportPdf_Click"
                                            Width="110"
                                            Height="110"
                                            Margin="6"
                                            Cursor="Hand">

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                            <Image Source="pack://application:,,,/Assets/Icons/pdf.png"
                                                   Width="40"
                                                   Height="40"
                                                   HorizontalAlignment="Center"/>

                                            <TextBlock Text="PDF"
                                                       Foreground="#E2F8FF"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>

                                            <TextBlock Text="İndir"
                                                       Foreground="#9CAFC0"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                </StackPanel>
                            </Border>
                        </Popup>

                        <StackPanel Grid.Row="1">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="TOPLAM MALİYET" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TotalExpenseTextBlock" Text="-" FontSize="20" FontWeight="Bold" Foreground="#10B981" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="NET KÂR" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TotalProfitLossTextBlock" Text="-" FontSize="20" FontWeight="Bold" Foreground="#10B981" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"><Run Text="TAHSİLATA GÖRE"/><Run Text=" NET K"/><Run Language="tr-tr" Text="Â"/><Run Text="R"/></TextBlock>
                                <TextBlock x:Name="InstantProfitLossTextBlock" Text="-" FontSize="20" FontWeight="Bold" Foreground="#10B981" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"><Run Text="KAR MARJI (NET K"/><Run Language="tr-tr" Text="Â"/><Run Text="R)"/></TextBlock>
                                <TextBlock x:Name="ProfitMarginTextBlock" Text="-" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"><Run Text="MALİYET BAZLI KAR ORANI (NET K"/><Run Language="tr-tr" Text="Â"/><Run Text="R)"/></TextBlock>
                                <TextBlock x:Name="ProfitRateTextBlock" Text="-" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"><Run Text="KAR MARJI (TAHSIL"/><Run Language="tr-tr" Text="ATA "/><Run Text="GÖRE)"/></TextBlock>
                                <TextBlock x:Name="InstantProfitMarginTextBlock" Text="-" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"><Run Text="MALİYET BAZLI KAR ORANI (TAHSI"/><Run Language="tr-tr" Text="LATA "/><Run Text="GÖRE)"/></TextBlock>
                                <TextBlock x:Name="InstantProfitRateTextBlock" Text="-" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock x:Name="HintTextBlock" Text="Henüz bir tur seçilmedi." Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,0" Visibility="Visible"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
