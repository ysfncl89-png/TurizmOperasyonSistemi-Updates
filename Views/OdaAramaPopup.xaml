<Window x:Class="TurizmOperasyonSistemi.Views.OdaAramaPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kayıt Arama" Height="560" Width="900" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#0F172A">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchTextBox" Grid.Row="0" Height="36" Margin="0,0,0,8" Padding="10"
                 Background="#1E293B" Foreground="White" BorderBrush="#475569" BorderThickness="1"
                 ToolTip="Ara: Ad Soyad, TC, Otel veya Diğer..." TextChanged="SearchTextBox_TextChanged"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="TourTypeFilter" Height="34" SelectionChanged="Filter_Changed" Margin="0,0,8,0" Grid.Column="0"/>
            <ComboBox x:Name="PeriodFilter" Height="34" SelectionChanged="Filter_Changed" Margin="0,0,8,0" Grid.Column="1"/>
            <ComboBox x:Name="GroupTypeFilter" Height="34" SelectionChanged="Filter_Changed" Margin="0,0,8,0" Grid.Column="2"/>
            <ComboBox x:Name="DaysFilter" Height="34" SelectionChanged="Filter_Changed" Margin="0,0,8,0" Grid.Column="3"/>
            <ComboBox x:Name="HotelFilter" Height="34" SelectionChanged="Filter_Changed" Grid.Column="4"/>
        </Grid>

        <DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" HeadersVisibility="Column"
                  Background="Transparent" RowBackground="#0F172A" AlternatingRowBackground="#1E293B"
                  Foreground="White" BorderThickness="0" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Otel" Binding="{Binding HotelName}" Width="1.3*"/>
                <DataGridTextColumn Header="Tur Türü" Binding="{Binding TourType}" Width="1*"/>
                <DataGridTextColumn Header="Dönem" Binding="{Binding Period}" Width="1*"/>
                <DataGridTextColumn Header="Grup Türü" Binding="{Binding GroupType}" Width="1*"/>
                <DataGridTextColumn Header="Grup Gün Sayısı" Binding="{Binding DaysCount}" Width="0.8*"/>
                <DataGridTextColumn Header="Oda Sayısı" Binding="{Binding RoomCount}" Width="0.8*"/>
                <DataGridTextColumn Header="Oda Listesi" Binding="{Binding RoomSummary}" Width="1.4*"/>
                <DataGridTextColumn Header="Kişi Sayısı" Binding="{Binding OccupantCount}" Width="0.6*"/>
                <DataGridTextColumn Header="Yerleşen Kişiler" Binding="{Binding OccupantNames}" Width="2.2*"/>
                <DataGridTemplateColumn Header="İşlem" Width="1.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Düzenle" Click="EditButton_Click" Margin="0,0,6,0" Padding="6,2" Background="#2563EB" Foreground="White"/>
                                <Button Content="Kaydı Sil" Click="DeleteButton_Click" Padding="6,2" Background="#DC2626" Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Kapat" Width="100" Padding="8" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>