<Window x:Class="TurizmOperasyonSistemi.Windows.MigrationDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TurizmOperasyonSistemi"
        Title="Migration Dashboard" 
        Height="700" 
        Width="1200" 
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FontFamily="Segoe UI">

    <Window.Resources>
        <local:BoolToColorConverter x:Key="BoolToColorConverter" />
        <local:BoolToBackgroundConverter x:Key="BoolToBackgroundConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="StatusOKStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StatusWarningStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9800"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StatusFailStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F44336"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E868D0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Navigation Bar -->
        <Grid Background="#2C3E50" Height="60" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                <TextBlock Text="🔧 Turizm Operasyon - Migration Dashboard" 
                           Foreground="White" 
                           FontSize="16" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LastCheckedAt, StringFormat='Updated: {0:HH:mm:ss}'}" 
                           Foreground="#BDC3C7" 
                           FontSize="12"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="✕ Close" 
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Margin="0,0,20,0"
                    Style="{StaticResource ButtonStyle}"
                    Width="80"/>
        </Grid>

        <!-- Main Content -->
        <TabControl Margin="0,60,0,0">
            <!-- TAB 1: Health Status -->
            <TabItem Header="📊 Health Status">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <!-- Status Summary -->
                        <Border Style="{StaticResource CardStyle}" Background="#F9F9F9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="STATUS" FontSize="11" Foreground="#999" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DatabaseStatus}" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"
                                               Foreground="{Binding IsHealthy, Converter={StaticResource BoolToColorConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                    <TextBlock Text="FAILURES" FontSize="11" Foreground="#999" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding FailedChecks}" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"
                                               Foreground="#F44336"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,20,0">
                                    <TextBlock Text="WARNINGS" FontSize="11" Foreground="#999" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding WarningChecks}" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"
                                               Foreground="#FF9800"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="MESSAGE" FontSize="11" Foreground="#999" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding StatusMessage}" 
                                               FontSize="12" 
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#666"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Database Info -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="DATABASE INFORMATION" Style="{StaticResource HeaderStyle}"/>
                                <TextBlock Text="Path:" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding DatabasePath}" FontSize="11" Foreground="#999" Margin="0,2,0,10"/>
                                <TextBlock Text="Size:" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding DatabaseSize}" FontSize="11" Foreground="#999"/>
                            </StackPanel>
                        </Border>

                        <!-- Refresh Button -->
                        <Button Content="🔄 Refresh Health Check" 
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource ButtonStyle}"
                                Padding="20,12"
                                FontSize="13"
                                Margin="0,0,0,15"/>

                        <!-- Health Checks List -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="DETAILED CHECKS" Style="{StaticResource HeaderStyle}"/>
                                <ListBox ItemsSource="{Binding HealthChecks}" 
                                         BorderThickness="0"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="#EEE" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding Status}" 
                                                               Foreground="{Binding StatusColor}"
                                                               FontWeight="Bold"
                                                               FontSize="11"/>
                                                    <TextBlock Grid.Column="1" 
                                                               Text="{Binding CheckName}" 
                                                               Foreground="#333"
                                                               FontWeight="SemiBold"
                                                               Margin="10,0,0,0"/>
                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding Message}" 
                                                               Foreground="#666"
                                                               TextWrapping="Wrap"
                                                               Margin="20,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Backups & Rollback -->
            <TabItem Header="💾 Backups">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,10,20,0">
                                    <Button Content="▶ Run Migrations" Command="{Binding RunMigrationsCommand}" Style="{StaticResource ButtonStyle}" Padding="10,6" Margin="0,0,8,0"/>
                                    <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource ButtonStyle}" Padding="10,6"/>
                                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <!-- Rollback Availability -->
                        <Border Style="{StaticResource CardStyle}" 
                                Background="{Binding CanRollback, Converter={StaticResource BoolToBackgroundConverter}}">
                            <StackPanel>
                                <TextBlock Text="ROLLBACK STATUS" Style="{StaticResource HeaderStyle}"/>
                                <TextBlock Text="{Binding RollbackReason}" 
                                           FontSize="13" 
                                           Foreground="{Binding CanRollback, Converter={StaticResource BoolToColorConverter}}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Available Backups -->
                        <TextBlock Text="AVAILABLE BACKUPS" Style="{StaticResource HeaderStyle}" Margin="0,20,0,10"/>

                        <ListBox ItemsSource="{Binding AvailableBackups}" 
                                BorderThickness="0"
                                Background="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#EEE" Padding="15,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding FileName}" 
                                                       Foreground="#333"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Size}" 
                                                       Foreground="#666"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding CreatedAtFormatted}" 
                                                       Foreground="#999"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" 
                                                    Content="⟲ Restore"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.RollbackCommand}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ButtonStyle}"
                                                    Padding="10,6"
                                                    FontSize="11"
                                                    HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="⚠ Backup seçip 'Restore' butonuna tıklayarak önceki versiyona dönebilirsiniz." 
                                   Foreground="#FF9800" 
                                   FontSize="11"
                                   Margin="0,15,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                    </DockPanel>
            </TabItem>

            <!-- TAB 3: Migration Logs -->
            <TabItem Header="📝 Migration Logs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="RECENT MIGRATION OPERATIONS" Style="{StaticResource HeaderStyle}"/>

                        <ListBox ItemsSource="{Binding MigrationLogs}" 
                                 BorderThickness="0"
                                 Background="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#EEE" Padding="15,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" 
                                                     Width="12" 
                                                     Height="12"
                                                     Fill="{Binding StatusColor}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Operation}" 
                                                       Foreground="#333"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Message}" 
                                                       Foreground="#666"
                                                       TextWrapping="Wrap"
                                                       Margin="20,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" 
                                                       Text="{Binding CreatedAtFormatted}" 
                                                       Foreground="#999"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Loading Indicator Overlay -->
        <Grid Background="#000000" Opacity="0.3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Processing..." Foreground="White" FontSize="14" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
