<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Disable SDK auto-generation of assembly attributes to avoid duplicate attribute errors
         Project already contains some assembly attributes (ThemeInfo etc.) and the SDK also
         generates AssemblyInfo during publish which can lead to CS0579 duplicate attribute errors.
         Setting GenerateAssemblyInfo to false stops the SDK from emitting those attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Prevent SDK from generating TargetFrameworkAttribute to avoid duplicate attribute errors
         Some build/temp files can cause TargetFrameworkAttribute to be emitted twice; disabling
         generation ensures only a single definition exists. -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Use custom application manifest to enable PerMonitorV2 DPI awareness -->
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\TurizmOperasyonSistemi.ico</ApplicationIcon>
    <!-- Publish/version metadata -->
    <Version>1.0.0.3</Version>
    <FileVersion>1.0.0.3</FileVersion>
    <InformationalVersion>1.0.0.3</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Views\SettingDialogCities.xaml.cs" />
  </ItemGroup>

  <!-- Exclude tools/Updater source files from main project compile to keep Updater as separate project -->
  <ItemGroup>
    <Compile Remove="tools\\**\\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Icons\Ekran görüntüsü 2026-06-01 202907.png" />
    <None Remove="Assets\Icons\Ekran görüntüsü 2026-06-01 202919.png" />
    <None Remove="Assets\Icons\Ekran görüntüsü 2026-06-01 202930.png" />
    <None Remove="Assets\Icons\excel.png" />
    <None Remove="Assets\Icons\pdf.png" />
    <None Remove="Assets\Icons\word.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Views\SettingDialogCities.xaml" />
  </ItemGroup>

  <!-- Exclude test helper top-level Program from build so WPF App.xaml entry point runs -->
  <ItemGroup>
    <Compile Remove="TestApp\Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Themes\" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="tools\IntegrationTester\IntegrationTester.csproj" />
    <None Include="tools\SmokeTester\SmokeTester.csproj" />
    <None Include="tools\Updater\Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.27" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.27" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.27">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" Version="1.7.4" />
    <PackageReference Include="QuestPDF" Version="2026.7.0" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tüm arka plan PNG dosyalarını otomatik dahil et -->
    <Resource Include="Assets\Backgrounds\**\*.png" />
    <Resource Include="Assets\Icons\excel.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Icons\pdf.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Icons\word.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Models\Registration.cs">
      <Generator>MSBuild:Compile</Generator>
    </Compile>
  </ItemGroup>

</Project>