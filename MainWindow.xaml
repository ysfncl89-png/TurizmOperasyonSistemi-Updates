<Window x:Class="TurizmOperasyonSistemi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TurizmOperasyonSistemi.Views"
        Title="Turizm Operasyon Sistemi"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Grid>
        <Grid.Resources>

            <Style x:Key="MenuButtonStyle" TargetType="Button">

                <Setter Property="Height" Value="50"/>
                <Setter Property="Margin" Value="15,10"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="#1F2937"/>
                <Setter Property="BorderBrush" Value="#334155"/>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">

                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="border"
                                    Property="BorderBrush"
                                    Value="#38BDF8"/>

                                    <Setter TargetName="border"
                                    Property="Effect">

                                        <Setter.Value>

                                            <DropShadowEffect
                                        BlurRadius="20"
                                        ShadowDepth="0"
                                        Color="#38BDF8"
                                        Opacity="0.7"/>

                                        </Setter.Value>

                                    </Setter>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>

        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL MENÜ -->

        <Border Background="#111827">

            <StackPanel>

                <TextBlock Text="TURİZM"
                           Foreground="#38BDF8"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="20,30,20,10"/>

                <TextBlock Text="Operasyon Sistemi"
                           Foreground="White"
                           FontSize="14"
                           Margin="20,0,20,30"/>

                <!-- MENÜLER -->

                <Button x:Name="HomeButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Content="Anasayfa"
                        Height="50"
                        Margin="15,10"
                        Background="#06B6D4"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="HomeButton_Click"/>

                <Button x:Name="PersonsButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Content="Kişiler"
                        Height="50"
                        Margin="15,10"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="PersonsButton_Click"/>



                <Button x:Name="RegistrationButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Content="Kayıt Modülü"
                        Height="50"
                        Margin="15,10"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="RegistrationButton_Click"/>


                <Button x:Name="HotelAllocationButton" 
        Click="HotelAllocationButton_Click"
        Style="{StaticResource MenuButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛏️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Otel Odalama" FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ListsButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Content="Listeler"
                        Height="50"
                        Margin="15,10"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="ListsButton_Click"/>

                <Button x:Name="SettingsButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Content="Ayarlar"
                        Height="50"
                        Margin="15,10"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="SettingsButton_Click"/>

            </StackPanel>

        </Border>

        <!-- CONTENT AREA -->

        <Grid Grid.Column="1"
              Margin="20">

            <Border Background="#1E293B"
                    CornerRadius="20">

                <Frame x:Name="MainFrame"
                       NavigationUIVisibility="Hidden"/>

            </Border>

        </Grid>

    </Grid>

</Window>