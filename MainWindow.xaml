<Window x:Class="TurizmOperasyonSistemi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TurizmOperasyonSistemi.Views"
        xmlns:local="clr-namespace:TurizmOperasyonSistemi"
        Title="Turizm Operasyon Sistemi"
        MinHeight="700"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Loaded="MainWindow_Loaded"
        Background="#0F172A">

 
    <Grid>
        <Grid.Resources>

            <Style x:Key="MenuButtonStyle" TargetType="Button">

                <Setter Property="Height" Value="50"/>
                <Setter Property="Margin" Value="15,10"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="#1F2937"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <!-- Tutarlı içerik hizalamaları ve iç bosluk -->
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">

                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="border"
                                    Property="BorderBrush"
                                    Value="#38BDF8"/>

                                    <Setter TargetName="border"
                                    Property="Effect">

                                        <Setter.Value>

                                            <DropShadowEffect
                                        BlurRadius="20"
                                        ShadowDepth="0"
                                        Color="#38BDF8"
                                        Opacity="0.7"/>

                                        </Setter.Value>

                                    </Setter>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>

            <local:WidthToVisibilityConverter x:Key="WidthToVisibilityConverter"/>
            <local:InverseWidthToVisibilityConverter x:Key="InverseWidthToVisibilityConverter"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL MENÜ -->

        <Border x:Name="LeftMenu" Background="#111827" Width="80">

            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LeftMenu"
                                             Storyboard.TargetProperty="Width"
                                             To="260"
                                             Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LeftMenu"
                                             Storyboard.TargetProperty="Width"
                                             To="80"
                                             Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <StackPanel>

                <TextBlock Text="TOS Lite "
                           Foreground="#38BDF8"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="20,30,20,10"
                           Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource WidthToVisibilityConverter}}"/>

                <TextBlock Text="Turizm Operasyon Sistemi"
                           Foreground="#D1D5DB"
                           FontSize="12"
                           Margin="20,0,20,10"
                           Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource WidthToVisibilityConverter}}"/>

                <!-- Collapsed state icon -->
                <TextBlock Text="➥"
                           Foreground="#38BDF8"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="8,30,8,10"
                           HorizontalAlignment="Center"
                           Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource InverseWidthToVisibilityConverter}}"/>

                <!-- MENÜLER -->

                <Button x:Name="HomeButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Height="50"
                        Margin="15,10"
                        Background="#06B6D4"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="HomeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Anasayfa" FontSize="14" VerticalAlignment="Center" Foreground="White"
                                   Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource WidthToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="PersonsButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Height="50"
                        Margin="15,10"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="PersonsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👨🏻‍💼" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Kişiler" FontSize="14" VerticalAlignment="Center" Foreground="White"
                                   Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource WidthToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>


                <Button x:Name="RegistrationButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Height="50"
                        Margin="15,10"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="RegistrationButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✚" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tur Kayıt" FontSize="14" VerticalAlignment="Center" Foreground="White"
                                   Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource WidthToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="HotelAllocationButton" 
                        Click="HotelAllocationButton_Click"
                        Style="{StaticResource MenuButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛏️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Odalama Motoru" FontSize="14" VerticalAlignment="Center" Foreground="White"
                                   Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource WidthToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

                <!-- Yeni: Ödemeler ve Finans butonu -->
                <Button x:Name="PaymentsButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Height="50"
                        Margin="15,10"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="PaymentsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💳" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ödemeler ve Finans" FontSize="14" VerticalAlignment="Center" Foreground="White"
                                   Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource WidthToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

                <!-- Yeni: Kargo İşlemleri butonu -->
                <Button x:Name="CargoButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Height="50"
                        Margin="15,10"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="CargoButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Kargo İşlemleri" FontSize="14" VerticalAlignment="Center" Foreground="White"
                                   Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource WidthToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ListsButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Height="50"
                        Margin="15,10"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="ListsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔎" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Listeler" FontSize="14" VerticalAlignment="Center" Foreground="White"
                                   Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource WidthToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SettingsButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Height="50"
                        Margin="15,10"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Click="SettingsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔧" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ayarlar" FontSize="14" VerticalAlignment="Center" Foreground="White"
                                   Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource WidthToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="UserManagementButton"
                        Style="{StaticResource MenuButtonStyle}"
                        Height="50"
                        Margin="15,10"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        Visibility="Collapsed"
                        Click="UserManagementButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👥" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Kullanıcı Yönetimi" FontSize="14" VerticalAlignment="Center" Foreground="White"
                                   Visibility="{Binding ElementName=LeftMenu, Path=ActualWidth, Converter={StaticResource WidthToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

            </StackPanel>

        </Border>

        <!-- CONTENT AREA -->

        <Grid Grid.Column="1"
              Margin="20">

            <Border Background="#1E293B"
                    CornerRadius="20">

                <Frame x:Name="MainFrame"
                       NavigationUIVisibility="Hidden"/>

            </Border>

        </Grid>

    </Grid>

</Window>