{
    "Database": {
        "EnableBackup": true,
        "EnableLogging": true,
        "EnableLocking": true,
        "BackupOnStartup": true
    },
    "Backup": {
        "MaxBackups": 10,
        "RetentionDays": 10,
        "MaxBackupSizeMB": 500,
        "CompressionEnabled": false
    },

    "Migration": {
        "LockTimeoutSeconds": 300,
        "MaxRetryAttempts": 3,
        "RetryDelayMs": 1000,
        "AllowRollback": true,
        "ValidateSchemaOnStartup": true
    },
    "Logging": {
        "MaxLogFileSizeMB": 5,
        "MaxLogFiles": 10,
        "LogLevel": "Information"
    },
    "HealthCheck": {
        "EnableOnStartup": true,
        "MinimumDiskSpaceRequired_MB": 10,
        "CheckOrphanedData": true,
        "CheckSchemaIntegrity": true,
        "CheckBackupDirectory": true
    },
    "Dashboard": {
        "ShowMigrationDashboard": true,
        "AutoRefreshSeconds": 5,
        "ShowDetailedLogs": true
    },
    "Updates": {
        "Enabled": true,
        "RepositoryUrl": "https://github.com/ysfncl89-png/TurizmOperasyonSistemi-Updates",
        "CheckIntervalMinutes": 60,
        "AllowPrerelease": false
    }
}