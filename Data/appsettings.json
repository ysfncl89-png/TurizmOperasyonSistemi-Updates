{
  "Database": {
    "Path": "C:\\TurizmDB\\turizm.db",
    "EnableBackup": true,
    "EnableLogging": true,
    "EnableLocking": true,
    "BackupOnStartup": true
  },
  "Backup": {
    "Directory": "C:\\TurizmDB\\backups",
    "MaxBackups": 10,
    "RetentionDays": 10,
    "MaxBackupSizeMB": 500,
    "CompressionEnabled": false
  },

  "Migration": {
    "LockTimeoutSeconds": 300,
    "MaxRetryAttempts": 3,
    "RetryDelayMs": 1000,
    "AllowRollback": true,
    "ValidateSchemaOnStartup": true
  },
  "Logging": {
    "Directory": "C:\\TurizmDB\\logs",
    "MaxLogFileSizeMB": 5,
    "MaxLogFiles": 10,
    "LogLevel": "Information"
  },
  "HealthCheck": {
    "EnableOnStartup": true,
    "MinimumDiskSpaceRequired_MB": 10,
    "CheckOrphanedData": true,
    "CheckSchemaIntegrity": true,
    "CheckBackupDirectory": true
  },
  "Dashboard": {
    "ShowMigrationDashboard": true,
    "AutoRefreshSeconds": 5,
    "ShowDetailedLogs": true
  }
  ,
  "Update": {
    "Enabled": false,
    "ManifestUrl": "",
    "CheckIntervalSeconds": 86400,
    "Channel": "stable",
    "AutoDownload": true,
    "AutoInstall": false,
    "RetryCount": 3,
    "CheckIntervalHours": 24
  }
}