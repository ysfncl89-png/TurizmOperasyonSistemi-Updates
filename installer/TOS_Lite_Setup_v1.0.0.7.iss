; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "TOS Lite"
#define MyAppVersion "1.0.0.8"
#define MyAppPublisher "Turizm Operasyon Sistemi"
#define MyAppURL "https://github.com/yusufoncel/TurizmOperasyonSistemi"
#define MyAppExeName "TurizmOperasyonSistemi.exe"
#define SourcePath "..\publish_win-x64\TurizmOperasyonSistemi.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{A1B2C3D4-E5F6-47A8-9B0C-1D2E3F4A5B6C}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\TOS Lite
DefaultGroupName=TOS Lite
AllowNoIcons=yes
LicenseFile=..\LICENSE
; Uncomment the following line to run the post install step as an administrator.
; PostInstallActions=admin
DisableProgramGroupPage=no
; Remove the following line to run in administrative install mode.
PrivilegesRequired=lowest
PrivilegesRequiredOverride=lowest
OutputDir={#SourcePath|Extract|GetFilePath}\..\installer_output
OutputBaseFilename=TOS_Lite_Setup_v{#MyAppVersion}
SetupIconFile=..\Assets\Icons\TurizmOperasyonSistemi.ico
Compression=lz4
SolidCompression=yes
WizardStyle=modern
WizardResizable=yes
UninstallDisplayIcon={app}\{#MyAppExeName}
UninstallDisplayName={#MyAppName} {#MyAppVersion}

; VersionInfoVersion should only be used on Windows
VersionInfoVersion={#MyAppVersion}
VersionInfoCompany={#MyAppPublisher}
VersionInfoDescription=TOS Lite - Turizm Operasyon Sistemi
VersionInfoTextVersion={#MyAppVersion}
VersionInfoOriginalFileName=TOS_Lite_Setup_v{#MyAppVersion}.exe

[Languages]
Name: "turkish"; MessagesFile: "compiler:Languages\Turkish.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "..\publish_win-x64\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\TurizmOperasyonSistemi.exe"; Comment: "TOS Lite - Turizm Operasyon Sistemi v{#MyAppVersion}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\TurizmOperasyonSistemi.exe"; Comment: "TOS Lite - Turizm Operasyon Sistemi v{#MyAppVersion}"

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
procedure InitializeWizard;
var
  WizardForm: TSetupForm;
begin
  // Custom welcome message
  WizardForm := TSetupForm(SetupForm);
  if WizardForm <> nil then
  begin
    WizardForm.WizardSmallBitmapImage.Bitmap.LoadFromFile(ExpandConstant('{#SourcePath|Extract|GetFileDir}\..\Assets\Icons\TurizmOperasyonSistemi.ico'));
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    MsgBox('TOS Lite v{#MyAppVersion} başarıyla kurulmuştur.' + #13#10 + 'Uygulamayı başlatabilirsiniz.', mbInformation, MB_OK);
  end;
end;
