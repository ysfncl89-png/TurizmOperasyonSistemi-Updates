<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TOSLite.Mobile.Views.ListsPage"
             Title="Listeler"
             BackgroundColor="{StaticResource PageBackground}">
    <ContentPage.Resources>
        <Style x:Key="ListTypeButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" />
            <Setter Property="TextColor" Value="{StaticResource SecondaryDarkText}" />
            <Setter Property="BorderColor" Value="{StaticResource Secondary}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinimumHeightRequest" Value="50" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*" Padding="18" RowSpacing="14">
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label Text="Listeler" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
            <Label Text="Görüntülemek istediğiniz listeyi seçin." FontSize="14" TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <ScrollView x:Name="DashboardPanel">
                <VerticalStackLayout Spacing="16" Padding="0,2,0,20">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Kişisel bilgiler" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="Telefon listesi" Style="{StaticResource ListTypeButton}" CommandParameter="Phone" Clicked="OnListTypeClicked" />
                                <Button Grid.Column="1" Text="Sağlık listesi" Style="{StaticResource ListTypeButton}" CommandParameter="Health" Clicked="OnListTypeClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Tur kayıtları" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                <Button Text="Genel" Style="{StaticResource ListTypeButton}" CommandParameter="TourGeneral" Clicked="OnListTypeClicked" />
                                <Button Grid.Column="1" Text="Vize" Style="{StaticResource ListTypeButton}" CommandParameter="Visa" Clicked="OnListTypeClicked" />
                                <Button Grid.Row="1" Text="Pasaport" Style="{StaticResource ListTypeButton}" CommandParameter="Passport" Clicked="OnListTypeClicked" />
                                <Button Grid.Row="1" Grid.Column="1" Text="Bilet" Style="{StaticResource ListTypeButton}" CommandParameter="Ticket" Clicked="OnListTypeClicked" />
                                <Button Grid.Row="2" Text="Aktarma" Style="{StaticResource ListTypeButton}" CommandParameter="Transfer" Clicked="OnListTypeClicked" />
                                <Button Grid.Row="2" Grid.Column="1" Text="Havayolu" Style="{StaticResource ListTypeButton}" CommandParameter="Airline" Clicked="OnListTypeClicked" />
                                <Button Grid.Row="3" Text="Referans" Style="{StaticResource ListTypeButton}" CommandParameter="Reference" Clicked="OnListTypeClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                <Label Text="Oda listesi" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Otel ve tur kriterlerine göre odaları görüntüleyin." FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Aç  →" Style="{StaticResource ListTypeButton}" CommandParameter="Rooms" Clicked="OnListTypeClicked" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                <Label Text="Ödeme listesi" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Dönem ve tur kriterlerine göre ödemeleri görüntüleyin." FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Aç  →" Style="{StaticResource ListTypeButton}" CommandParameter="Payments" Clicked="OnListTypeClicked" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                <Label Text="Kargo listesi" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Dönem ve kargo talebine göre kayıtları görüntüleyin." FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Aç  →" Style="{StaticResource ListTypeButton}" CommandParameter="Cargo" Clicked="OnListTypeClicked" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Grid x:Name="ResultsPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Text="‹ Türler" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Padding="4,8" Clicked="OnBackToCategoriesClicked" />
                    <Label x:Name="ResultsTitle" Grid.Column="1" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                </Grid>
                <VerticalStackLayout Grid.Row="1" Spacing="8">
                    <VerticalStackLayout x:Name="HotelFilterPanel" IsVisible="False" Spacing="2">
                        <Label Text="Otel" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Picker x:Name="HotelPicker" Title="Otel seçin" ItemDisplayBinding="{Binding .}" SelectedIndexChanged="OnFilterChanged" />
                    </VerticalStackLayout>
                    <Grid x:Name="CriteriaFilters" IsVisible="False" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Tur türü" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Picker x:Name="TourTypePicker" Title="Tümü" SelectedIndexChanged="OnFilterChanged" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Dönem" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Picker x:Name="PeriodPicker" Title="Tümü" SelectedIndexChanged="OnFilterChanged" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Spacing="2">
                            <Label Text="Grup türü" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Picker x:Name="GroupTypePicker" Title="Tümü" SelectedIndexChanged="OnFilterChanged" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label Text="Gün sayısı" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Picker x:Name="DaysPicker" Title="Tümü" SelectedIndexChanged="OnFilterChanged" />
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout x:Name="ExtraFilterPanel" IsVisible="False" Spacing="4">
                        <Label x:Name="ExtraFilterLabel" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Picker x:Name="ExtraFilterPicker" Title="Tümü" SelectedIndexChanged="OnFilterChanged" />
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="SecondaryFilterPanel" IsVisible="False" Spacing="4">
                        <Label x:Name="SecondaryFilterLabel" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Picker x:Name="SecondaryFilterPicker" Title="Tümü" SelectedIndexChanged="OnFilterChanged" />
                    </VerticalStackLayout>
                    <Entry x:Name="SearchEntry" Placeholder="Listede ara" TextChanged="OnSearchTextChanged" />
                </VerticalStackLayout>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label x:Name="StatusLabel" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    <Button x:Name="ExportButton" Grid.Column="1" Text="↓ İndir" BackgroundColor="{StaticResource Primary}" TextColor="White" FontAttributes="Bold" CornerRadius="12" Padding="18,8" MinimumHeightRequest="42" Clicked="OnExportClicked" />
                </Grid>
                <CollectionView x:Name="ResultsCollection" Grid.Row="3" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                            <Label Text="Bu kriterlerle eşleşen kayıt bulunamadı." FontSize="15" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding Subtitle}" FontSize="13" TextColor="{StaticResource Primary}" />
                                    <Label Text="{Binding Detail}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Context}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
