<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TOSLite.Mobile.Views.RegistrationFormPage"
             Title="Tur Kaydı"
             BackgroundColor="#F6F7FB">
    <Grid RowDefinitions="Auto,*,Auto" Padding="18" RowSpacing="10">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="‹ Tur Kayıtları" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="#6D4AFF" Clicked="OnBackToListClicked" />
            <Label x:Name="StepHeading" FontSize="22" FontAttributes="Bold" TextColor="#24213A" />
            <ProgressBar x:Name="StepProgress" Progress="0.1" ProgressColor="#6D4AFF" BackgroundColor="#E4E6EF" />
            <Label x:Name="ValidationLabel" IsVisible="False" TextColor="#B42336" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">
                <VerticalStackLayout x:Name="Step1Layout" Spacing="10">
                    <Label Text="1. Kişi Seçimi" FontSize="18" FontAttributes="Bold" TextColor="#24213A" />
                    <Entry x:Name="PersonSearchEntry"
                           Placeholder="Ad, soyad veya TC kimlik no ile arayın"
                           PlaceholderColor="#687083"
                           TextColor="#24213A"
                           BackgroundColor="White"
                           TextChanged="OnPersonSearchChanged" />
                    <Label x:Name="PersonSearchStatusLabel" Text="Kişi aramak için yazmaya başlayın." TextColor="#687083" FontSize="12" />
                    <CollectionView x:Name="PersonsCollection"
                                    SelectionMode="Single"
                                    SelectionChanged="OnPersonSelected"
                                    HeightRequest="300">
                        <CollectionView.EmptyView>
                            <Label Text="Eşleşen kişi bulunamadı. Yeni kişi ekleyebilirsiniz."
                                   TextColor="#687083"
                                   Margin="8" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#E4E6EF" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="12" Margin="0,3">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding FirstName}" TextColor="#24213A" FontAttributes="Bold" />
                                            <Label Text="{Binding LastName}" TextColor="#687083" />
                                            <Label Text="{Binding TcKimlikNo, StringFormat='Kimlik No: {0}'}" TextColor="#687083" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="Seç" TextColor="#6D4AFF" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="SelectedPersonLabel" IsVisible="False" TextColor="#16875D" FontAttributes="Bold" />
                    <Button Text="Aradığım kişi yok — Kimlik bilgilerini ekle" BackgroundColor="#16875D" TextColor="White" Clicked="OnAddPersonClicked" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Step2Layout" IsVisible="False" Spacing="10">
                    <Label Text="2. Tur ve Grup Bilgileri" FontSize="18" FontAttributes="Bold" TextColor="#24213A" />
                    <Label Text="Tur Türü *" TextColor="#687083" /><Picker x:Name="TourTypePicker" Title="Tur türü seçin" TextColor="#24213A" />
                    <Label Text="Dönem *" TextColor="#687083" /><Picker x:Name="PeriodPicker" Title="Dönem seçin" TextColor="#24213A" />
                    <Label Text="Grup Türü *" TextColor="#687083" /><Picker x:Name="GroupTypePicker" Title="Grup türü seçin" TextColor="#24213A" />
                    <Label Text="Grup Süresi (Gün) *" TextColor="#687083" /><Picker x:Name="DaysCountPicker" Title="Süre seçin" TextColor="#24213A" />
                    <Label Text="* Dört alan da zorunludur." TextColor="#B42336" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Step3Layout" IsVisible="False" Spacing="10">
                    <Label Text="3. Vize Bilgileri" FontSize="18" FontAttributes="Bold" TextColor="#24213A" />
                    <Label Text="Vize Talebi" TextColor="#687083" /><Picker x:Name="VisaRequestPicker" Title="Vize talebi" TextColor="#24213A" SelectedIndexChanged="OnVisaRulesChanged" />
                    <Label Text="Pasaport Geldi mi?" TextColor="#687083" /><Picker x:Name="PassportArrivedPicker" Title="Pasaport durumu" TextColor="#24213A" SelectedIndexChanged="OnVisaRulesChanged" />
                    <Label Text="Vize Durumu" TextColor="#687083" /><Picker x:Name="VisaStatusPicker" Title="Vize durumu" TextColor="#24213A" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Step4Layout" IsVisible="False" Spacing="10">
                    <Label Text="4. Bilet Bilgileri" FontSize="18" FontAttributes="Bold" TextColor="#24213A" />
                    <Label Text="Bilet Talebi" TextColor="#687083" /><Picker x:Name="TicketRequestPicker" Title="Bilet talebi" TextColor="#24213A" SelectedIndexChanged="OnTicketRequestChanged" />
                    <Label Text="Bilet Durumu" TextColor="#687083" /><Picker x:Name="TicketStatusPicker" Title="Bilet durumu" TextColor="#24213A" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Step5Layout" IsVisible="False" Spacing="10">
                    <Label Text="5. Kargo Talebi" FontSize="18" FontAttributes="Bold" TextColor="#24213A" />
                    <Picker x:Name="CargoPicker" Title="Kargo talebi" TextColor="#24213A" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Step6Layout" IsVisible="False" Spacing="10">
                    <Label Text="6. Oda Türü" FontSize="18" FontAttributes="Bold" TextColor="#24213A" />
                    <Picker x:Name="RoomTypePicker" Title="Oda türü" TextColor="#24213A" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Step7Layout" IsVisible="False" Spacing="10">
                    <Label Text="7. Katılım Şehri ve Aktarma" FontSize="18" FontAttributes="Bold" TextColor="#24213A" />
                    <Label Text="Katılım Yapılacak Şehir" TextColor="#687083" /><Picker x:Name="DepartureCityPicker" Title="Şehir seçin" TextColor="#24213A" />
                    <Label Text="Aktarma" TextColor="#687083" /><Picker x:Name="TransferPicker" Title="Aktarma var mı?" TextColor="#24213A" SelectedIndexChanged="OnTransferChanged" />
                    <VerticalStackLayout x:Name="TransferFields" IsVisible="False" Spacing="10">
                        <Label Text="Aktarma Şehri" TextColor="#687083" /><Picker x:Name="TransferCityPicker" Title="Aktarma şehri" TextColor="#24213A" />
                        <Label Text="İlçe" TextColor="#687083" /><Entry x:Name="DistrictEntry" Placeholder="İlçe" TextColor="#24213A" BackgroundColor="White" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Step8Layout" IsVisible="False" Spacing="10">
                    <Label Text="8. Fiyat ve Ödeme" FontSize="18" FontAttributes="Bold" TextColor="#24213A" />
                    <Label Text="Toplam Fiyat" TextColor="#687083" /><Entry x:Name="TotalPriceEntry" Keyboard="Numeric" Text="0" TextColor="#24213A" BackgroundColor="White" TextChanged="OnPaymentChanged" />
                    <Label Text="Para Birimi" TextColor="#687083" /><Picker x:Name="CurrencyPicker" Title="Para birimi" TextColor="#24213A" />
                    <Label Text="Ödenen" TextColor="#687083" /><Entry x:Name="PaidAmountEntry" Keyboard="Numeric" Text="0" TextColor="#24213A" BackgroundColor="White" TextChanged="OnPaymentChanged" />
                    <Label Text="Kalan Borç" TextColor="#687083" /><Entry x:Name="RemainingDebtEntry" IsReadOnly="True" Text="0" TextColor="#24213A" BackgroundColor="White" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Step9Layout" IsVisible="False" Spacing="10">
                    <Label Text="9. Referans" FontSize="18" FontAttributes="Bold" TextColor="#24213A" />
                    <Entry x:Name="ReferenceEntry" Placeholder="Referans kişi" TextColor="#24213A" BackgroundColor="White" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Step10Layout" IsVisible="False" Spacing="10">
                    <Label Text="10. Önizleme" FontSize="18" FontAttributes="Bold" TextColor="#24213A" />
                    <Border Stroke="#E4E6EF" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="16">
                        <Label x:Name="PreviewLabel" TextColor="#24213A" />
                    </Border>
                    <HorizontalStackLayout Spacing="10"><Label Text="Kayıt durumu" TextColor="#687083" VerticalOptions="Center" /><Switch x:Name="ActiveSwitch" IsToggled="True" /></HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button x:Name="BackButton" Grid.Column="0" Text="Geri" BackgroundColor="#EFEAFF" TextColor="#4932A8" Clicked="OnPreviousClicked" IsVisible="False" />
            <Button x:Name="NextButton" Grid.Column="1" Text="İleri" BackgroundColor="#6D4AFF" TextColor="White" Clicked="OnNextClicked" />
        </Grid>
    </Grid>
</ContentPage>
