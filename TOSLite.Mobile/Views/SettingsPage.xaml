<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TOSLite.Mobile.Views.SettingsPage"
             Title="Ayarlar"
             BackgroundColor="#F6F7FB">
    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="18" RowSpacing="12">
            <VerticalStackLayout Grid.Row="0" Spacing="8">
                <Button Text="‹ Ana Sayfa" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="#6D4AFF" Clicked="OnHomeClicked" />
                <Label Text="Ayarlar" FontSize="28" FontAttributes="Bold" TextColor="#24213A" />
                <Label Text="Kayıt seçeneklerini düzenleyin ve sıralayın." TextColor="#687083" />
                <Entry x:Name="SearchEntry" Placeholder="Ayar kartlarında ara" PlaceholderColor="#687083" TextColor="#24213A" BackgroundColor="White" TextChanged="OnSearchTextChanged" />
            </VerticalStackLayout>
            <ScrollView Grid.Row="1">
                <FlexLayout x:Name="SettingsCards" Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start" />
            </ScrollView>
        </Grid>

        <Grid x:Name="OptionsDialog" IsVisible="False" BackgroundColor="#990F172A" Padding="18">
            <Border VerticalOptions="Center" Stroke="#DCD4FF" StrokeShape="RoundRectangle 24" BackgroundColor="White" Padding="18" MaximumHeightRequest="680">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="OptionsHeading" FontSize="21" FontAttributes="Bold" TextColor="#342477" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" WidthRequest="42" HeightRequest="42" Padding="0" CornerRadius="14" BackgroundColor="#F0ECFF" TextColor="#4932A8" Clicked="OnCloseOptionsClicked" />
                    </Grid>
                    <Label Grid.Row="1" Text="Mevcut seçenekleri yönetin veya yenisini ekleyin." FontSize="13" TextColor="#60697A" />
                    <Entry x:Name="ValueEntry" Grid.Row="2" Placeholder="Yeni seçenek değeri" PlaceholderColor="#687083" TextColor="#24213A" BackgroundColor="#F6F7FB" />
                    <Entry x:Name="SortOrderEntry" Grid.Row="3" Placeholder="Sıra" Keyboard="Numeric" Text="1" TextColor="#24213A" BackgroundColor="#F6F7FB" />
                    <HorizontalStackLayout Grid.Row="4" Spacing="8">
                        <Button x:Name="SaveOptionButton" Text="Seçeneği ekle" BackgroundColor="#6D4AFF" TextColor="White" Clicked="OnSaveOptionClicked" />
                        <Button Text="Temizle" BackgroundColor="#EFEAFF" TextColor="#4932A8" Clicked="OnClearClicked" />
                    </HorizontalStackLayout>
                    <CollectionView x:Name="OptionsCollection" Grid.Row="5" SelectionMode="None" Margin="0,4,0,0">
                        <CollectionView.EmptyView>
                            <Label Text="Henüz seçenek eklenmemiş." TextColor="#687083" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#E4E6EF" StrokeShape="RoundRectangle 12" Padding="12" Margin="0,3" BackgroundColor="White">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Value}" TextColor="#24213A" FontAttributes="Bold" />
                                            <Label Text="{Binding SortOrder, StringFormat='Sıra: {0}'}" TextColor="#687083" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Düzenle" Padding="8,4" BackgroundColor="#6D4AFF" TextColor="White" Clicked="OnEditOptionClicked" CommandParameter="{Binding .}" />
                                        <Button Grid.Column="2" Text="Durum" Padding="8,4" BackgroundColor="#EFEAFF" TextColor="#4932A8" Clicked="OnToggleOptionClicked" CommandParameter="{Binding .}" />
                                        <Button Grid.Column="3" Text="Sil" Padding="8,4" BackgroundColor="#FCE8EA" TextColor="#A52D3C" Clicked="OnDeleteOptionClicked" CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
