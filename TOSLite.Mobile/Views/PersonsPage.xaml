<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TOSLite.Mobile.Views.PersonsPage"
             Title="Kişiler"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="18,16,18,28" Spacing="16">
            <Button Text="‹ Ana Sayfa"
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Clicked="OnHomeClicked" />

            <Label Text="Kişiler"
                   FontSize="28"
                   FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

            <VerticalStackLayout x:Name="SearchPanel" Spacing="12" Padding="16" BackgroundColor="White">
                <Label Text="Önce kişiyi arayın"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
                <Entry x:Name="SearchEntry"
                       Placeholder="Ad, soyad veya TC kimlik no"
                       PlaceholderColor="{StaticResource TextSecondary}"
                       TextColor="{StaticResource TextPrimary}"
                       BackgroundColor="{StaticResource Surface}"
                       TextChanged="OnSearchTextChanged" />
                <Label x:Name="SearchStatusLabel"
                       Text="Kayıtlı kişiler"
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="13" />
                    <CollectionView x:Name="PeopleCollection"
                                SelectionMode="Single"
                                SelectionChanged="OnPersonSelected"
                                 HeightRequest="340">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}"
                                    Padding="14"
                                    Margin="0,3">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding FirstName}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                            TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding LastName}"
                                           FontSize="14"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding TcKimlikNo}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border x:Name="SelectedPersonActions"
                        IsVisible="False"
                        Stroke="{StaticResource BorderColor}"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="SelectedPersonLabel"
                                TextColor="{StaticResource TextPrimary}"
                               FontAttributes="Bold" />
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="Düzenle"
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    Clicked="OnEditClicked" />
                            <Button Text="Kalıcı Sil"
                                    HorizontalOptions="FillAndExpand"
                                    Style="{StaticResource DangerButton}"
                                    Clicked="OnDeleteClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button x:Name="NewPersonButton"
                        Text="Aradığım kişi listede yok — Yeni Kişi Kaydı"
                        IsVisible="False"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        Clicked="OnNewPersonClicked" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="WizardPanel"
                                 IsVisible="False"
                                 Spacing="14"
                                 Padding="16"
                                 BackgroundColor="White">
                <Label x:Name="StepHeading"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />
                <ProgressBar x:Name="StepProgress"
                             Progress="0.2"
                             ProgressColor="{StaticResource Primary}"
                             BackgroundColor="{StaticResource BorderColor}" />
                <Button x:Name="NewPersonResetButton"
                        Text="Bu kişiyi bırak, başka kişi ekle"
                        IsVisible="False"
                        HorizontalOptions="End"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnStartAnotherPersonClicked" />

                <VerticalStackLayout x:Name="Step1Layout" Spacing="10">
                    <Label Text="1. Kimlik Bilgileri"
                           FontSize="17"
                           FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Pasaport Görselinden Ön Doldurma"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Fotoğraf cihazınızda işlenir; kaydetmeden önce tüm bilgileri kontrol edebilirsiniz."
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Fotoğraf Yükle"
                                HorizontalOptions="FillAndExpand"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                Clicked="OnChoosePassportImageClicked" />
                        <Button x:Name="CapturePassportImageButton"
                                Text="Fotoğraf Çek"
                                HorizontalOptions="FillAndExpand"
                                BackgroundColor="{StaticResource Success}"
                                TextColor="White"
                                Clicked="OnCapturePassportImageClicked" />
                    </HorizontalStackLayout>
                    <Label x:Name="PassportImageStatusLabel"
                           IsVisible="False"
                           FontSize="12"
                           TextColor="{StaticResource Success}" />
                    <Button x:Name="ProcessPassportImageButton"
                            Text="Bilgileri İşle"
                            IsEnabled="False"
                            BackgroundColor="{StaticResource TextPrimary}"
                            TextColor="White"
                            Clicked="OnProcessPassportImageClicked" />
                    <Label Text="Ad *" Style="{StaticResource FormFieldLabel}" />
                    <Entry x:Name="FirstNameEntry" Placeholder="Ad" TextColor="{StaticResource TextPrimary}" BackgroundColor="{StaticResource Surface}" />
                    <Label Text="Soyad *" Style="{StaticResource FormFieldLabel}" />
                    <Entry x:Name="LastNameEntry" Placeholder="Soyad" TextColor="{StaticResource TextPrimary}" BackgroundColor="{StaticResource Surface}" />
                    <Label Text="Uyruk *" Style="{StaticResource FormFieldLabel}" />
                    <Picker x:Name="NationalityPicker"
                            Title="Uyruk seçin"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="{StaticResource Surface}"
                            SelectedIndexChanged="OnNationalityChanged" />
                    <Label Text="TC Kimlik No (Türkiye uyruklular için zorunlu)" Style="{StaticResource FormFieldLabel}" />
                    <Entry x:Name="TcEntry"
                           Placeholder="11 haneli TC Kimlik No"
                           Keyboard="Numeric"
                           TextColor="{StaticResource TextPrimary}"
                           BackgroundColor="{StaticResource Surface}"
                           TextChanged="OnTcTextChanged" />
                    <Label Text="Cinsiyet *" Style="{StaticResource FormFieldLabel}" />
                    <Picker x:Name="GenderPicker" Title="Seçiniz" TextColor="{StaticResource TextPrimary}" BackgroundColor="{StaticResource Surface}" />
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="BirthDateEnabled"
                                  Color="{StaticResource Primary}"
                                  CheckedChanged="OnBirthDateEnabledChanged" />
                        <Label Text="Doğum tarihi gir"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <DatePicker x:Name="BirthDatePicker"
                                IsVisible="False"
                                TextColor="{StaticResource TextPrimary}"
                                DateSelected="OnBirthDateSelected" />
                    <Label x:Name="AgeLabel" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="Yaş Aralığı" TextColor="{StaticResource TextSecondary}" />
                    <Picker x:Name="AgeRangePicker" Title="Seçiniz" TextColor="{StaticResource TextPrimary}" BackgroundColor="{StaticResource Surface}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="Step2Layout" IsVisible="False" Spacing="10">
                    <Label Text="2. İletişim Bilgileri"
                           FontSize="17"
                           FontAttributes="Bold"
                             TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Telefon" Style="{StaticResource FormFieldLabel}" />
                    <Entry x:Name="PhoneEntry" Placeholder="Telefon" Keyboard="Telephone" TextColor="{StaticResource TextPrimary}" BackgroundColor="{StaticResource Surface}" />
                    <Label Text="Adres" Style="{StaticResource FormFieldLabel}" />
                    <Editor x:Name="AddressEditor"
                            Placeholder="Adres"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="110"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="{StaticResource Surface}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="Step3Layout" IsVisible="False" Spacing="10">
                    <Label Text="3. Sağlık Bilgileri"
                           FontSize="17"
                           FontAttributes="Bold"
                             TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Kan Grubu" Style="{StaticResource FormFieldLabel}" />
                    <Picker x:Name="BloodPicker" Title="Seçiniz" TextColor="{StaticResource TextPrimary}" BackgroundColor="{StaticResource Surface}" />
                    <Label Text="Hastalık Durumu" Style="{StaticResource FormFieldLabel}" />
                    <Editor x:Name="HealthEditor"
                            Placeholder="Hastalık durumu"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="{StaticResource Surface}" />
                    <Label Text="Aşı Durumu" Style="{StaticResource FormFieldLabel}" />
                    <Editor x:Name="VaccineEditor"
                            Placeholder="Aşı durumu"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="{StaticResource Surface}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="Step4Layout" IsVisible="False" Spacing="10">
                    <Label Text="4. Pasaport Bilgileri"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Pasaport Türü" Style="{StaticResource FormFieldLabel}" />
                    <Picker x:Name="PassportTypePicker" Title="Seçiniz" TextColor="{StaticResource TextPrimary}" BackgroundColor="{StaticResource Surface}" />
                    <Label Text="Pasaport No (Yabancı uyruklular için zorunlu)" Style="{StaticResource FormFieldLabel}" />
                    <Entry x:Name="PassportNumberEntry" Placeholder="Pasaport numarası" TextColor="{StaticResource TextPrimary}" BackgroundColor="{StaticResource Surface}" />
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="PassportStartEnabled"
                                  Color="{StaticResource Primary}"
                                  CheckedChanged="OnPassportDateEnabledChanged" />
                        <Label Text="Pasaport başlangıç tarihi gir"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <DatePicker x:Name="PassportStartPicker" IsVisible="False" TextColor="{StaticResource TextPrimary}" DateSelected="OnPassportDateSelected" />
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="PassportEndEnabled"
                                  Color="{StaticResource Primary}"
                                  CheckedChanged="OnPassportDateEnabledChanged" />
                        <Label Text="Pasaport bitiş tarihi gir"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <DatePicker x:Name="PassportEndPicker" IsVisible="False" TextColor="{StaticResource TextPrimary}" DateSelected="OnPassportDateSelected" />
                    <Border x:Name="PassportValidityBorder"
                            IsVisible="False"
                            Stroke="{StaticResource BorderColor}"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource SuccessSoft}"
                            Padding="12">
                        <Label x:Name="PassportValidityLabel"
                                TextColor="{StaticResource Success}"
                               FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="Step5Layout" IsVisible="False" Spacing="10">
                    <Label Text="5. Kayıt Önizleme"
                           FontSize="17"
                           FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />
                    <Border Style="{StaticResource CardBorder}">
                        <Label x:Name="PreviewLabel"
                                TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>

                <Label x:Name="ValidationLabel"
                       IsVisible="False"
                        TextColor="{StaticResource Danger}"
                       FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="10">
                    <Button x:Name="BackButton"
                            Text="Geri"
                            IsVisible="False"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource SecondaryButton}"
                            Clicked="OnBackClicked" />
                    <Button x:Name="NextButton"
                            Text="İleri"
                            HorizontalOptions="FillAndExpand"
                                    BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                            Clicked="OnNextClicked" />
                    <Button x:Name="SaveButton"
                            Text="Kaydet"
                            IsVisible="False"
                            HorizontalOptions="FillAndExpand"
                            BackgroundColor="{StaticResource Success}"
                            TextColor="White"
                            Clicked="OnSaveClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
