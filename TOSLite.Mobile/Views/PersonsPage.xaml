<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TOSLite.Mobile.Views.PersonsPage"
             Title="Kişiler"
             BackgroundColor="#F6F7FB">
    <ScrollView>
        <VerticalStackLayout Padding="20,18" Spacing="16">
            <Button Text="‹ Ana Sayfa"
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent"
                    TextColor="#6D4AFF"
                    Clicked="OnHomeClicked" />

            <Label Text="Kişiler"
                   FontSize="28"
                   FontAttributes="Bold"
                    TextColor="#24213A" />

            <VerticalStackLayout x:Name="SearchPanel" Spacing="12">
                <Label Text="Önce kişiyi arayın"
                       FontSize="17"
                       FontAttributes="Bold"
                        TextColor="#687083" />
                <Entry x:Name="SearchEntry"
                       Placeholder="Ad, soyad veya TC kimlik no"
                       PlaceholderColor="#8B91A1"
                       TextColor="#24213A"
                       BackgroundColor="White"
                       TextChanged="OnSearchTextChanged" />
                <Label x:Name="SearchStatusLabel"
                       Text="Kayıtlı kişiler"
                       TextColor="#687083"
                       FontSize="13" />
                    <CollectionView x:Name="PeopleCollection"
                                SelectionMode="Single"
                                SelectionChanged="OnPersonSelected"
                                 HeightRequest="340">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#E4E6EF"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="White"
                                    Padding="14"
                                    Margin="0,3">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding FirstName}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                            TextColor="#24213A" />
                                    <Label Text="{Binding LastName}"
                                           FontSize="14"
                                           TextColor="#687083" />
                                    <Label Text="{Binding TcKimlikNo}"
                                           FontSize="12"
                                           TextColor="#8B91A1" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border x:Name="SelectedPersonActions"
                        IsVisible="False"
                        Stroke="#E4E6EF"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="SelectedPersonLabel"
                                TextColor="#24213A"
                               FontAttributes="Bold" />
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="Düzenle"
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="#6D4AFF"
                                    TextColor="White"
                                    Clicked="OnEditClicked" />
                            <Button Text="Kalıcı Sil"
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="#C53B4A"
                                    TextColor="White"
                                    Clicked="OnDeleteClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button x:Name="NewPersonButton"
                        Text="Aradığım kişi listede yok — Yeni Kişi Kaydı"
                        IsVisible="False"
                        BackgroundColor="#6D4AFF"
                        TextColor="White"
                        Clicked="OnNewPersonClicked" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="WizardPanel"
                                 IsVisible="False"
                                 Spacing="14">
                <Label x:Name="StepHeading"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="#6D4AFF" />
                <ProgressBar x:Name="StepProgress"
                             Progress="0.2"
                             ProgressColor="#6D4AFF"
                             BackgroundColor="#E4E6EF" />

                <VerticalStackLayout x:Name="Step1Layout" Spacing="10">
                    <Label Text="1. Kimlik Bilgileri"
                           FontSize="17"
                           FontAttributes="Bold"
                            TextColor="#24213A" />
                    <Label Text="Pasaport Görselinden Ön Doldurma"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#6D4AFF" />
                    <Label Text="Fotoğraf cihazınızda işlenir; kaydetmeden önce tüm bilgileri kontrol edebilirsiniz."
                           FontSize="12"
                           TextColor="#687083" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Fotoğraf Yükle"
                                HorizontalOptions="FillAndExpand"
                                BackgroundColor="#6D4AFF"
                                TextColor="White"
                                Clicked="OnChoosePassportImageClicked" />
                        <Button x:Name="CapturePassportImageButton"
                                Text="Fotoğraf Çek"
                                HorizontalOptions="FillAndExpand"
                                BackgroundColor="#16875D"
                                TextColor="White"
                                Clicked="OnCapturePassportImageClicked" />
                    </HorizontalStackLayout>
                    <Label x:Name="PassportImageStatusLabel"
                           IsVisible="False"
                           FontSize="12"
                           TextColor="#16875D" />
                    <Button x:Name="ProcessPassportImageButton"
                            Text="Bilgileri İşle"
                            IsEnabled="False"
                            BackgroundColor="#24213A"
                            TextColor="White"
                            Clicked="OnProcessPassportImageClicked" />
                    <Label Text="Ad *" TextColor="#687083" />
                    <Entry x:Name="FirstNameEntry" Placeholder="Ad" TextColor="#24213A" BackgroundColor="White" />
                    <Label Text="Soyad *" TextColor="#687083" />
                    <Entry x:Name="LastNameEntry" Placeholder="Soyad" TextColor="#24213A" BackgroundColor="White" />
                    <Label Text="Uyruk *" TextColor="#687083" />
                    <Picker x:Name="NationalityPicker"
                            Title="Uyruk seçin"
                            TextColor="#24213A"
                            BackgroundColor="White"
                            SelectedIndexChanged="OnNationalityChanged" />
                    <Label Text="TC Kimlik No (Türkiye uyruklular için zorunlu)" TextColor="#687083" />
                    <Entry x:Name="TcEntry"
                           Placeholder="11 haneli TC Kimlik No"
                           Keyboard="Numeric"
                           TextColor="#24213A"
                           BackgroundColor="White"
                           TextChanged="OnTcTextChanged" />
                    <Label Text="Cinsiyet *" TextColor="#687083" />
                    <Picker x:Name="GenderPicker" Title="Seçiniz" TextColor="#24213A" BackgroundColor="White" />
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="BirthDateEnabled"
                                  Color="#6D4AFF"
                                  CheckedChanged="OnBirthDateEnabledChanged" />
                        <Label Text="Doğum tarihi gir"
                               TextColor="#687083"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <DatePicker x:Name="BirthDatePicker"
                                IsVisible="False"
                                TextColor="#24213A"
                                DateSelected="OnBirthDateSelected" />
                    <Label x:Name="AgeLabel" TextColor="#687083" />
                    <Label Text="Yaş Aralığı" TextColor="#687083" />
                    <Picker x:Name="AgeRangePicker" Title="Seçiniz" TextColor="#24213A" BackgroundColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="Step2Layout" IsVisible="False" Spacing="10">
                    <Label Text="2. İletişim Bilgileri"
                           FontSize="17"
                           FontAttributes="Bold"
                            TextColor="#24213A" />
                    <Label Text="Telefon" TextColor="#687083" />
                    <Entry x:Name="PhoneEntry" Placeholder="Telefon" Keyboard="Telephone" TextColor="#24213A" BackgroundColor="White" />
                    <Label Text="Adres" TextColor="#687083" />
                    <Editor x:Name="AddressEditor"
                            Placeholder="Adres"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="110"
                            TextColor="#24213A"
                            BackgroundColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="Step3Layout" IsVisible="False" Spacing="10">
                    <Label Text="3. Sağlık Bilgileri"
                           FontSize="17"
                           FontAttributes="Bold"
                            TextColor="#24213A" />
                    <Label Text="Kan Grubu" TextColor="#687083" />
                    <Picker x:Name="BloodPicker" Title="Seçiniz" TextColor="#24213A" BackgroundColor="White" />
                    <Label Text="Hastalık Durumu" TextColor="#687083" />
                    <Editor x:Name="HealthEditor"
                            Placeholder="Hastalık durumu"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80"
                            TextColor="#24213A"
                            BackgroundColor="White" />
                    <Label Text="Aşı Durumu" TextColor="#687083" />
                    <Editor x:Name="VaccineEditor"
                            Placeholder="Aşı durumu"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80"
                            TextColor="#24213A"
                            BackgroundColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="Step4Layout" IsVisible="False" Spacing="10">
                    <Label Text="4. Pasaport Bilgileri"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#24213A" />
                    <Label Text="Pasaport Türü" TextColor="#687083" />
                    <Picker x:Name="PassportTypePicker" Title="Seçiniz" TextColor="#24213A" BackgroundColor="White" />
                    <Label Text="Pasaport No (Yabancı uyruklular için zorunlu)" TextColor="#687083" />
                    <Entry x:Name="PassportNumberEntry" Placeholder="Pasaport numarası" TextColor="#24213A" BackgroundColor="White" />
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="PassportStartEnabled"
                                  Color="#6D4AFF"
                                  CheckedChanged="OnPassportDateEnabledChanged" />
                        <Label Text="Pasaport başlangıç tarihi gir"
                               TextColor="#687083"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <DatePicker x:Name="PassportStartPicker" IsVisible="False" TextColor="#24213A" DateSelected="OnPassportDateSelected" />
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="PassportEndEnabled"
                                  Color="#6D4AFF"
                                  CheckedChanged="OnPassportDateEnabledChanged" />
                        <Label Text="Pasaport bitiş tarihi gir"
                               TextColor="#687083"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <DatePicker x:Name="PassportEndPicker" IsVisible="False" TextColor="#24213A" DateSelected="OnPassportDateSelected" />
                    <Border x:Name="PassportValidityBorder"
                            IsVisible="False"
                            Stroke="#E4E6EF"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="White"
                            Padding="12">
                        <Label x:Name="PassportValidityLabel"
                                TextColor="#5140B8"
                               FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="Step5Layout" IsVisible="False" Spacing="10">
                    <Label Text="5. Kayıt Önizleme"
                           FontSize="17"
                           FontAttributes="Bold"
                            TextColor="#24213A" />
                    <Border Stroke="#E4E6EF"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="White"
                            Padding="16">
                        <Label x:Name="PreviewLabel"
                                TextColor="#24213A"
                               LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>

                <Label x:Name="ValidationLabel"
                       IsVisible="False"
                        TextColor="#C53B4A"
                       FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="10">
                    <Button x:Name="BackButton"
                            Text="Geri"
                            IsVisible="False"
                            HorizontalOptions="FillAndExpand"
                            BackgroundColor="#EFEAFF"
                            TextColor="#4932A8"
                            Clicked="OnBackClicked" />
                    <Button x:Name="NextButton"
                            Text="İleri"
                            HorizontalOptions="FillAndExpand"
                                    BackgroundColor="#6D4AFF"
                                TextColor="#24213A"
                            Clicked="OnNextClicked" />
                    <Button x:Name="SaveButton"
                            Text="Kaydet"
                            IsVisible="False"
                            HorizontalOptions="FillAndExpand"
                            BackgroundColor="#16875D"
                            TextColor="#24213A"
                            Clicked="OnSaveClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
