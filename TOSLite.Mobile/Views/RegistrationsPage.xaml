<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TOSLite.Mobile.Views.RegistrationsPage"
             Title="Tur Kayıtları"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="18" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Style="{StaticResource SectionPanelBlue}" Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Text="Tur Kayıtları" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                <Picker x:Name="PeriodPicker" Grid.Column="1" Title="Dönem" WidthRequest="158" HorizontalOptions="End" FontSize="13" SelectedIndexChanged="OnPeriodChanged" />
            </Grid>
            <Entry x:Name="SearchEntry" Placeholder="Kişi, tur veya dönem ara" PlaceholderColor="#687083" TextColor="#24213A" BackgroundColor="White" TextChanged="OnSearchTextChanged" />
        </VerticalStackLayout>
        <Label x:Name="StatusLabel" Grid.Row="1" Text="Kayıtlı turlar" TextColor="{StaticResource TextSecondary}" FontSize="13" />
        <CollectionView x:Name="RegistrationsCollection" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnRegistrationSelected">
            <CollectionView.EmptyView>
                <Label Text="Henüz tur kaydı yok." TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,5">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding PersonName}" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource PrimarySoft}" Padding="9,5" VerticalOptions="Center">
                                    <Label Text="{Binding TourType}" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource Primary}" />
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                <Label Text="{Binding Period, StringFormat='Dönem: {0}'}" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                                <Label Grid.Column="1" Text="{Binding GroupType, StringFormat='Grup: {0}'}" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                                <Label Grid.Row="1" Text="{Binding DaysCount, StringFormat='Süre: {0}'}" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <HorizontalStackLayout x:Name="SelectedActions" IsVisible="False" Spacing="8">
                <Button Text="Düzenle" HorizontalOptions="FillAndExpand" BackgroundColor="{StaticResource Primary}" TextColor="White" Clicked="OnEditClicked" />
                <Button Text="Sil" HorizontalOptions="FillAndExpand" Style="{StaticResource DangerButton}" Clicked="OnDeleteClicked" />
            </HorizontalStackLayout>
            <Button Text="+  Yeni Tur Kaydı Oluştur" BackgroundColor="{StaticResource Primary}" TextColor="White" Clicked="OnNewClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
