<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryDark">#3730A3</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#E0E7FF</Color>
    <Color x:Key="SecondaryDarkText">#3730A3</Color>
    <Color x:Key="Tertiary">#EFF6FF</Color>

    <Color x:Key="PageBackground">#F8FAFC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceAlt">#F1F5F9</Color>
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#64748B</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="PrimarySoft">#EEF2FF</Color>
    <Color x:Key="SuccessSoft">#ECFDF5</Color>
    <Color x:Key="WarningSoft">#FFFBEB</Color>
    <Color x:Key="DangerSoft">#FEF2F2</Color>
    <Color x:Key="SectionBlue">#DBEAFE</Color>
    <Color x:Key="SectionBlueBorder">#60A5FA</Color>
    <Color x:Key="SectionViolet">#EDE9FE</Color>
    <Color x:Key="SectionVioletBorder">#A78BFA</Color>
    <Color x:Key="SectionTeal">#CCFBF1</Color>
    <Color x:Key="SectionTealBorder">#2DD4BF</Color>
    <Color x:Key="SectionAmber">#FEF3C7</Color>
    <Color x:Key="SectionAmberBorder">#FBBF24</Color>
    <Color x:Key="SectionRose">#FFE4E6</Color>
    <Color x:Key="SectionRoseBorder">#FB7185</Color>
    <Color x:Key="SectionCyan">#CFFAFE</Color>
    <Color x:Key="SectionCyanBorder">#22D3EE</Color>
    <Color x:Key="SectionLime">#ECFCCB</Color>
    <Color x:Key="SectionLimeBorder">#A3E635</Color>
    <Color x:Key="SectionOrange">#FFEDD5</Color>
    <Color x:Key="SectionOrangeBorder">#FB923C</Color>
    <Color x:Key="Success">#059669</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="Danger">#DC2626</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0F172A</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#F8FAFC</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>