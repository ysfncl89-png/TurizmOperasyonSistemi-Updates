<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TOSLite.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TOSLite.Mobile"
    Title="TOS Lite Mobil">

    <Shell.Resources>
        <Style TargetType="Shell" ApplyToDerivedTypes="True">
            <Setter Property="Shell.BackgroundColor" Value="White" />
            <Setter Property="Shell.ForegroundColor" Value="#24213A" />
            <Setter Property="Shell.TitleColor" Value="#24213A" />
            <Setter Property="Shell.NavBarHasShadow" Value="True" />
        </Style>
    </Shell.Resources>

    <ShellContent
        Title="Ana Sayfa"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
