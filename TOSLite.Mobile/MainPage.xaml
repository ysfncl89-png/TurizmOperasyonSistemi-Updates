<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TOSLite.Mobile.MainPage">

    <ScrollView BackgroundColor="#F6F7FB">
        <VerticalStackLayout Padding="22,30" Spacing="16">
            <Label Text="TOS LITE"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#24213A" />
            <Label Text="Mobil operasyon kayıtları"
                   FontSize="16"
                   TextColor="#687083" />

            <Border Stroke="#E7E4F0" StrokeShape="RoundRectangle 20" BackgroundColor="White" Padding="18" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Kişiler" FontSize="20" FontAttributes="Bold" TextColor="#24213A" />
                    <Label Text="Kişi kayıtlarını çevrimdışı oluşturun ve yönetin." TextColor="#687083" />
                    <Button Text="Kişiler Modülünü Aç" BackgroundColor="#6D4AFF" TextColor="White" Clicked="OnPersonsClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#E7E4F0" StrokeShape="RoundRectangle 20" BackgroundColor="White" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tur Kayıtları" FontSize="20" FontAttributes="Bold" TextColor="#24213A" />
                    <Label Text="Tur kayıtlarını çevrimdışı oluşturun ve yönetin." TextColor="#687083" />
                    <Button Text="Tur Kayıtları Modülünü Aç" BackgroundColor="#6D4AFF" TextColor="White" Clicked="OnRegistrationsClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#E7E4F0" StrokeShape="RoundRectangle 20" BackgroundColor="White" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Odalama Motoru" FontSize="20" FontAttributes="Bold" TextColor="#24213A" />
                    <Label Text="Tur kayıtlarındaki yolcuları otel odalarına yerleştirin." TextColor="#687083" />
                    <Button Text="Odalama Modülünü Aç" BackgroundColor="#6D4AFF" TextColor="White" Clicked="OnRoomingClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#E7E4F0" StrokeShape="RoundRectangle 20" BackgroundColor="#EFEAFF" Padding="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Ayarlar" FontSize="18" FontAttributes="Bold" TextColor="#33266F" />
                        <Label Text="Kayıt seçeneklerini yönetin." TextColor="#615B78" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Ayarları Aç" BackgroundColor="#6D4AFF" TextColor="White" VerticalOptions="Center" Clicked="OnSettingsClicked" />
                </Grid>
            </Border>
            <Border Stroke="#E7E4F0" StrokeShape="RoundRectangle 20" BackgroundColor="White" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Masaüstü Eşitleme" FontSize="20" FontAttributes="Bold" TextColor="#24213A" />
                    <Label Text="Masaüstündeki QR kodu tarayın ve mobil kayıtlarınızı istediğiniz zaman aktarın." TextColor="#687083" />
                    <Button Text="Eşitleme Modülünü Aç" BackgroundColor="#6D4AFF" TextColor="White" Clicked="OnMobileSyncClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
