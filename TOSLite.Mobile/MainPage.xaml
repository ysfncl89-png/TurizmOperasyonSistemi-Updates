<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TOSLite.Mobile.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="18,12,18,28" Spacing="18">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource TextPrimary}" Padding="18,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                        <Label Text="TOS" FontFamily="OpenSansSemibold" FontSize="24" FontAttributes="Bold" TextColor="White" />
                        <Label Text="LITE" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" Text="MOBİL OPERASYON" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" TextColor="{StaticResource Gray300}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="3" Margin="2,0">
                <Label Text="Ana Sayfa" FontFamily="OpenSansSemibold" FontSize="25" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <Label Text="Operasyonlarınıza tek noktadan ulaşın." FontSize="14" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource TextPrimary}" Offset="0" />
                        <GradientStop Color="{StaticResource PrimaryDark}" Offset="0.55" />
                        <GradientStop Color="{StaticResource Primary}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Opacity="0.16" Radius="18" Offset="0,6" />
                </Border.Shadow>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Çalışma Alanınız" FontFamily="OpenSansSemibold" FontSize="21" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Kişi, tur ve konaklama işlemlerini kolayca yönetin." FontSize="13" TextColor="{StaticResource Secondary}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="54" HeightRequest="54" StrokeThickness="0" StrokeShape="RoundRectangle 18" BackgroundColor="#35FFFFFF" VerticalOptions="Center">
                        <Image Source="home.svg" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="3" Margin="2,2,2,0">
                <Label Text="Çalışma Alanım" FontFamily="OpenSansSemibold" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <Label Text="İşlemlerinize dokunarak devam edin." FontSize="13" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBorder}" Padding="0" StrokeShape="RoundRectangle 20">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Opacity="0.07" Radius="14" Offset="0,4" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPersonsClicked" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource PrimarySoft}">
                            <Image Source="people.svg" WidthRequest="25" HeightRequest="25" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Kişiler" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Kişi kayıtlarını yönetin" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="14,0" />
                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegistrationsClicked" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource Tertiary}">
                            <Image Source="tour.svg" WidthRequest="25" HeightRequest="25" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Tur Kayıtları" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Tur kayıtlarını inceleyin ve yönetin" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="14,0" />
                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRoomingClicked" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource SuccessSoft}">
                            <Image Source="room.svg" WidthRequest="25" HeightRequest="25" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Odalama Motoru" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Otel ve oda planını yönetin" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="14,0" />
                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPaymentsClicked" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource PrimarySoft}">
                            <Image Source="list.svg" WidthRequest="25" HeightRequest="25" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Ödemeler ve Finans" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Ödeme hareketlerini ve finans özetini yönetin" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="14,0" />
                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCargoDocumentsClicked" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource WarningSoft}">
                            <Image Source="room.svg" WidthRequest="25" HeightRequest="25" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Kargo Evrak Hazırlama" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="İletişim bilgilerini inceleyip evrak havuzuna gönderin" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="14,0" />
                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnListsClicked" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource WarningSoft}">
                            <Image Source="list.svg" WidthRequest="25" HeightRequest="25" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Listeler" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Telefon, vize, sağlık ve diğer listeler" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Yönetim" FontFamily="OpenSansSemibold" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="2,2,2,0" />

            <Border Style="{StaticResource CardBorder}" Padding="0" StrokeShape="RoundRectangle 20">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Opacity="0.07" Radius="14" Offset="0,4" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsClicked" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource SurfaceAlt}">
                            <Image Source="settings.svg" WidthRequest="23" HeightRequest="23" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Ayarlar" FontFamily="OpenSansSemibold" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="14,0" />
                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMobileSyncClicked" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource Tertiary}">
                            <Image Source="sync.svg" WidthRequest="23" HeightRequest="23" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Masaüstü Eşitleme" FontFamily="OpenSansSemibold" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>